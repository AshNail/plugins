{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "module": "commonjs",
    "moduleDetection": "force",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "types/**/*.d.ts",
    "src/**/*.js"
  ],
  "exclude": [
    "src/common/**"
  ]
}
