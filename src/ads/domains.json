        "# —— 阿里云 HTTPDNS 启动接入点（内地 IPv4）——",
        "IP-CIDR,203.107.1.0/24,REJECT,no-resolve,pre-matching",
        "IP-CIDR,203.119.238.240/32,REJECT,no-resolve,pre-matching",
        "IP-CIDR,106.11.25.239/32,REJECT,no-resolve,pre-matching",
