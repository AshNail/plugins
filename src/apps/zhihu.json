  "enhance": {
    "intro": "知乎的可莉模块全部是原生 Loon Rewrite：请求侧拒绝广告/推广接口，响应侧删除广告字段。下面按 Loon 原生语法重写，默认整段注释；启用后先验首页/推荐/搜索/回答/评论/登录。",
    "sources": [
      "https://kelee.one/"
    ],
    "mitm_hosts": [
      "api.zhihu.com",
      "www.zhihu.com",
      "page-info.zhihu.com",
      "m-cloud.zhihu.com",
      "zhida.zhihu.com"
    ],
    "url_regex": [
      "URL-REGEX,^https://api\\.zhihu\\.com/ad-style-service/request$,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/commercial_api/,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/commercial_api/banners_v\\d/app_float_corner\\?,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/next-render\\?id=\\d+&type=answer,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/commercial_api/answer/\\d+/bottom-v\\d$,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/related_recommend/feed/waterfall\\?,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/search/preset_words\\?,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/search/related_queries/question/\\d+$,REJECT-DICT",
      "URL-REGEX,^https://zhida\\.zhihu\\.com/ai_ingress/knowledge/square/categories/feeds\\?categoryId=1%7D$,REJECT-DICT",
      "URL-REGEX,^https://zhida\\.zhihu\\.com/ai_ingress/ai_chat/guidance$,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/content-distribution-core/bubble/common/show$,REJECT-DICT",
      "URL-REGEX,^https://www\\.zhihu\\.com/api/v\\d/members/homepage_card$,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/people/homepage_entry_v\\d$,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/kvip/right/my_card\\?,REJECT-DICT",
      "URL-REGEX,^https://api\\.zhihu\\.com/unlimited/go/my_card/v\\d\\?,REJECT-DICT"
    ],
    "rewrite_json": [
      {
        "url": "^https?://api\\.zhihu\\.com/root/tab/v\\d(?:\\?.+)?$",
        "sample": "https://api.zhihu.com/root/tab/v1",
        "jq": ".tab_list |= map(select(.tab_type == \"follow\" or .tab_type == \"recommend\" or .tab_type == \"hot\" or .tab_type == \"ring_tab\"))",
        "note": "底部 Tab 只保留关注/推荐/热榜/圈层",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/topstory/recommend\\?",
        "sample": "https://api.zhihu.com/topstory/recommend?limit=10",
        "jq": ".data |= map(select(.type == \"ComponentCard\"))",
        "note": "推荐流只保留 ComponentCard",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/questions/\\d+/feeds\\?",
        "sample": "https://api.zhihu.com/questions/123/feeds?limit=10",
        "jq": "del(.ad_info)",
        "note": "问题 feed 删除 ad_info",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/comment_v\\d/(answers|pins)/\\d+/root_comment\\?",
        "sample": "https://api.zhihu.com/comment_v1/answers/123/root_comment?limit=10",
        "jq": "del(.atmosphere_voting_config)",
        "note": "评论根节点删除氛围投票配置",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://(api|page-info)(?:\\.zhihu)?\\.com/answers/v\\d/\\d+(?:\\?.*)?$",
        "sample": "https://api.zhihu.com/answers/v1/123",
        "jq": "del(.third_business, .float_search_word)",
        "note": "回答详情删除第三方商业与浮动搜索词",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://(api|page-info)(?:\\.zhihu)?\\.com/answers/v\\d/\\d+(?:\\?.*)?$",
        "sample": "https://page-info.zhihu.com/answers/v1/123",
        "jq": ".structured_content.segments |= map(select(.type != \"card\"))",
        "note": "回答正文删除 card 片段",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/topstory/recommend\\?",
        "sample": "https://api.zhihu.com/topstory/recommend?limit=10",
        "jq": ".data[]?.children |= (if type == \"array\" then map(select(.id != \"ring\")) else . end)",
        "note": "推荐流子项删除 ring",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/(articles|answers|pins)/v\\d/\\d+\\?",
        "sample": "https://api.zhihu.com/articles/v1/123?",
        "jq": "del(.third_business, .ring_info, .interaction_bar_plugins)",
        "note": "文章/回答/想法删除商业与互动插件字段",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/comment_v\\d/answers/\\d+/list-headers$",
        "sample": "https://api.zhihu.com/comment_v1/answers/123/list-headers",
        "jq": "del(.continuous_consumption_module)",
        "note": "评论列表删除连续消费模块",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/podcasts/hub/v\\d$",
        "sample": "https://api.zhihu.com/podcasts/hub/v1",
        "jq": "del(.banners)",
        "note": "播客 hub 删除 banner",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/search/recommend_query/v\\d\\?",
        "sample": "https://api.zhihu.com/search/recommend_query/v1?",
        "jq": ".recommend_queries.queries |= map(select(.type == \"normal\"))",
        "note": "搜索推荐词只保留 normal",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/search_v\\d\\?",
        "sample": "https://api.zhihu.com/search_v1?",
        "jq": "del(.pendant)",
        "note": "搜索结果删除 pendant 挂件",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/search/tabs\\?",
        "sample": "https://api.zhihu.com/search/tabs?",
        "jq": ".data |= map(select(.t | IN(\"general\", \"ai_zhida\", \"recent\", \"people\", \"zvideo\", \"ring\", \"topic\", \"podcast\", \"column\", \"pin\", \"favlist\")))",
        "note": "搜索 Tab 只保留业务类型",
        "source": "https://kelee.one/"
      },
      {
        "url": "^https?://api\\.zhihu\\.com/people/self$",
        "sample": "https://api.zhihu.com/people/self",
        "jq": "del(.vip_info.entrance_new.right_button, .vip_info.entrance_v2)",
        "note": "我的页删除 VIP 推广入口（不改会员状态）",
        "source": "https://kelee.one/"
      }
    ]
  },
