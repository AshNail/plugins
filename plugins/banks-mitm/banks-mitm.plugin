#!name=银行与信用卡 · 静态广告CDN与专域接口净化（可选MITM） v1.1.0
#!desc=banks.plugin 配套可选 MITM 增强插件（默认启用 8 条路径级原生 [Rewrite] v2 规则 + 7 条 QUIC 回退，按开关分流控制）：针对招商掌上生活（res.cc.cmbimg.com/fsp/File/AdPlatformPublic/ 视频开屏 reject_video(200) + 静态图 reject_img(200)、s3gw.cmbimg.com 与双生域 s3gw.cmbimg.cn /mbappinitads/、pic1cdn.cmbchina.com/appinitads/）、浦发/浦大喜奔（lban.spdb.com.cn getAdvList/prefetchAdvList.ah reject_dict(200)）、工商银行（v.icbc.com.cn/userfiles/(ADResources|Resources/WAP/advertisement)/ reject_img(200)）与广发发现精彩（static.95508.com ads/popupads/advertising 目录 reject_img(200)）；严格隔离所有强 SSL Pinning 核心交易/支付网关与买单吧双线主网关 creditcardapp.bankcomm.com / creditcardapp.bankcomm.cn 及 mbmodule-openapi.paas.cmbchina.com。需安装并完全信任 Loon CA 证书后启用。
#!author=edy
#!homepage=https://github.com/AshNail/plugins
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/f1/6a/4e/f16a4eb9-1de3-833f-0f56-df39c3df6d09/AppIcon-0-1x_U007ephone-0-1-0-sRGB-85-220-0.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-19
#!tag=去广告,银行,信用卡,MITM
#!type=normal
#!source=c981f09701e6e27b1ab65178c7954e670d6283ea39855a3b30748b6d8687e588
# version=1.1.0
# docs=https://github.com/AshNail/plugins/blob/main/plugins/banks-mitm/README.md

# ========================================================================
# 银行与信用卡 · 静态广告CDN与专域接口净化（可选MITM） v1.1.0
# ------------------------------------------------------------------------
# 定位边界：本插件是 zero-MITM 底座插件 banks.plugin 的显式可选（opt-in）MITM 配套增强插件——不希望任何银行流量走 CA 解密的用户只装 banks.plugin 即可；仅在确认 Loon 已安装并完全信任根证书、且希望在 Loon 内一键开关静态广告图 CDN 与非核心广告后端路径级清理时，再叠加启用本插件。
# 硬性隔离红线（绝不写入 mitm_hosts，由 tests/lint-plugins.py check_banks_mitm_guard 反向锁死）：mlife.cmbchina.com / az1mbasecc.bas.cmbchina.com / intellicc.bas.cmbchina.com / mbmodule-openapi.paas.cmbchina.com / ccclub.cmbchina.com / trip.cmbchina.com（掌上生活与招行强 Pinning 核心 API、积存金 PaaS 与权益网关，社区实证放入 MITM 易致设置页打不开或网络异常）、creditcardapp.bankcomm.com / creditcardapp.bankcomm.cn / creditcard.bankcomm.com（买单吧双线主网关与通用 FastDFS 图床）、wallet.95516.com / base.95516.com / account.95516.com（云闪付强 Pinning 核心接口）、mbs.boc.cn（中行主网关）、yunbusiness.ccb.com（建行生活核心）、www.abchina.com.cn / msmp.abchina.com.cn / mobilepaas.abchina.com.cn（农行核心、风控与 mPaaS /mgw.htm 网关）、d.psbc.com / login-service.mobile-bank.psbc.com / mobile-bank.psbc.com（邮储核心网关），以及 yghsh.cebbank.com / static.cebbank.com / rs.creditcard.cmbc.com.cn / static.creditcard.hxb.com.cn / images.cib.com.cn / m.citiccardcdn.citicbank.com（业务与功能图标混装共享 CDN）。
# 诚实效果预期（掌上生活 & 买单吧）：① 掌上生活（招商银行信用卡）：本插件只解密静态图床 res.cc.cmbimg.com / s3gw.cmbimg.com / s3gw.cmbimg.cn / pic1cdn.cmbchina.com 的纯广告子目录，并在 AdPlatformPublic 目录按视频（.mp4/.mov -> reject_video(200)）与静态图（reject_img(200)）两段精准有序拦截；由于主 API preCacheAdvertiseSec 会在上一次启动把开屏图预缓存到本地沙盒，安装后需先划掉掌上生活后台并清理缓存（或等待当期预缓存过期）方能观测效果，且开屏容器若展示本地兜底/第一方卡片位属客户端原生限制。② 买单吧（交通银行信用卡）：其开屏接口 queryGuidePageAds.do / getPopAds.do / qryLaunchAds.do / qryPopAds.do 与全部交易共用强 Pinning 双线主网关 creditcardapp.bankcomm.com / creditcardapp.bankcomm.cn，图片走通用 /tfimg/public00/M00/ 与 /tofimg/，Loon 无法在不触碰主网关的前提下安全切除，因此本插件不覆盖买单吧，买单吧仍依赖零证书 banks.plugin + 官方关怀版 + 端内权限关闭 +（带冷启局限说明的）URL Scheme 协同。
# 规则来源可追溯：res.cc.cmbimg.com/fsp/File/AdPlatformPublic/（含 .mp4 视频开屏与图片素材）、s3gw.cmbimg.com/mbappinitads/、s3gw.cmbimg.cn/mbappinitads/ 与 pic1cdn.cmbchina.com/appinitads/ 来自社区实证开屏/初始化广告素材路径；lban.spdb.com.cn/mspmk-web-component/(getAdvList|prefetchAdvList).ah 来自 blackmatrix7/ios_rule_script（使用 reject_dict(200) 比 DNS 黑洞更细粒度且规避误伤其它 web-component）；v.icbc.com.cn/userfiles/(ADResources|Resources/WAP/advertisement)/ 来自 AdGuard-CN 与 AdRules（$domain 过滤路径规则）；static.95508.com/(mmg/images/ads|mmg/ciop/sysabbr/cmep/images/(app)?popupads|icppweb/images/modelMaterial/advertising)/ 来自 blackmatrix7 与 AdRules 公开广发发现精彩纯广告与弹窗素材路径。
# 本文件由 tools/build-apps.py 从 src/apps/banks-mitm.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开。自动化类的默认值是显式源内裁决（v3.6.0 起 QDREADER_* 六开关默认# 开——用户裁决接受服务端风控后果）；每个开关都仍可单独关掉切面停用。
# ========================================================================

[Argument]

cleanCmbSplash = switch,true,type=boolean,tag=掌上生活静态/视频开屏 CDN（默认开）,desc=双线拦截招商掌上生活静态图床纯广告路径（AdPlatformPublic 含 .mp4/.mov 视频开屏 reject_video(200) 与图片 reject_img(200)、s3gw.cmbimg.com 与 s3gw.cmbimg.cn mbappinitads / pic1cdn appinitads），不碰 mlife / az1mbasecc / intellicc / mbmodule-openapi / ccclub 核心网关。
cleanSpdbAds = switch,true,type=boolean,tag=浦发/浦大喜奔开屏后端（默认开）,desc=精确拦截浦发 lban.spdb.com.cn/mspmk-web-component/getAdvList.ah 与 prefetchAdvList.ah，request 阶段返回 reject_dict(200) 空 JSON。
cleanBankCdnAds = switch,true,type=boolean,tag=工行与发现精彩静态广告目录（默认开）,desc=精确拦截工行 v.icbc.com.cn/userfiles/(ADResources|Resources/WAP/advertisement)/ 与广发发现精彩 static.95508.com 广告/popupads 素材目录，返回 reject_img(200)。

[Rule]

# ------------------------------------------------------------
# QUIC 回退（增强层配套 · 拒的是 HTTP/3 协议，回落 TCP 后正文不受影响）
# MITM 只解密 TCP；App 走 HTTP/3 时下面这些主机的响应脚本会静默收不到。本组只对 PROTOCOL,QUIC 生效，同一主机的 TCP 请求（正文/书架/章节）零影响。
AND,((DOMAIN-SUFFIX,lban.spdb.com.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,pic1cdn.cmbchina.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,res.cc.cmbimg.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,s3gw.cmbimg.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,s3gw.cmbimg.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,static.95508.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,v.icbc.com.cn),(PROTOCOL,QUIC)),REJECT


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = res.cc.cmbimg.com, s3gw.cmbimg.com, s3gw.cmbimg.cn, pic1cdn.cmbchina.com, lban.spdb.com.cn, v.icbc.com.cn, static.95508.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_dict/reject_img 在
# 出网前就地返回合法空载荷，请求不再发出；本层不含响应体改写。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段视频与透明图两段拦截（reject_video(200) / reject_img(200)）：招商/掌上生活开屏物料 CDN
# ------------------------------------------------------------
# kill-cmb-adplatform-video: 掌上生活 AdPlatformPublic 视频开屏物料优先命中 reject_video(200)，避免把 .mp4/.mov 响应成 GIF（来源 https://site.cc.cmbimg.com/AgreementManager/agreement/AppSDK.html）
request if ${cleanCmbSplash} == true && ${url} ~= /^https:\/\/res\.cc\.cmbimg\.com\/fsp\/File\/AdPlatformPublic\/.*\.(?:mp4|mov)(?:\?|$)/ then reject_video(200)

# kill-cmb-adplatform: 掌上生活 AdPlatformPublic 纯广告图片物料目录（非视频物料兜底返回 1px 透明 GIF）（来源 https://site.cc.cmbimg.com/AgreementManager/agreement/AppSDK.html）
request if ${cleanCmbSplash} == true && ${url} ~= /^https:\/\/res\.cc\.cmbimg\.com\/fsp\/File\/AdPlatformPublic\// then reject_img(200)

# kill-cmb-mbappinitads: 招行与掌上生活 S3 对象存储 mbappinitads 启动初始化广告目录（.com）（来源 https://github.com/blackmatrix7/ios_rule_script）
request if ${cleanCmbSplash} == true && ${url} ~= /^https:\/\/s3gw\.cmbimg\.com\/mbappinitads\// then reject_img(200)

# kill-cmb-mbappinitads-cn: 招行与掌上生活双生域名 s3gw.cmbimg.cn 下的 mbappinitads 启动初始化广告目录（来源 https://github.com/blackmatrix7/ios_rule_script）
request if ${cleanCmbSplash} == true && ${url} ~= /^https:\/\/s3gw\.cmbimg\.cn\/mbappinitads\// then reject_img(200)

# kill-cmb-pic1cdn-ads: 招行 pic1cdn 共享图床下的 appinitads 启动广告目录，不碰业务图路径（来源 https://github.com/blackmatrix7/ios_rule_script）
request if ${cleanCmbSplash} == true && ${url} ~= /^https:\/\/pic1cdn\.cmbchina\.com\/appinitads\// then reject_img(200)

# ------------------------------------------------------------
# 请求阶段 JSON 空响应（reject_dict(200)）：浦发/浦大喜奔开屏后端
# ------------------------------------------------------------
# kill-spdb-advlist: 浦发银行与浦大喜奔客户端开屏及营销广告列表接口（与 banks.plugin 注释态整域候选二选一，路径级更安全）（来源 https://github.com/blackmatrix7/ios_rule_script）
request if ${cleanSpdbAds} == true && ${url} ~= /^https:\/\/lban\.spdb\.com\.cn\/mspmk-web-component\/(?:getAdvList|prefetchAdvList)\.ah(?:\?|$)/ then reject_dict(200)

# ------------------------------------------------------------
# 请求阶段透明图替换（reject_img(200)）：工行与广发发现精彩静态广告目录
# ------------------------------------------------------------
# kill-icbc-adresources: 工商银行多媒体域名下的纯广告子目录，不动其余共享业务资源（来源 https://github.com/AdguardTeam/AdguardFilters）
request if ${cleanBankCdnAds} == true && ${url} ~= /^https:\/\/v\.icbc\.com\.cn\/userfiles\/(?:ADResources|Resources\/WAP\/advertisement)\// then reject_img(200)

# kill-cgb-static-ads: 广发银行发现精彩共享 CDN 下的 ads、popupads 与 advertising 静态素材子目录（来源 https://github.com/Cats-Team/AdRules）
request if ${cleanBankCdnAds} == true && ${url} ~= /^https:\/\/static\.95508\.com\/(?:mmg\/images\/ads|mmg\/ciop\/sysabbr\/cmep\/images\/(?:app)?popupads|icppweb\/images\/modelMaterial\/advertising)\// then reject_img(200)
