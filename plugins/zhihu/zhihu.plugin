#!name=知乎 · 去广告与精简
#!desc=知乎 iOS：自建遥测/分析（zhihu-web-analytics/sugar/crash2）+ 商业化数据追踪（udd1i5）零证书 DNS 黑洞；同域商业化广告接口（commercial_api/ad-style-service）、推广/预置词及首页推荐流（topstory/recommend）/关注流（moments_v3）内联广告卡片默认启用 Loon 原生 [Rewrite] v2 引擎复写（cleanAds 开关默认开，request 阶段 reject_dict(200) + response.json.jq 字段级剥离，零 JS 脚本）；核心问答/文章/个人页/图床/推送严格设防红线。前置：同域复写层需已安装并信任 Loon 证书。
#!author=edy
#!version=1.2.2
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/zhihu/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/a4/33/69/a43369ac-cef8-3356-4fae-fb504841e37d/AppIcon-0-0-1x_U007emarketing-0-7-0-sRGB-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-09
#!tag=去广告,知乎
#!type=normal
#!source=b809e81c352cc0847f0ee36a976c51624d78bb6007c13d6bff889773219aaa66

# ========================================================================
# 知乎 · 去广告与精简
# ------------------------------------------------------------------------
# 红线（绝不进任何拦截组）：passport.zhihu.com 账号与安全登录网关 / api.zhihu.com 知乎核心业务 API，问答与文章主服务 / zhuanlan.zhihu.com 知乎专栏核心域名 / unpkg.zhihu.com 前端静态资源与组件加载 / mqtt.zhihu.com 实时消息推送长连接通道 / lc-push.zhihu.com 移动端离线/在线推送通道 / pic1.zhimg.com 静态图片与用户头像图床。
# 知乎主站与业务共享根域 *.zhihu.com，禁止整域通配。
# 知乎图片素材与静态资产共享根域 *.zhimg.com，禁止整域通配。
# 能力天花板与原生设计：zhihu-web-analytics、sugar、crash2、udd1i5 四个自建数据与遥测域走 [Host] 127.0.0.1 零证书黑洞；商业化接口走 Loon 原生 [Rewrite] v2（reject_dict(200)），首页推荐流与关注流内联广告走 response.json.jq 数组元素剥离，保持零 JS 脚本。
# v1.2.1 升级 Loon 原生 [Rewrite] v2 引擎复写层（enhance.active=true）：删除被 commercial_api/ 整族前缀完全覆盖的 2 条冗余子规则，新增顶部横幅（growth/mobile_top_banner）、搜索高亮推广词（entity_word）与问题相关搜索词（questions/related-search）3 条规则，通过 [Argument] cleanAds 开关（默认开）驱动 14 条 request 阶段 reject_dict(200) 规则 + 2 条信息流/关注流 response.json.jq 规则 + 3 台解密主机的 QUIC 回退。
# 本文件由 tools/build-apps.py 从 src/apps/zhihu.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开。自动化类的默认值是显式源内裁决（v3.6.0 起 QDREADER_* 六开关默认# 开——用户裁决接受服务端风控后果）；每个开关都仍可单独关掉切面停用。
# ========================================================================

[Argument]

cleanAds = switch,true,tag=同域商业化与推荐位去广告（默认开）,desc=启用 Loon 原生 [Rewrite] v2 引擎复写：commercial_api、ad-style-service、回答底部推广、瀑布流推荐、搜索预置词、直答引导与营销气泡在 request 阶段直接 reject_dict(200) 终止；首页推荐流与关注流通过 response.json.jq 剔除内联广告卡片。需已安装并信任 Loon 证书。

[Rule]

# ------------------------------------------------------------
# QUIC 回退（增强层配套 · 拒的是 HTTP/3 协议，回落 TCP 后正文不受影响）
# MITM 只解密 TCP；App 走 HTTP/3 时下面这些主机的响应脚本会静默收不到。本组只对 PROTOCOL,QUIC 生效，同一主机的 TCP 请求（正文/书架/章节）零影响。
AND,((DOMAIN-SUFFIX,api.zhihu.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,www.zhihu.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,zhida.zhihu.com),(PROTOCOL,QUIC)),REJECT

[Host]

# ------------------------------------------------------------
# 知乎自建遥测 / 崩溃分析 / 商业化追踪与广告素材（置信 A）
# zhihu-web-analytics.zhihu.com（9源，知乎官方 Web/移动端分析）、udd1i5.zhihu.com（5源，商业化追踪与素材 CDN）、sugar.zhihu.com（4源，崩溃上报与监控平台）、crash2.zhihu.com（3源，崩溃分析日志端点）、adstatic.zhihu.com（知乎商业广告专用静态资产域）。均非业务数据流，DNS 映射 127.0.0.1 阻断。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://github.com/Cats-Team/AdRules
# 证据: https://github.com/hagezi/dns-blocklists
adstatic.zhihu.com = 127.0.0.1
crash2.zhihu.com = 127.0.0.1
sugar.zhihu.com = 127.0.0.1
udd1i5.zhihu.com = 127.0.0.1
zhihu-web-analytics.zhihu.com = 127.0.0.1


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = %APPEND% api.zhihu.com, www.zhihu.com, zhida.zhihu.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_dict/reject_img 在
# 出网前就地返回合法空载荷，response.json.* 由引擎底层自动完成 gzip/br 解压与
# 字段级改写（不依赖脚本层 $utils.ungzip），Accept-Encoding 协商保护同域脚本链。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段直接终止（reject_dict(200)）：商业化广告与推荐卡片接口
# ------------------------------------------------------------
# kill-ad-style: 知乎广告样式服务请求直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/ad-style-service\/request/ then reject_dict(200)

# kill-api-commercial: api.zhihu.com 商业化广告接口整族（开屏/Banner/角标/回答底部）直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/commercial_api\// then reject_dict(200)

# kill-next-render: 回答下方穿插渲染卡片（不依赖查询参数顺序）直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/next-render\?(?=[^#]*\btype=answer\b)/ then reject_dict(200)

# kill-related-waterfall: 相关推荐瀑布流直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/related_recommend\/feed\/waterfall/ then reject_dict(200)

# kill-preset-words: 搜索框预置推广词直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/search\/preset_words/ then reject_dict(200)

# kill-related-queries: 问题页相关搜索词推广直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/search\/related_queries\/question\/\d+/ then reject_dict(200)

# kill-zhida-guidance: 知乎直答 AI 引导卡片直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/zhida\.zhihu\.com\/ai_ingress\/ai_chat\/guidance/ then reject_dict(200)

# kill-bubble-show: 内容分发气泡提示直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/show/ then reject_dict(200)

# kill-homepage-card: 个人主页推广卡片直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/www\.zhihu\.com\/api\/v\d+\/members\/homepage_card/ then reject_dict(200)

# kill-www-commercial: www.zhihu.com 网页/混合容器商业化广告接口整族直接返回 200 + 空字典（来源 https://github.com/limbopro/Adblock4limbo/blob/main/Zhihu.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/www\.zhihu\.com\/commercial_api\// then reject_dict(200)

# kill-homepage-entry: 个人中心推广入口模块直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/people\/homepage_entry_v\d+/ then reject_dict(200)

# kill-top-banner: 移动端顶部应用推广引导横幅直接返回 200 + 空字典（来源 https://github.com/limbopro/Adblock4limbo/blob/main/Zhihu.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:api|www)\.zhihu\.com\/api\/v\d+\/growth\/mobile_top_banner/ then reject_dict(200)

# kill-entity-word: 正文内联搜索高亮推广词（放大镜蓝字广告词）直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:api|www)\.zhihu\.com\/api\/v\d+\/entity_word/ then reject_dict(200)

# kill-related-search: 问题页底部「大家都在搜」推广搜索词直接返回 200 + 空字典（来源 https://github.com/limbopro/Adblock4limbo/blob/main/Zhihu.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/www\.zhihu\.com\/api\/v\d+\/questions\/\d+\/related-search/ then reject_dict(200)

# ------------------------------------------------------------
# 响应字段级净化（response.json.jq）：保留正常问答流，剔除穿插内联广告
# ------------------------------------------------------------
# clean-topstory-recommend: 首页推荐信息流：剔除 feed_advert、target.type=advert 及携带 adjson/promotion_extra 的商业推广卡片（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/topstory\/recommend(\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"array\" then .data |= map(select(type != \"object\" or (.type != \"feed_advert\" and ((.target | if type == \"object\" then (.type // \"\") else \"\" end) != \"advert\") and .adjson == null and .promotion_extra == null))) else . end")

# clean-moments-feed: 关注动态信息流：剔除穿插的商业推广与内联广告卡片（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Zhihu_remove_ads.lpx）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/api\.zhihu\.com\/moments_v3(\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"array\" then .data |= map(select(type != \"object\" or (.type != \"feed_advert\" and ((.target | if type == \"object\" then (.type // \"\") else \"\" end) != \"advert\") and .adjson == null and .promotion_extra == null))) else . end")
