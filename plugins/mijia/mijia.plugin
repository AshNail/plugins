# stat.pandora.xiaomi.com = 127.0.0.1
# stat.youpin.mi.com = 127.0.0.1
# tracking.intl.miui.com = 127.0.0.1
# tracking.rus.miui.com = 127.0.0.1
# wtradv.market.xiaomi.com = 127.0.0.1
# xadx.file.market.xiaomi.com = 127.0.0.1
# xiaomi-dtv.m.cn.miaozhen.com = 127.0.0.1

# ------------------------------------------------------------
# 小米数据追踪/AB 实验（默认关）（置信 B）
# mistat 与设备端远程配置可能同链——收益=隐私,风险=配置拉取,默认关,抓包确认再开。
# 证据: https://github.com/privacy-protection-tools/anti-AD
