#!name=米家 · 去广告（小米广告平台层）
#!desc=如实定位:米家 App 首页运营卡片/商城推荐为第一方内嵌(api.io.mi.com 响应体),DNS 不可分。本插件黑洞小米统一广告平台(*.ad.xiaomi.com/o2o/有品推荐)——对 MIUI/澎湃系统投放有效,iOS 米家是否调用该平台未经抓包证实。设备控制/账号/推送域名零接触。零证书。
#!author=edy
#!version=1.1.3
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/mijia/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/e8/a5/cc/e8a5cc32-b075-3ac1-47c8-47025d5e42ac/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-0-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(983)
#!date=2026-10-28
#!tag=去广告,米家,小米
#!type=normal

# ========================================================================
# 米家 · 去广告（小米广告平台层）
# ------------------------------------------------------------------------
# 红线（误伤=掉设备,任何组绝不出现）：api.io.mi.com / app.io.mi.com / center.io.mi.com / token.io.mi.com / ot.io.mi.com / iothub.io.mi.com / account.xiaomi.com 系 / api.xmpush.xiaomi.com 系（营销推送与设备推送同通道,不可选择性拦截）/ miot-spec.org。
# 米家证书固定 + IoT 控制安全 → 明确不做 MITM;首页卡片/有品推荐/场景推荐随主 API 下发,DNS 层无解。
# iOS 预期设低:小米厂商广告 SDK 组主要作用于 Android/MIUI;本插件 iOS 净收益以抓包为准,先给开关不给承诺。
# 覆盖率审计的未裁决候选由 triage_exclude 台账逐族裁决（安全/推送/账号云/遥测/业务 API）——被排除的候选不是待办。
# 本文件由 tools/build-apps.py 从 src/apps/mijia.json 生成，不要手改生成物。
# ========================================================================

[Host]

# ------------------------------------------------------------
# 小米统一广告平台 / MSA 投放（置信 A）
# ad.xiaomi.com 全域成员(api/cdn/sdkconfig/ssp/test/zeus/new.api/diagnosis/track)+ ad1/ad.intl/api.admob + ad.mi.com + o2o.api（新零售广告）——anti-AD 与 edmon1024 小米专项清单一致收录。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://gist.github.com/edmon1024/9995f04f2bb33b72f7d2cb74c4352732
*.ad.xiaomi.com = 127.0.0.1
ad.intl.xiaomi.com = 127.0.0.1
ad.mi.com = 127.0.0.1
ad.xiaomi.com = 127.0.0.1
ad1.xiaomi.com = 127.0.0.1
api.admob.xiaomi.com = 127.0.0.1
o2o.api.xiaomi.com = 127.0.0.1

# ------------------------------------------------------------
# MIUI/澎湃系统广告与分析面（默认关，仅小米 Android 设备有感知）（置信 A）
# 覆盖率审计（tools/app-coverage-audit.py）从 hagezi-xiaomi/anti-ad/AdGuard 反查出的小米系统面缺口：adv.sec=安全中心推荐位、activity/hot.browser=浏览器运营/热榜广告位、stat.youpin=有品推荐、stat.pandora=应用商店推荐、tracking.intl/rus=国际版遥测、inf/apm-rum/api.collect/cc/ccc/metok/geofence.sys=系统分析与定位采集、xiaomi-dtv.m.cn.miaozhen=秒针广告测量。对 iPhone/iPad 米家用户零效果；小米手机用户试开。安全组件（auth.be/api.sec/mazu/notify/logupdate 族）刻意不列——防诈与推送通道不许碰。第十二轮补入 adx.tv.mi.com（电视端广告交易）与 adv.l7.34.sec.miui.com（安全中心广告位置）两条 B 级候选（2 源），仍为默认关。第十三轮补入 5 条广告基础设施（均 2 源）：global-ad-extranet-pri-azams/azpn.alb.xiaomi.com、global-ad-intl-pri-alisgp.alb.xiaomi.com（跨国广告投放 ALB）、wtradv.market.xiaomi.com（应用商店推广位）、xadx.file.market.xiaomi.com（小米 ADX 素材），仍为默认关。
# 证据: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/native.xiaomi.txt
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
# （默认关闭的组：整组注释，取消注释即启用）
# 3rdupgrade.pandora.xiaomi.com = 127.0.0.1
# activity.browser.intl.miui.com = 127.0.0.1
# ad.cdn.pandora.xiaomi.com = 127.0.0.1
# ad.eu.xiaomi.com = 127.0.0.1
# ad.india.xiaomi.com = 127.0.0.1
# ad.miui.com = 127.0.0.1
# ad.quickapp.hybrid.xiaomi.com = 127.0.0.1
# ad.rus.xiaomi.com = 127.0.0.1
# adv.l7.34.sec.miui.com = 127.0.0.1
# adv.sec.intl.miui.com = 127.0.0.1
# adv.sec.miui.com = 127.0.0.1
# adx.tv.mi.com = 127.0.0.1
# api.ads.xiaomi.com = 127.0.0.1
# api.brs.intl.miui.com = 127.0.0.1
# api.collect.data.intl.miui.com = 127.0.0.1
# apm-rum.inf.miui.com = 127.0.0.1
# cc.sys.miui.com = 127.0.0.1
# ccc.sys.miui.com = 127.0.0.1
# geofence.sys.miui.com = 127.0.0.1
# global-ad-extranet-pri-azams.alb.xiaomi.com = 127.0.0.1
# global-ad-extranet-pri-azpn.alb.xiaomi.com = 127.0.0.1
# global-ad-intl-pri-alisgp.alb.xiaomi.com = 127.0.0.1
# hot.browser.intl.miui.com = 127.0.0.1
