#!name=米家 · 去广告（小米广告平台层）
#!desc=如实定位:米家 App 首页运营卡片/商城推荐为第一方内嵌(api.io.mi.com 响应体),DNS 不可分。本插件黑洞小米统一广告平台(*.ad.xiaomi.com/o2o/有品推荐)——对 MIUI/澎湃系统投放有效,iOS 米家是否调用该平台未经抓包证实。设备控制/账号/推送域名零接触。零证书。
#!author=edy
#!version=1.0.0
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/mijia/README.md
#!icon=https://cdn.adguard.com/public/Adguard/Common/logo.png
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(983)
#!date=2026-10-28
#!tag=去广告,米家,小米
#!type=normal

# ========================================================================
# 米家 · 去广告（小米广告平台层）
# ------------------------------------------------------------------------
# 红线（误伤=掉设备,任何组绝不出现）：api.io.mi.com / app.io.mi.com / center.io.mi.com / token.io.mi.com / ot.io.mi.com / iothub.io.mi.com / account.xiaomi.com 系 / api.xmpush.xiaomi.com 系（营销推送与设备推送同通道,不可选择性拦截）/ miot-spec.org。
# 米家证书固定 + IoT 控制安全 → 明确不做 MITM;首页卡片/有品推荐/场景推荐随主 API 下发,DNS 层无解。
# iOS 预期设低:小米厂商广告 SDK 组主要作用于 Android/MIUI;本插件 iOS 净收益以抓包为准,先给开关不给承诺。
# 本文件由 tools/build-apps.py 从 src/apps/mijia.json 生成，不要手改生成物。
# ========================================================================

[Host]

# ------------------------------------------------------------
# 小米统一广告平台 / MSA 投放（置信 A）
# ad.xiaomi.com 全域成员(api/cdn/sdkconfig/ssp/test/zeus/new.api/diagnosis/track)+ ad1/ad.intl/api.admob + ad.mi.com + o2o.api（新零售广告）——anti-AD 与 edmon1024 小米专项清单一致收录。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://gist.github.com/edmon1024/9995f04f2bb33b72f7d2cb74c4352732
*.ad.xiaomi.com = 127.0.0.1
ad.intl.xiaomi.com = 127.0.0.1
ad.mi.com = 127.0.0.1
ad.xiaomi.com = 127.0.0.1
ad1.xiaomi.com = 127.0.0.1
api.admob.xiaomi.com = 127.0.0.1
o2o.api.xiaomi.com = 127.0.0.1

# ------------------------------------------------------------
# 小米数据追踪/AB 实验（默认关）（置信 B）
# mistat 与设备端远程配置可能同链——收益=隐私,风险=配置拉取,默认关,抓包确认再开。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# （默认关闭的组：整组注释，取消注释即启用）
# a.stat.xiaomi.com = 127.0.0.1
# abtest.mistat.xiaomi.com = 127.0.0.1
# data.mistat.xiaomi.com = 127.0.0.1
# fcanr.tracking.miui.com = 127.0.0.1
# stat.xiaomi.com = 127.0.0.1
# storeconfig.mistat.xiaomi.com = 127.0.0.1
# tracking.miui.com = 127.0.0.1
