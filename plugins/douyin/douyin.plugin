#!name=抖音 · douyin
#!desc=抖音唯一插件：福利页精简（只留【攒时长 听歌不中断】）、激励广告配置清理、商业化弹窗/商城/演出清理、广告域名拦截、只读日志，全部用 [Argument] 开关控制。数据来自 2026-10 真实 HAR 取证。
#!author=edy
#!version=0.1.0
#!homepage=https://github.com/AshNail/plugins
#!system=ios
#!loon_version=3.2.1(734)
#!tag=抖音,去广告,福利页,Loon

# ============================================================================
# douyin.plugin 说明（一个 App 一个插件）
# ----------------------------------------------------------------------------
# 目标接口：beta-luna.douyin.com/luna/*（抖音内嵌的音乐/福利模块）
#
# 开关：
#   treasureMinimal  福利页精简（默认开）：只留【攒时长 听歌不中断】
#   cleanAds         激励广告配置清理（默认关）：会破坏攒时长模块，慎开
#   cleanUpsell      商业化弹窗/商城/演出清理（默认关）
#   blockAdDomains   广告域名拦截（默认关）：MITM + http-request 脚本
#   debugLog         只读日志（默认关）：日志前缀 [douyin-reward]
#
# 重要事实（HAR 取证，别踩坑）：
#   1. 【攒时长 听歌不中断】= duration_task_section / luna_rewards_ads，
#      按钮 schema 里 ad_type=ads_get_duration、luckydog_task_type=luna_watch_ads_settle_vip
#      —— 它本身就是“看广告结算 VIP 时长”。
#      所以：清激励广告配置（cleanAds）或拦广告域名（blockAdDomains）都会让这个模块拿不到时长。
#   2. 【签到得金币】= gold_task_section / soda_music_sign_in，点不动是**服务端风控**：
#      aweme.snssdk.com/aweme/ug/common/luckyapi/v1/common/sign_in/sign_in_done
#      返回 {"err_no":210021,"err_tips":"设备异常，领取失败"}（luckydog 设备分只有 13.9，
#      且地区为新加坡）。插件没有拦这个接口，与本插件无关；换大陆环境/正常账号才可能过。
#      另外 sign_in_detail 里写明“先听 30 秒”才发奖（treasure.sign_in.listen_duration_seconds=30）。
#   3. 【商城】= gold_task_section / luna_treasure_shop（逛街赚金币）
#      + commerce/v2/upsell 的 browse_mall_popup_acc_amount（逛商城赚金币弹窗）。
#   4. 【演出】= growth/music_festival/performance_details 的 detail_list（汽水音乐节）。
#      它不在福利页 sections 里，福利页精简不会自动去掉，需要 cleanUpsell。
#   5. 广告时长是**客户端**字段（advert_duration=30 / launch_duration=30），
#      但发奖靠服务端凭证（advert/fallback/done/info 的 time_token/nonce →
#      advert/incentive/done）。少看广告再领奖属于广告欺诈，本插件不做。
#
# 风险：
#   - MITM beta-luna.douyin.com 后若抖音报网络异常，说明该域名有证书固定，
#     停用 [Script]/[Rewrite]/[MITM] 即可回滚。
#   - 福利页精简后只剩攒时长模块，看广告/签到/翻卡/红包雨等入口都会消失。
# ============================================================================

[Argument]
treasureMinimal = switch,true,tag=福利页精简,desc=福利页只保留【攒时长 听歌不中断】；我的资产/签到/商城/看广告/翻卡/红包雨/开宝箱等入口全部移除。
cleanAds = switch,false,tag=激励广告配置清理,desc=清空 incentive/config、incentive/retrieve、ads/config、ads/dsp/retrieve 的广告源与素材。注意：会让【攒时长 听歌不中断】失效。
cleanUpsell = switch,false,tag=商业化弹窗/商城/演出清理,desc=删除 upsell 里的广告类弹窗与逛商城弹窗，并清空汽水音乐节（演出）列表。
blockAdDomains = switch,false,tag=广告域名拦截,desc=拦截 ad.zijieapi.com 等广告/归因域名（需 MITM，HTTP/3 可能漏过）。
debugLog = switch,false,tag=只读日志,desc=记录福利页分区/任务、广告时长与素材、商业化弹窗、发奖结果；不修改响应。


# ============================================================================
# 1. [Rule]
# ----------------------------------------------------------------------------
# 默认不拦任何域名，保证攒时长（看广告结算）能正常跑。
# 需要 100% 拦截（不依赖 MITM、能挡 HTTP/3）时取消下面 5 行注释；
# 注意那会阻断激励广告，攒时长模块随之失效。
# ============================================================================

[Rule]

# ---- 严格模式：取消注释后生效 ----
# DOMAIN,ad.zijieapi.com,REJECT
# DOMAIN,lianmengapi.snssdk.com,REJECT
# DOMAIN,ads5-normal-hl.zijieapi.com,REJECT
# DOMAIN,zlink.ugsdk.cn,REJECT
# DOMAIN,praisewindow.ugsdk.cn,REJECT


# ============================================================================
# 2. [Rewrite]
# ----------------------------------------------------------------------------
# 暂不放纯上报端点：抖音侧上报域名未取证，避免误伤。
# ============================================================================

[Rewrite]


# ============================================================================
# 3. [Script]
# ----------------------------------------------------------------------------
# 所有脚本都通过 enable={开关名} 控制。
# ============================================================================

[Script]

# ---- 福利页精简：只留【攒时长 听歌不中断】 ----
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/treasure\/task\/page\/v2 script-path=scripts/treasure.min.js, requires-body=true, timeout=10, argument=[{treasureMinimal}], enable={treasureMinimal}

# ---- 激励广告配置/素材清理 ----
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/(?:advert\/incentive\/(?:config|retrieve)|ads\/(?:config|dsp\/retrieve)) script-path=scripts/clean.min.js, requires-body=true, timeout=10, argument=[{cleanAds}], enable={cleanAds}

# ---- 商业化弹窗 / 商城清理 ----
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/commerce\/v2\/upsell script-path=scripts/clean.min.js, requires-body=true, timeout=10, argument=[{cleanUpsell}], enable={cleanUpsell}

# ---- 演出（汽水音乐节）清理 ----
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/growth\/music_festival\/performance_details script-path=scripts/clean.min.js, requires-body=true, timeout=10, argument=[{cleanUpsell}], enable={cleanUpsell}

# ---- 广告域名拦截：blockAdDomains 开关 ----
http-request ^https?:\/\/(?:ad\.zijieapi\.com|lianmengapi\.snssdk\.com|ads5-normal-hl\.zijieapi\.com|zlink\.ugsdk\.cn|praisewindow\.ugsdk\.cn)\/ script-path=scripts/block-domains.min.js, timeout=10, argument=[{blockAdDomains}], enable={blockAdDomains}

# ---- 只读日志：福利页 / 激励广告 / upsell / 发奖 ----
http-response ^https?:\/\/beta-luna\.douyin\.com\/luna\/(?:treasure\/task\/page\/v2|advert\/incentive\/(?:config|retrieve|done)|commerce\/v2\/upsell) script-path=scripts/observe.min.js, requires-body=true, timeout=10, enable={debugLog}


# ============================================================================
# 4. [MITM]
# ----------------------------------------------------------------------------
# beta-luna.douyin.com：福利页/激励广告/商业化弹窗接口。
# 5 个广告域名：blockAdDomains 开关需要（HTTPS 必须先解密）。
#                如果开开关后激励广告播不了，把这 5 个域名注释掉。
# ============================================================================

[MITM]

hostname = %APPEND% beta-luna.douyin.com, ad.zijieapi.com, lianmengapi.snssdk.com, ads5-normal-hl.zijieapi.com, zlink.ugsdk.cn, praisewindow.ugsdk.cn
