#!name=抖音 · douyin
#!desc=抖音唯一插件 v0.9.2：福利页精简（只留【攒时长 听歌不中断】）、信息流/搜索广告条目清理（含 previewGuide/priorityDisplay 与 video_track_mix 混播卡）、商业化弹窗/商城/演出清理（兼容 upsells v1 与 v2/upsell）、激励广告开关、广告域名拦截、开屏请求与品牌响应清理、只读日志。功能用 [Argument] 开关，传输层常开（QUIC 回退 + 压缩统一 gzip + h2）。数据来自 2026-10 真实 HAR 取证。需要 Loon 3.5.1(983)+（gzip 解析需 988+）；响应头带 X-Soda-Plugin 诊断标记。
#!author=edy
#!version=0.9.2
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/douyin/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/a4/4d/bc/a44dbc69-cbdf-b68c-ea88-d449683563e9/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-85-220.png/512x512bb.jpg
#!system=iOS
#!loon_version=3.5.1(983)
#!date=2026-11-09
#!tag=抖音,去广告,福利页,Loon

# 官方 Plugin 页的 `#!source`：声明插件作者指定下载地址 URL 字符串的 SHA-256，
# Loon 首次联网安装时对用户实际填写的完整 URL 算哈希并比对（多值逗号分隔，任一匹配即通过）。
# 注意它校验的是 **URL 本身**而非插件文件内容；且官方明写「不使用 HTTP 重定向后的地址比较」，
# 所以只能是这条直链。哈希由 tools/source_hash.py 现算，不要手抄——
# lint 的 check_source_hash() 会反向复算核对，手抄的哈希迟早与地址脱钩。
#!source=fe8fe76e0869af91c416bad9702b21921dc3049c24c3f3d8c46e71181522a82f

# ============================================================================
# douyin.plugin 说明（一个 App 一个插件）
# ----------------------------------------------------------------------------
# 目标接口：beta-luna.douyin.com/luna/*（抖音内嵌的音乐/福利模块）
#
# 共享脚本层：本插件的 block-domains / splash-ad / status 与
# 汽水插件共用同一份源码（src/common/*.js + src/common/families.json），
# tools/build.js 按家族参数展开到 src/douyin/ 后压缩；名单还由 lint
# 校验 [Script]/[MITM]/源码三处一致。
#
# 开关：
#   treasureMinimal  福利页精简（默认开）：只留【攒时长 听歌不中断】
#   cleanFeedAds     信息流/搜索/广告位清理（默认关）：不影响激励奖励
#   killRewardAds    激励广告素材与预拉取（默认关）：开=广告完全不发，奖励也没了
#   cleanUpsell      商业化弹窗/商城/演出清理（默认关）
#   blockAdDomains   广告域名拦截（默认关）：MITM + http-request 脚本
#   blockSplashAd    开屏请求与品牌响应清理（默认开）：不碰激励与发奖链路
#   debugLog         只读日志（默认关）：日志前缀 [douyin-reward]
#   statusNotify     状态自检按钮的通知模式（notification/silent）
#
# 两层模型（v0.8.0 起）：
#   L1 运行时层 = [Argument] 开关：只给“用户可能想改主意”的功能。
#   L2 静态层   = [Rule]/[Rewrite]/[MITM]：传输与协议层，常开、无开关。
#     · QUIC 强制回退：[MITM] 里这 16 个域拒绝 HTTP/3，逼回 TCP+TLS，
#       否则脚本根本看不见流量（MITM 只处理 TCP）。不做全局 QUIC 拒绝。
#     · h2 = true：零成本保险。官方 MitM 文档只列 hostname/ca-p12/ca-passphrase，
#       没有 h2（HTTP/2 解密是官方产品页宣称的默认能力）；社区插件通行写，
#       未知键被忽略，写了不亏。不当能力点宣称。
#   注：曾评估“删 Accept-Encoding 换明文”，实测 upsell 响应 gzip 后就有
#   183~191 KB，去掉压缩会让单次传输膨胀 5~10 倍，已放弃（详见 docs/loon-native-first.md）。
#   静态层没有开关，因为“关掉它”等于让上面所有脚本失效；要回滚就删对应行。
#
# 重要事实（HAR 取证，别踩坑）：
#   1. 【攒时长 听歌不中断】= duration_task_section / luna_rewards_ads，
#      按钮 schema 里 ad_type=ads_get_duration、luckydog_task_type=luna_watch_ads_settle_vip
#      —— 它本身就是“看广告结算 VIP 时长”。
#      所以：清激励广告配置（cleanAds）或拦广告域名（blockAdDomains）都会让这个模块拿不到时长。
#   2. 【签到得金币】= gold_task_section / soda_music_sign_in，点不动是**服务端风控**：
#      aweme.snssdk.com/aweme/ug/common/luckyapi/v1/common/sign_in/sign_in_done
#      返回 {"err_no":210021,"err_tips":"设备异常，领取失败"}（luckydog 设备分只有 13.9，
#      且地区为新加坡）。插件没有拦这个接口，与本插件无关；换大陆环境/正常账号才可能过。
#      另外 sign_in_detail 里写明“先听 30 秒”才发奖（treasure.sign_in.listen_duration_seconds=30）。
#   3. 【商城】= gold_task_section / luna_treasure_shop（逛街赚金币）
#      + commerce/v2/upsell 的 browse_mall_popup_acc_amount（逛商城赚金币弹窗）。
#   4. 【演出】= growth/music_festival/performance_details 的 detail_list（汽水音乐节）。
#      它不在福利页 sections 里，福利页精简不会自动去掉，需要 cleanUpsell。
#   5. 广告时长是**客户端**字段（advert_duration=30 / launch_duration=30），
#      但发奖靠服务端凭证（advert/fallback/done/info 的 time_token/nonce →
#      advert/incentive/done）。少看广告再领奖属于广告欺诈，本插件不做。
#   6. 同一响应 Loon 只执行“配置顺序里第一条条件为真”的 Response Script。
#      debugLog 与 treasureMinimal 同开时，福利页日志会被精简脚本遮蔽。
#
# 风险：
#   - MITM beta-luna.douyin.com 后若抖音报网络异常，说明该域名有证书固定，
#     停用 [Script]/[Rewrite]/[MITM] 即可回滚。
#   - 福利页精简后只剩攒时长模块，看广告/签到/翻卡/红包雨等入口都会消失。
# ============================================================================

# >>> GENERATED ARGUMENTS from src/args/douyin.json -- do not edit (npm run build:args)
[Argument]
treasureMinimal = switch,true,tag=福利页精简,desc=福利页只保留【攒时长 听歌不中断】；我的资产/签到/商城/看广告/翻卡/红包雨/开宝箱等入口全部移除。
cleanFeedAds = switch,false,tag=信息流/搜索广告清理,desc=清掉信息流/搜索/广告位响应里的广告容器与明确广告条目（is_ad/is_promoted 等）；保留正常媒体、系统公告与激励奖励。
killRewardAds = switch,false,tag=断掉激励广告,desc=清空 incentive/config 与 incentive/retrieve 的广告源、素材和预拉取列表。等于“广告完全不发”，攒时长/看广告赚金币随之失效，请谨慎。
cleanUpsell = switch,false,tag=商业化弹窗/商城/演出清理,desc=删除 upsell 里的广告类弹窗与逛商城弹窗，并清空汽水音乐节（演出）列表。
cleanActivity = switch,false,tag=活动入口清理,desc=目标：把 polaris 活动配置里的汽水音乐节（演出）与抖音运营活动（选游戏/选作者/开学季/创作者抽奖）置为不展示；不影响签到/翻卡/红包雨等任务。真机取证（2026-11-05 20:25:48）：polaris.zijieapi.com 固定证书——26 SNI / 26 Match / 26 次握手失败，这台主机的连接被掐断，绑定已注册但当前不生效。
blockAdDomains = switch,false,tag=广告域名拦截,desc=拦截 ad.zijieapi.com 等广告/归因域名（需 MITM，QUIC 已强制回退到 TCP）。会同时断掉激励广告。真机取证（2026-11-05 20:25:48）：ads 分片与 zlink.ugsdk.cn 固定证书（ads5-normal-gl2 5/5/5、zlink 6/6/6）——这几台的连接是被掐断的、不等同于拦截成功；ads.plugin 的 DNS 层不受影响。
blockSplashAd = switch,true,tag=开屏请求与品牌响应清理,desc=拦掉穿山甲开屏广告请求（splash/ 与 vN/(ack/)splash/ 全家族），并清理开屏品牌响应（advert/splash/brand/retrieve）的素材、缓存、预加载与摇一摇/扭一扭配置；不影响激励广告与奖励。
debugLog = switch,false,tag=只读日志,desc=记录福利页分区/任务、广告时长与素材、商业化弹窗、发奖结果；不修改响应。
statusNotify = select,"notification","silent",type=string,tag=自检通知,desc=点击「插件状态自检」后是否弹 Loon 通知：notification 弹通知并可一键跳转 App；silent 只写日志和结果页。结果页始终显示当前开关摘要与冲突提醒。
# <<< GENERATED ARGUMENTS


# ============================================================================
# 1. [Rule] · 传输层（静态，常开）
# ----------------------------------------------------------------------------
# QUIC 强制回退：只对 [MITM] 里这 16 个精确域拒绝 HTTP/3(QUIC)。
# 为什么必须常开：脚本只能看见 TCP+TLS；目标域一旦走 HTTP/3，
# MITM 不生效 → 清洗/拦截脚本“静默看不到流量”，功能像随机失效。
# 为什么不做全局 PROTOCOL,QUIC,REJECT：那会连视频/通话/直播一起打掉。
# 代价：首个连接多一次回退（约 100~300ms）；极少数不回退的实现会连不上该接口。
# 回滚：删掉下面这 16 行，或整段清空（[Rule] 段可留空）。
# Pangle 分片族（ads3/ads5 × 5 个后缀）在 [Rule] 里逐个列出：DOMAIN-SUFFIX
# 不吃通配。对应的 [MITM] 用一条 ads?-normal*.zijieapi.com 覆盖全族——两边
# 严格对齐，才不会出现「解密了但没回退」的空档。分片清单取自 ads.plugin 的
# 公开广告数据（ads3/ads5 × normal/-hl/-lf/-lq/-xh），不是猜的。
# ============================================================================

[Rule]

AND,((DOMAIN-SUFFIX,beta-luna.douyin.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,polaris.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ad.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,lianmengapi.snssdk.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal-hl.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal-hl.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal-lf.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal-lf.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal-lq.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal-lq.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal-xh.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal-xh.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,zlink.ugsdk.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,praisewindow.ugsdk.cn),(PROTOCOL,QUIC)),REJECT


# ============================================================================
# 2. [Rewrite]
# ----------------------------------------------------------------------------
# DSP 广告展示上报：信息流去广告模式下阻断无用出网，回 200 + JSON {}
# （reject_dict）避免 SDK 因空 Body 重试；由 cleanFeedAds 开关控制。
# ============================================================================

[Rewrite]

# ----------------------------------------------------------------------------
# 压缩协商统一成 gzip（常开，无开关）
# 脚本层只有 $utils.ungzip（Build ≥ 988），br / zstd / deflate 没有解码器：
# 收到就是乱码 → 落进「不是 JSON」分支 → 表现为「这个端点本来就没广告」。
# 这是本插件最隐蔽的失效方式，靠事后诊断（X-Soda-Plugin: ce=br）只能定位不能避免。
# 官方层序：Rewrite 在规则匹配前、Script 之前执行，所以这里直接改请求头，
# 服务端不会再回 br——从源头消掉这条路径。
# 条件只留 URL，不写 `${request.header['Accept-Encoding']}`：能命中的域名
# 就是下面 [MITM] 的完整名单，由 lint 逐个域名对账（少一个就报错）。
# 代价：gzip 比 br 大约 10~20%，只作用于这几个 JSON 接口。
# ----------------------------------------------------------------------------
request if ${url} ~= /^https?:\/\/(?:beta-luna\.douyin\.com|polaris\.zijieapi\.com|ad\.zijieapi\.com|lianmengapi\.snssdk\.com|ads[0-9]-normal[a-z0-9-]*\.zijieapi\.com|zlink\.ugsdk\.cn|praisewindow\.ugsdk\.cn)\// then request.header.set("Accept-Encoding", "gzip")

# 开屏品牌上报：回 200 + JSON {}，避免 SDK 重试；由 blockSplashAd 开关控制。
request if ${blockSplashAd} == true && ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/luna\/advert\/splash\/brand\/report/ then reject_dict(200)

# DSP 广告展示上报：信息流去广告模式下阻断无用出网并回 200 + JSON {}；由 cleanFeedAds 开关控制。
request if ${cleanFeedAds} == true && ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/luna\/ads\/report\/dsp\/show/ then reject_dict(200)


# ============================================================================
# 3. [Script]
# ----------------------------------------------------------------------------
# 使用 Loon 3.5.1(983) 新版 Script 语法：
#   response if ${url} ~= /.../ then script("scripts/x.min.js", {${开关名}}) with enable=${开关名}
# 开关以布尔值透传给脚本（$argument.<参数名>）。
# debug=${debugLog} 接的是官方 with 属性：打开「只读日志」时同时打开 Loon 的
#   原生脚本调试输出（命中哪条、耗时、异常），不用再靠 console.log 猜。
# ============================================================================

[Script]

# ---- 福利页精简：只留【攒时长 听歌不中断】 ----
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/luna\/treasure\/task\/page\/v[0-9]+/ then script("scripts/treasure.min.js", {${treasureMinimal}}) with debug=${debugLog}, enable=${treasureMinimal}, requires_body=true, timeout=10, tag="福利页精简：只留【攒时长 听歌不中断】"

# ---- 开屏品牌响应：清素材、缓存、预加载与摇一摇/扭一扭配置 ----
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/luna\/advert\/splash\/brand\/retrieve/ then script("scripts/clean.min.js", {${blockSplashAd}, ${debugLog}}) with debug=${debugLog}, enable=${blockSplashAd}, requires_body=true, timeout=10, tag="开屏品牌响应清理：不影响激励奖励"

# ---- 信息流 / 搜索 / 广告位清理：不影响激励奖励与正常媒体 ----
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/+luna\/(?:ads\/(?:config|retrieve|dsp\/retrieve)|advert\/fallback\/done\/info|(?:v2\/)?feed\/|playlist\/(?:feed\/|detail|related_media|search)|search\/track|search-block|search-categories|media\/(?:assistant\/)?related|video_playlist\/detail|me\/discover|discover\/mix|featured-content\/list|card)/ then script("scripts/clean.min.js", {${cleanFeedAds}, ${debugLog}}) with debug=${debugLog}, enable=${cleanFeedAds}, requires_body=true, timeout=10, tag="信息流 / 搜索 / 广告位清理：不影响激励奖励"

# ---- 断掉激励广告素材与预拉取：等于广告完全不发，奖励也没了 ----
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/+luna\/advert\/incentive\/(?:config|retrieve)/ then script("scripts/clean.min.js", {${killRewardAds}, ${debugLog}}) with debug=${debugLog}, enable=${killRewardAds}, requires_body=true, timeout=10, tag="断掉激励广告素材与预拉取：等于广告完全不发，奖励也没了"

# ---- 商业化弹窗 / 商城清理（只绑 v2：v1 /luna/commerce/upsells 无抓包证据，
#      挂上去只会「路由命中、处理器空转」= 假覆盖；真机抓到 v1 广告实体再补）----
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/+luna\/commerce\/v2\/upsell/ then script("scripts/clean.min.js", {${cleanUpsell}, ${debugLog}}) with debug=${debugLog}, enable=${cleanUpsell}, requires_body=true, timeout=10, tag="商业化弹窗 / 商城清理"

# ---- 演出（汽水音乐节）清理 ----
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/luna\/growth\/music_festival\/performance_details/ then script("scripts/clean.min.js", {${cleanUpsell}, ${debugLog}}) with debug=${debugLog}, enable=${cleanUpsell}, requires_body=true, timeout=10, tag="演出（汽水音乐节）清理"

# ---- 活动入口清理：音乐节（演出）+ 抖音运营活动 ----
#                真机取证（2026-11-05 20:25:48）：`polaris.zijieapi.com` 固定证书
#                26 SNI / 26 Match / 26 次握手失败——这条绑定的宿主已被掐断，
#                当前只算「已注册、固定证书未解除前不生效」，不许写「已清理/已隐藏」。
#                取证表与止损动作见 README 5.4 与 [MITM] 段的「固定证书止损」。
response if ${url} ~= /^https?:\/\/polaris\.zijieapi\.com\/luckycat\/activity\/settings\// then script("scripts/clean.min.js", {${cleanActivity}, ${debugLog}}) with debug=${debugLog}, enable=${cleanActivity}, requires_body=true, timeout=10, tag="活动入口清理（音乐节/抖音运营活动）"

# ---- 广告域名拦截：blockAdDomains 开关 ----
request if ${url} ~= /^https?:\/\/(?:ad\.zijieapi\.com|lianmengapi\.snssdk\.com|ads[0-9]-normal[a-z0-9-]*\.zijieapi\.com|zlink\.ugsdk\.cn|praisewindow\.ugsdk\.cn)\// then script("scripts/block-domains.min.js", {${blockAdDomains}, ${debugLog}}) with debug=${debugLog}, enable=${blockAdDomains}, timeout=10, tag="广告域名拦截：blockAdDomains 开关"

# ---- 开屏广告请求拦截：只拦 ads5-*.zijieapi.com/api/ad/...splash/，不碰激励广告 ----
request if ${url} ~= /^https?:\/\/(?:[a-z0-9.-]+\.)?zijieapi\.com\/api\/ad\/(?:splash\/|v[0-9]+\/(?:ack\/)?splash\/)/ then script("scripts/splash-ad.min.js", {${blockSplashAd}, ${debugLog}}) with debug=${debugLog}, enable=${blockSplashAd}, timeout=10, tag="拦截开屏广告请求"

# ---- 只读日志：福利页 / 激励广告 / 兜底凭证 / 信息流广告 / upsell / 发奖 ----
response if ${url} ~= /^https?:\/\/beta-luna\.douyin\.com\/+luna\/(?:treasure\/task\/page\/v[0-9]+|advert\/incentive\/(?:config|retrieve|done)|advert\/fallback\/done\/info|ads\/(?:config|retrieve|dsp\/retrieve)|commerce\/v2\/upsell)/ then script("scripts/observe.min.js") with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="只读日志：福利页 / 激励广告 / 兜底凭证 / 信息流广告 / upsell / 发奖"

# ---- 只读日志：穿山甲广告平台（广告配置 / 领奖回调 / 开屏广告） ----
response if ${url} ~= /^https?:\/\/(?:[a-z0-9.-]+\.)?zijieapi\.com\/(?:api\/ad\/|api\/incentive\/marketing\/done)/ then script("scripts/observe.min.js") with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="只读日志：广告平台广告配置与领奖回调"
generic then script("scripts/status.min.js", {${statusNotify}, ${treasureMinimal}, ${cleanFeedAds}, ${killRewardAds}, ${cleanUpsell}, ${cleanActivity}, ${blockAdDomains}, ${blockSplashAd}, ${debugLog}}) with debug=${debugLog}, tag="插件状态自检", img_url="checkmark.seal", timeout=10


# ============================================================================
# 4. [MITM]
# ----------------------------------------------------------------------------
# beta-luna.douyin.com：福利页/激励广告/商业化弹窗接口。
# 5 个广告域名：blockAdDomains / blockSplashAd 开关需要（HTTPS 必须先解密）。
#                如果开开关后激励广告播不了，把这 5 个域名注释掉。
# 分层关系：其中 ad.zijieapi.com / lianmengapi.snssdk.com /
#                ads?-normal*.zijieapi.com（Pangle 分片族）同时也被 ads.plugin
#                的 [Host] + DOMAIN-WILDCARD 家族层拦截；本份名单是 App 内
#                MITM 兜底层。这里用 `?`/`*` 而不是逐个枚举 ads3/ads5，
#                是因为 MITM 支持通配，而 [Rule] 的 DOMAIN-SUFFIX 不支持——
#                两边各用自己最强的写法，名单靠 lint 校验覆盖关系。
#                zlink.ugsdk.cn / praisewindow.ugsdk.cn 是 App 内运营端点
#                （口令/弹窗），只由本开关覆盖，不进 ads.plugin。
# 固定证书止损（2026-11-05 20:25:48 真机日志 · iPhone18,4 / iOS 27.2 / Loon 3.5.3(1014)）：
#                下面这几台**客户端拒收了 Loon 证书**，签名统一是
#                `ssl/tls alert certificate unknown`（err 167773206 / 0A000416）：
#                  polaris.zijieapi.com          26 次 SNI / 26 次 Match / 26 次握手失败
#                  zlink.ugsdk.cn                 6 次 SNI /  6 次 Match /  6 次握手失败
#                  ads5-normal-gl2.zijieapi.com   5 次 SNI /  5 次 Match /  5 次握手失败
#                Match 行有两种形态（`host(host)` 与 `IP(host)`），括号里都是 SNI，
#                出现即说明该主机确实进了合并后的 MITM 名单。ads5-normal-gl2 是靠
#                `ads?-normal*.zijieapi.com` 这条通配命中的——顺带证伪了
#                「MITM hostname 不支持通配」这种说法。
#                同窗口只有两台 Apple 主机解密成功（gspe1-ssl / configuration.ls.apple.com，
#                零失败），Loon CA 已被系统信任，所以这不是「用户没装证书」，
#                是 App 侧固定证书。后果要讲清楚：**不是静默不生效，而是这几台主机的
#                连接被我们掐断了**——声明进 [MITM] 之后握手失败即整条请求失败。
#                因此落在它们身上的绑定（本插件的 `polaris.zijieapi.com/luckycat/activity/settings/`
#                响应清理、`blockAdDomains` 请求层里的 ads 分片与 zlink）都是结构性失效，
#                对外只许说「已注册、固定证书未解除前不生效」，不许说「已净化/已拦截」。
#                归属纪律：这三台都在本插件自己声明的 hostname 名单里，本插件是充分原因；
#                但日志里的 Match 来自合并后的名单，主配置有没有重复声明无法从日志区分
#                （判读纪律见 docs/device-checklist.md「别把主配置记在插件头上」）。
#                反过来也别读多：本窗口 beta-luna.douyin.com / ad.zijieapi.com /
#                lianmengapi.snssdk.com / praisewindow.ugsdk.cn 零流量，
#                「日志里没有」既不能当成「已生效」，也不能当成「被固定」。
#                止损动作（默认不执行，要就手动）：把这些主机从上面 hostname 行删掉，
#                对应 [Rule] 的 QUIC 回退行与 [Script] 里只命中它们的绑定一起注释——
#                删掉之后连接恢复正常，只是这些端点重新变成黑盒。
# h2 = true（常开）：未文档化键，社区通行写法。官方 MitM 文档只列三个键，
#                HTTP/2 解密本就是默认能力，这里保留纯属零成本保险（未知键被忽略）。
#                若某个 build 把它当非法键导致断网，删掉这一行即可回滚。
# 脚本来源：block-domains.min.js / splash-ad.min.js 由 src/common/*.js +
#                families.json 生成，与 soda 插件共享单一源码。
# ============================================================================

[MITM]

hostname = %APPEND% beta-luna.douyin.com, polaris.zijieapi.com, ad.zijieapi.com, lianmengapi.snssdk.com, ads?-normal*.zijieapi.com, zlink.ugsdk.cn, praisewindow.ugsdk.cn
h2 = true
