# ========================================================================
# 提醒脚本层 · cron 本地通知（零 MITM · 零证书 · 不监听/不改写/不请求流量）
# ------------------------------------------------------------------------
# 本插件拦截面全部走 [Host]/[Rule]；[Script] 只允许 cron 类型：Loon 定时器每天
# 本地触发一次，脚本只发一条 $notification，点通知按 openUrl 直达 App 内路由。
# 明确不做：不代打卡、不代领取——签到/领取端点全部要求 App 进程内 encryptSign
# 侧的请求签名（见上方红线注释），脚本层不存在该签名输入（伪造领取=IVT）。
# 脚本源 src/qidian/<name>.js（可读）→ 部署件 plugins/qidian/scripts/<name>.min.js
# （node tools/build.js 压缩）；改时间/文案改 src/apps 的 crons 后重新生成。

[Script]

# sign-reminder: 每天 09:00 发一条本地通知，点通知直达签到页 QDReader://usercenter/sign，人手在 App 内完成签到。不代签——/argus/api/v1/checkin/* 全部要求 App 进程内 encryptSign 签名；会员可直接开启 App 自带「会员自动签到」。深链路由以真机验证为准，若未直达改用 QDReader://app/openSignIn。
cron 0 9 * * * then script("scripts/sign-reminder.min.js") with timeout=60, tag="每日签到提醒"

# welfare-reminder: 每天 21:00 提醒任务/福利中心 QDReader://usercenter/task：真实阅读/观看之后人手领取；领取层(/pickup/risk)按服务端账本校验，插件不碰。
cron 0 21 * * * then script("scripts/welfare-reminder.min.js") with timeout=60, tag="每日任务提醒"


# ========================================================================
# 可选 MITM 增强层（下面整段默认注释；不装证书 = 永不生效）
# ------------------------------------------------------------------------
# 起点读书 iOS 未做证书固定：开屏/书架广告位与章节内容同主机 magev6.if.qidian.com，[Host] 黑洞会废掉 App，正解是 MITM 后按路径拦。下列规则来自 app2smile / blackmatrix7 / fmz200 三家公开模块（源里的 reject-200 对应 Loon 的 REJECT-DICT：200 + {} JSON），默认整段注释、装证书后按需启用。refresh（我的界面内测推广）与 getTopOperation（书架置顶推广）两条源注释明写『推广』；源里的 argus/api/v1/adv 宽前缀与 followsubscribe 同组写着『投票、章末免费领取章节卡』——那是功能不是广告，刻意不收。
# 启用步骤：①Loon 里装并信任证书 →
#           ②取消 [MITM] 头与其 hostname 行的注释 →
#           ③取消 [Rule] 头及需要的 QUIC 回退 / URL-REGEX 行。
# 只对未做证书固定的 App 有效；银行/微信/米家这类做了证书固定，
# MITM 直接失败甚至触发风控——那些插件不提供本层（红线）。
# 本层每一条正则都来自公开可引用规则源，见下方证据；不凭空造路径。
# 证据: https://github.com/app2smile/rules/blob/master/plugin/qidian.plugin
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AllInOne/AllInOne.plugin
# 证据: https://github.com/fmz200/wool_scripts/blob/main/Surge/module/blockAds.module
# ========================================================================

# [MITM]
# ------------------------------------------------------------
# hostname 只列本 App 广告相关的具体接口域，不列整主域；一行取消注释即全部解密。
# hostname = %APPEND% magev6.if.qidian.com, mage.if.qidian.com
#
# [Rule]
# ------------------------------------------------------------
# 下列规则必须放在 [Rule] 段：取消本行（# [Rule]）与所需规则行的注释才生效。
# QUIC 回退（与 MITM 配套）：MITM 只解密 TCP，App 走 HTTP/3 时下面的
# URL-REGEX 会静默失效。
# 取消这些行让对应域的 QUIC 直接拒绝、回落 TCP。
# AND,((DOMAIN-SUFFIX,magev6.if.qidian.com),(PROTOCOL,QUIC)),REJECT
# AND,((DOMAIN-SUFFIX,mage.if.qidian.com),(PROTOCOL,QUIC)),REJECT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/client/getsplashscreen,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/adv/getadvlistbatch,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/bookshelf/getHoverAdv,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/bookshelf/getad,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/bookshelf/refresh,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/bookshelf/getTopOperation,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/client/iosad,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/dailyrecommend/getdailyrecommend,REJECT-DICT
