#!name=起点读书 · 看书激励助手
#!desc=起点读书看书激励助手 v4.0.0:核心看书+激励。MITM 响应净化(getconf/开屏/发现页/书架/福利中心/账户页/每日导读/广告列表/阅读积分/弹窗红点/新手引导/章末/青少年)+ 自动化(签到/抽奖/激励任务重放/自动领奖)+ 广告SDK秒播。debugLog 开关控制日志注入。前置:需 MITM 证书(magev6.if.qidian.com+h5.if.qidian.com)。
#!author=edy
#!version=4.0.0
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/qidian/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/d4/0e/59/d40e5977-557a-bb3b-6d33-9011a4b3c820/AppIcon-0-0-1x_U007epad-0-1-0-0-sRGB-GLES2_U002c0-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-05
#!tag=看书,激励,起点读书,阅文,纯净阅读,自动签到,激励任务,自动领奖,响应净化
#!type=normal

# ========================================================================
# 起点读书 · 看书激励助手 v4.0.0
# ------------------------------------------------------------------------
# v4.0.0 重大变更:MITM 增强层从「默认注释」改为「默认启用」。
# 原因:用户反馈 v3.1.0 及之前版本的广告/激励/签到/我的页净化全部不生效,
# 根因是整个 MITM 层注释 → auto-task.js 从不执行。
#
# 前置条件:
#   1. Loon 安装并信任 MITM 证书
#   2. 每天至少打开一次起点 App 刷新 Token(getlogininfo 捕获)
#
# 红线(绝不拦截):
#   magev6.if.qidian.com / mage.if.qidian.com(正文/书架/章节 API)
#   druid.if.qidian.com(章节目录) / h5.if.qidian.com(H5 容器)
#   cococdn.qidian.com / bookcover.yuewen.com / *.qidianalipay.com
#   fockrt.yuewen.com(阅文加密/签名基础设施)
#
# 致谢:3kaiu 起点全能助手 Pro 的方案。
# ========================================================================

[Argument]
debugLog = switch,false,tag=调试日志,desc=开启后记录所有净化/自动化操作的详细日志;默认关闭。

# ========================================================================
# L2 域名层:[Host] 黑洞(零证书,纯 DNS 拦截)
# ========================================================================

[Rule]

# ------------------------------------------------------------
# QUIC 回退(MITM 配套):MITM 只解密 TCP,App 走 HTTP/3 时脚本静默失效
# ------------------------------------------------------------
AND,((DOMAIN-SUFFIX,magev6.if.qidian.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,mage.if.qidian.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,h5.if.qidian.com),(PROTOCOL,QUIC)),REJECT

# ------------------------------------------------------------
# 起点/阅文自有广告与统计端点(置信 A)
# ------------------------------------------------------------
DOMAIN-SUFFIX,adsite.yuewen.com,REJECT

# ------------------------------------------------------------
# 阅读热源·腾讯侧纯上报域(置信 A)
# ------------------------------------------------------------
DOMAIN-SUFFIX,bugly.qq.com,REJECT
DOMAIN-SUFFIX,bugly.tencent.com,REJECT

[Host]

