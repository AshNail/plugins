# ========================================================================
# L4+L5 MITM 增强层(默认启用,需证书)
# ------------------------------------------------------------------------
# v4.0.0 变更:从「默认注释」改为「默认启用」。
# 起点读书 iOS 未做证书固定,MITM 可行。
# [Script] 绑定 auto-task.js 处理所有响应净化 + 自动化。
# ========================================================================

[MITM]

hostname = %APPEND% magev6.if.qidian.com, mage.if.qidian.com, h5.if.qidian.com

[Script]

# ---- Token 捕获(response 阶段:getlogininfo 返回完整用户凭据) ----
http-response ^https://h5\.if\.qidian\.com/argus/api/v1/user/getlogininfo script-path=scripts/auto-task.min.js, requires-body=true, timeout=10, tag=起点Token捕获

# ---- Token 捕获(request 阶段:getconf/checkin 请求携带 auth headers) ----
http-request ^https://(h5|magev6)\.if\.qidian\.com/argus/api/v[0-9]/(client/getconf|checkin/) script-path=scripts/auto-task.min.js, requires-body=false, timeout=10, tag=起点Token捕获(补充)

# ---- getconf 响应净化(30 项覆写 + 10 项删除) ----
http-response ^https://(h5|magev6)\.if\.qidian\.com/argus/api/v1/client/getconf script-path=scripts/auto-task.min.js, requires-body=true, timeout=10, tag=起点getconf净化

# ---- finishWatch 重放(激励任务自动化核心) ----
http-request ^https://(h5|magev6)\.if\.qidian\.com/argus/api/v[0-9]+/video/adv/finishWatch script-path=scripts/auto-task.min.js, requires-body=true, timeout=120, tag=起点激励任务重放

# ---- receiveTaskReward 拦截(自动领奖) ----
http-request ^https://(h5|magev6)\.if\.qidian\.com/argus/api/v[0-9]+/video/adv/receiveTaskReward script-path=scripts/auto-task.min.js, requires-body=true, timeout=10, tag=起点自动领奖

# ---- 广告 SDK 秒播(视频时长 patch 成 1 秒) ----
# 注意:Loon 对复杂正则支持有限,简化为两个独立绑定
http-response ^https://(h5|magev6)\.if\.qidian\.com/argus/api/v[0-9]+/video/adv/gdt_inner_view script-path=scripts/auto-task.min.js, requires-body=true, timeout=10, tag=起点广告SDK秒播(gdt_inner_view)
http-response ^https://(h5|magev6)\.if\.qidian\.com/argus/api/v[0-9]+/video/adv/get_ads script-path=scripts/auto-task.min.js, requires-body=true, timeout=10, tag=起点广告SDK秒播(get_ads)

# ---- 全局深度净化(22 个端点族) ----
http-response ^https://(h5|magev6)\.if\.qidian\.com/argus/api/(v[0-9]+/video/adv/mainPage(?!Dialog)|v[0-9]+/video/adv/mainPageDialog|v[0-9]+/video/adv/reportDialog|v[0-9]+/adv/getadvlistbatch|v[0-9]+/deeplink/geturl|v[0-9]+/dailyrecommend|v[0-9]+/checkin/(lottery|checkinexchangepage)|v[0-9]+/user/getsimplediscover|v[0-9]+/bookshelf/(getHoverAdv|getTopOperation|getad)|v[0-9]+/client/iosad|v[0-9]+/push/getdialog|v[0-9]+/maintain/playstrip|v[0-9]+/young/getconf|v[0-9]+/freshman/(bookshelfbtn|freshmanGuidePopup)|v[0-9]+/message/(pullOperationPush|pullSocialPush)|v[0-9]+/followsubscribe/showChapterEndModule|v[0-9]+/client/getsplashscreen|v[0-9]+/reddot/getdot|v[0-9]+/popup/batchget|v[0-9]+/ploy/getactivitylist|v[0-9]+/interaction/getclassicbookinfo|v[0-9]+/readtime/readpage|v[0-9]+/user/getaccountpage) script-path=scripts/auto-task.min.js, requires-body=true, timeout=10, tag=起点深度净化

# ---- 自动签到(cron 每天凌晨 2 点) ----
cron "11 2 * * *" script-path=scripts/auto-task.min.js, timeout=420, tag=起点自动签到

# ---- 手动签到/自检入口 ----
generic script-path=scripts/auto-task.min.js, timeout=420, tag=起点手动签到/自检
