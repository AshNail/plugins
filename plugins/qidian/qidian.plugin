# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 这些主机的 TLS 会被客户端掐断，起点内容加载会失败——
# 这是「净化要看响应体」的代价，用户裁决于 v3.2.0（v4.0.0 曾手工开在生成物上，
# 被一次 build:apps 覆盖回注释态，于是整个净化层真机上静默零执行）。
# URL-REGEX 路径级黑洞仍在文末保持注释：magev6/mage/h5.if 是本 App 的红线主机，
# 解密不等于拦截。
# ========================================================================

[MITM]

hostname = %APPEND% magev6.if.qidian.com, mage.if.qidian.com, h5.if.qidian.com

# ========================================================================
# 脚本层（绑定行由 enhance.bindings 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 同名脚本 auto-task.min.js 按 URL 分流：捕获 / 净化 / 秒播 / 重放 / 领奖。
# 源码 src/<slug>/auto-task.js（可读）→ plugins/<slug>/scripts/auto-task.min.js。
# ========================================================================

[Script]

# capture-logininfo: getlogininfo 返回完整用户凭据，autoTask 打开时才缓存到 $persistentStore(Qidian_Headers)
response if ${url} ~= /^https:\/\/h5\.if\.qidian\.com\/argus\/api\/v1\/user\/getlogininfo/ then script("scripts/auto-task.min.js", {${debugLog}, ${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="起点Token捕获"

# capture-conf-checkin: getconf/checkin 请求自带 auth headers，作为 getlogininfo 的补充捕获口
request if ${url} ~= /^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/v[0-9]\/(client\/getconf|checkin\/)/ then script("scripts/auto-task.min.js", {${debugLog}, ${autoTask}}) with debug=${debugLog}, enable=${autoTask}, timeout=10, tag="起点Token捕获(补充)"

# getconf-clean: getconf 30 项字段覆写（关广告/追踪/弹窗）+ 10 项字段删除（悬浮广告/活动图标/推广模块）
response if ${url} ~= /^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/v1\/client\/getconf/ then script("scripts/auto-task.min.js", {${debugLog}, ${cleanAds}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="起点getconf净化"

# finishwatch-replay: 按 body 里的 taskId 重放 finishWatch（激励视频 9 次 / 福利任务 3 次，递增 2s 间隔）——代打卡性质，默认关
request if ${url} ~= /^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/v[0-9]+\/video\/adv\/finishWatch/ then script("scripts/auto-task.min.js", {${debugLog}, ${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=120, tag="起点激励任务重放"

# receive-reward: 缓存 receiveTaskReward 请求，再由脚本重放到 6 个领奖端点——代领取性质，默认关
request if ${url} ~= /^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/v[0-9]+\/video\/adv\/receiveTaskReward/ then script("scripts/auto-task.min.js", {${debugLog}, ${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="起点自动领奖"

# adsec-gdt-inner-view: 把广告时长字段 patch 成 1 秒 + 1 秒黑屏素材——伪造观看完成，归 autoTask 且默认关，不挂净化开关
response if ${url} ~= /^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/v[0-9]+\/video\/adv\/gdt_inner_view/ then script("scripts/auto-task.min.js", {${debugLog}, ${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="起点广告SDK秒播(gdt_inner_view)"

# adsec-get-ads: 同上：时长 patch 属激励完成伪造，不随 cleanAds 默认生效
response if ${url} ~= /^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/v[0-9]+\/video\/adv\/get_ads/ then script("scripts/auto-task.min.js", {${debugLog}, ${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="起点广告SDK秒播(get_ads)"

# deep-clean: 22 个端点族的响应体净化：广告列表/开屏/弹窗/红点/新手引导/章末/青少年/发现页/书架/福利中心/账户页/每日导读
response if ${url} ~= /^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/(v[0-9]+\/video\/adv\/mainPage(?!Dialog)|v[0-9]+\/video\/adv\/mainPageDialog|v[0-9]+\/video\/adv\/reportDialog|v[0-9]+\/adv\/getadvlistbatch|v[0-9]+\/deeplink\/geturl|v[0-9]+\/dailyrecommend|v[0-9]+\/checkin\/(lottery|checkinexchangepage)|v[0-9]+\/user\/getsimplediscover|v[0-9]+\/bookshelf\/(getHoverAdv|getTopOperation|getad)|v[0-9]+\/client\/iosad|v[0-9]+\/push\/getdialog|v[0-9]+\/maintain\/playstrip|v[0-9]+\/young\/getconf|v[0-9]+\/freshman\/(bookshelfbtn|freshmanGuidePopup)|v[0-9]+\/message\/(pullOperationPush|pullSocialPush)|v[0-9]+\/followsubscribe\/showChapterEndModule|v[0-9]+\/client\/getsplashscreen|v[0-9]+\/reddot\/getdot|v[0-9]+\/popup\/batchget|v[0-9]+\/ploy\/getactivitylist|v[0-9]+\/interaction\/getclassicbookinfo|v[0-9]+\/readtime\/readpage|v[0-9]+\/user\/getaccountpage)/ then script("scripts/auto-task.min.js", {${debugLog}, ${cleanAds}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="起点深度净化"

# cron-sign-in: 每天 02:11 复用缓存 headers POST /argus/api/v2/checkin/checkin + /checkin/checkinlottery 抽奖；Token 过期即失败
cron "11 2 * * *" then script("scripts/auto-task.min.js", {${debugLog}, ${autoTask}}) with debug=${debugLog}, enable=${autoTask}, timeout=420, tag="起点自动签到"

# manual-check: 插件面板手动按钮：自检净化/自动化状态，autoTask 打开时顺带手动签到一次
generic then script("scripts/auto-task.min.js", {${debugLog}, ${cleanAds}, ${autoTask}}) with debug=${debugLog}, tag="起点手动签到/自检", img_url="checkmark.seal", timeout=420


# ========================================================================
# 仍然注释的路径级黑洞（本 App 的 MITM/脚本层已默认启用，这一批按需再开）
# ------------------------------------------------------------------------
# 起点读书 iOS 未做证书固定：开屏/书架广告位、听书/漫画/短剧 API 与章节内容同主机 magev6.if.qidian.com，[Host] 黑洞会废掉 App，正解是 MITM 后按路径拦。广告路径规则来自 app2smile / blackmatrix7 / fmz200 三家公开模块;听书/漫画/短剧路径规则来自 REA 5.9.482 二进制字面 URL 全量扫描(/argus/api/v1/audio/* 30+ 端点、/argus/api/Comic/* 15+ 端点、/argus/api/v1/circle/getBookMyPiaVideoList)。源里的 reject-200 对应 Loon 的 REJECT-DICT：200 + {} JSON。本 App 走的是「净化要靠脚本读响应体」的路子，所以 [MITM]+[Script]+[Argument] 三层默认启用（autoTask 类自动化默认关）；而 URL-REGEX 那批路径级黑洞仍按仓库纪律保持注释态—— magev6/mage/h5.if 是本 App 自己登记的红线，解密不等于拦截。
# 启用步骤：①确认 Loon 已装并信任证书（本层已默认解密） →
#           ②把需要的 URL-REGEX 行取消注释并移进上方生效的 [Rule] 段。
# 只对未做证书固定的 App 有效；银行/微信/米家这类做了证书固定，
# MITM 直接失败甚至触发风控——那些插件不提供本层（红线）。
# 本层每一条正则都来自公开可引用规则源，见下方证据；不凭空造路径。
# 证据: https://github.com/app2smile/rules/blob/master/plugin/qidian.plugin
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AllInOne/AllInOne.plugin
# 证据: https://github.com/fmz200/wool_scripts/blob/main/Surge/module/blockAds.module
# ========================================================================

#
# （路径规则请移进文件上方已生效的 [Rule] 段）
# ------------------------------------------------------------
# 这些规则命中即黑洞本 App 自己登记的红线主机，默认保持注释、按需自行启用。
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/client/getsplashscreen,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/adv/getadvlistbatch,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/bookshelf/getHoverAdv,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/bookshelf/getad,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/bookshelf/refresh,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/bookshelf/getTopOperation,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/client/iosad,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/dailyrecommend/getdailyrecommend,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/audio/,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/Comic/,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/circle/getBookMyPiaVideoList,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/adv/getadvlist,REJECT-DICT
# URL-REGEX,^https?://magev?6?\.if\.qidian\.com/argus/api/v[0-9]/booksquare/getfloatcard,REJECT-DICT
