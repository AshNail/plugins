# adv/getadvlistbatch 路径证据:Yu9191 Rewrite 以 reject-200 拦此路径;app2smile/blackmatrix7/fmz200 三源同族路径规则——起点 iOS 未做证书固定。v4.0.0 按 config 口径不再整段拒绝 v1/adv/（会连带清掉 getadvlistbatch 的非广告字段），改为只清 Data.iOS_tab（adv-tab 复写）；CAPTURE_ENABLE=false 时由深度净化的 adv/getadvlistbatch 分支处理。
# 本插件 [Rule] 全设备生效(Loon 无法按 App 限定):精确域 REJECT 是全局的,AND 复合里的 DOMAIN-KEYWORD 只在 QDReader UA 下命中。'按 App 插件'只是分组开关;v4.0.0 起不再有 [Host] 黑洞层,红线主机只解密不拦截。
# 热源层(v1.3.1):QDReader 5.9.482 二进制考古结论——看小说发热主链是 App 内行为,Loon 只能斩高频上报连接;App 内行为靠设置关闭。
# v2.1.0 非阅读功能阻断层:REA 5.9.482 全量逆向(7508 QD 类+2897 文件清单+Mach-O 依赖+Flutter AssetManifest)——听书/TTS 715 类(QDAudio*/QDTTS*/QDDub*)走独立域名 tts.yuewen.com/tts-qidian.xf-yun.com/tingbook.com/webnovel TTS 族+Argus /argus/api/v1/audio/* 30+ 端点;漫画(QDComic*/QDManga*)走 manhua.pic.cn+/argus/api/Comic/* 15+ 端点;短剧 PiaDrama(QDPiaDramaPlay*)走 /argus/api/v1/circle/getBookMyPiaVideoList;直播(QDAnchor*)走 Anchor 相关端点。全部非阅读域与正文 API(magev6/druid/h5/cococdn/bookcover)零共域——整族黑洞不伤正文;Argus 路径层走 MITM URL-REGEX 精确裁切,同主机正文/书架/章节/充值请求零影响。fockrt.yuewen.com=com.yuewen.fockrt.files 阅文 fock 加密/签名文件服务已登红线绝不拦。v2.1.0 真机日志追加:gatherer.m.qq.com/apmplus.volces.com/noahqd.yuewen.com+游戏中心 game-img/gameapp-1252317822.file.myqcloud.com 双桶+Argus /adv/getadvlist 与 /booksquare/getfloatcard 路径级拦截。
# 自动化层(v2.1.0):Token 窃取自 App 正常请求(getlogininfo 返回完整用户凭据,getconf/checkin 请求携带 auth headers),存入 $persistentStore(Qidian_Headers)。签到走 /argus/api/v2/checkin/checkin(POST,空 body,复用捕获 headers),该端点不需要 encryptSign(与 /checkin/autocheckin 不同路径),服务端按 Cookie 鉴权。签到后自动调 /checkin/checkinlottery 抽奖。finishWatch 重放:App 每完成 1 次广告观看 POST /argus/api/v{N}/video/adv/finishWatch,脚本拦截后识别 body 中 taskId(TaskMapping:激励视频 1218712929269776384×9,福利任务 1218712929269776388×3),重放 count-1 次(递增 2s 间隔),使用原始 headers+body。致谢:3kaiu 起点全能助手 Pro 的 finishWatch 重放机制与 Token 窃取方案。
# 自动化层(v2.2.0):新增自动领奖功能。receiveTaskReward:POST /argus/api/v1/video/adv/receiveTaskReward(视频任务领奖,日志实锤 body ~26-298 bytes,不需要 encryptSign)。脚本拦截该请求并保存,后续 cron 自动重放。同时尝试 6 个领奖端点:/argus/api/v1/video/adv/receiveTaskReward、/argus/api/v3/freshman/autoreceive、/argus/api/v1/ontimeredpacket/receivetaskrpaward、/argus/api/v1/ploy/receiverewardsatisfy、/argus/api/v1/dialog/receivetask、/argus/api/v1/dialog/takereward。这些端点均不需要 encryptSign,服务端按 Cookie 鉴权。
# 响应净化层(v3.0.0):整合 3kaiu 方案的全部响应净化功能。getconf 净化:30 项字段覆写(关广告/追踪/弹窗) + 10 项字段删除(悬浮广告/活动图标/推广模块)。开屏广告:清空 getsplashscreen 返回的 List。发现页:白名单过滤(保留书单/专栏/IP 专区)。书架:悬浮广告 ItemList 清空、置顶运营位 getTopOperation 清空。福利中心:mainPage 净化(删除 MemberExclusiveTaskModule/PrivilegedTaskModule/MoreRewardTab/SurpriseBenefit/LastRewardItems/IndexBannerTabs/BaizeModule/TaskShowData/UserRewardModule/PopFrequency)、mainPageDialog Data 清空。账户页:删除 BenefitButtonList 营销模块。每日导读:dailyrecommend Items 清空。广告列表:getadvlistbatch 批量清空(白名单除外)。阅读积分:readpage TodayReadTime 改满值(7200 秒) + TaskList 全部标记完成(Status=2)。弹窗/红点:popup/batchget、reddot/getdot Data 清空。新手引导:freshman 系列(bookshelfbtn/freshmanGuidePopup)清空。章末模块:showChapterEndModule 清空。青少年配置:young/getconf 清空。广告SDK秒播:视频时长字段(video_duration/video_timelife/duration/play_time/total_time/show_time/max_time)patch 成 1 秒 + 1 秒黑屏 MP4 替换。
# 本文件由 tools/build-apps.py 从 src/apps/qidian.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开。自动化类的默认值是显式源内裁决（v3.6.0 起 QDREADER_* 六开关默认# 开——用户裁决接受服务端风控后果）；每个开关都仍可单独关掉切面停用。
# ========================================================================

[Argument]

CAPTURE_ENABLE = switch,true,tag=是否开启抓取重写,desc=是否开启抓取重写（[Rewrite] 接管广告净化）。关掉它广告改由 [Script] 接管，但不影响 Cookie 捕获——见 QDREADER_COOKIE_ENABLE
QDREADER_COOKIE_ENABLE = switch,true,tag=是否捕获Cookie,desc=是否捕获起点读书 Cookie（签到/自动兑换章节卡/福利签到的唯一数据源）。2026-09-30 从 CAPTURE_ENABLE 解耦：原先 Cookie 捕获挂在 CAPTURE_ENABLE 上，而该开关同时决定 [Rewrite]/[Script] 互斥，于是关掉抓包重写让脚本接管广告必然连带签到全废——现已拆开
CRONEXP = input,"11 2 * * *",tag=CRONEXP,desc=默认每天2点11分执行，建议自行配置。
QDREADER_DEBUG = switch,false,tag=是否开启调试模式,desc=是否开启调试模式
TIMEOUT = input,420,type=number,tag=脚本执行超时时间,desc=TIMEOUT（默认420秒，高阶任务全量需3-4分钟）
QDREADER_ADV_JOB_ENABLE = switch,true,tag=激励任务,desc=开启后执行激励碎片任务
QDREADER_EXTRA_ADV_JOB_ENABLE = switch,true,tag=每日任务,desc=开启后执行每日广告任务
QDREADER_LOTTERY_ENABLE = switch,true,tag=每日抽奖,desc=开启后执行每日抽奖
QDREADER_WEEKLY_EXCHANGE_ENABLE = switch,true,tag=每周兑换,desc=开启后周日自动兑换章节卡
QDREADER_CHAPTER_CARD_ENABLE = switch,true,tag=章节卡片,desc=开启后查询章节卡信息
QDREADER_MESSAGE_BOX_ENABLE = switch,true,tag=大咖荐书,desc=开启后处理大咖荐书消息

[Rule]

# ------------------------------------------------------------
# config 插件 [Rule] 层（逐行移植）（置信 A）
# 上游 Plugin/qidian.plugin 的 [Rule] 原文：1 条 pangolin-sdk-toutiao1.com 白名单（保护激励/每日任务奖励包）+ 10 条追踪/监控/埋点精确域 REJECT + 3 条限定 QDReader UA 的字节系 SDK 关键词拦截（pglstatp-toutiao / zijieapi / bytescm）。本仓不再保留旧的 first_party/audio_tts/comic_manga/drama_video/game_center/heat_reporting/telemetry 分组——那些是自研扩展，不属于 config 移植面。
# 证据: https://github.com/3kaiu/config/blob/main/Plugin/qidian.plugin
DOMAIN-SUFFIX, pangolin-sdk-toutiao1.com, DIRECT
DOMAIN, publiclog.zhiyan.tencent-cloud.net, REJECT
DOMAIN, zhiyan.monitor.tencent-cloud.net, REJECT
DOMAIN, galileotelemetry.tencent.com, REJECT
DOMAIN, gatherer.m.qq.com, REJECT
DOMAIN, dl.tiku.qq.com, REJECT
DOMAIN, apmplus.volces.com, REJECT
DOMAIN, mssdk.volces.com, REJECT
DOMAIN, tobapplog.ctobsnssdk.com, REJECT
AND,((USER-AGENT,QDReader*),(DOMAIN-KEYWORD,pglstatp-toutiao)),REJECT
AND,((USER-AGENT,QDReader*),(DOMAIN-KEYWORD,zijieapi)),REJECT
AND,((USER-AGENT,QDReader*),(DOMAIN-KEYWORD,bytescm)),REJECT
DOMAIN, noahqd.yuewen.com, REJECT
DOMAIN, ali-stats.jpush.cn, REJECT


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = %APPEND% h5.if.qidian.com, magev6.if.qidian.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：response 阶段 reject_* 在回包后就地返回
# 合法空载荷，response.json.* 由引擎底层自动完成 gzip/br 解压与字段级改写
# （不依赖脚本层 $utils.ungzip）；请求照常出网，保留上游验证过的交付语义。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 传输层：强制明文（v3.5.7 恢复，v4.0.0 移植时丢失）
# ------------------------------------------------------------
# force-identity: 强制上游返回明文，脚本收到字符串即可正常处理。没有这条规则时，上游返回 gzip 压缩响应，Loon 把 gzip 字节按 UTF-8 硬解成字符串交脚本，高位字节变成 U+FFFD，JSON.parse 失败→净化静默零生效（来源 v3.5.7 · v4.1.1 恢复）
request if ${url} ~= /https:\/\/(h5|magev6)\.if\.qidian\.com\// then request.header.set("Accept-Encoding", "identity")

# ------------------------------------------------------------
# 客户端配置净化（response 阶段）：与 config 逐项对齐
# ------------------------------------------------------------
# getconf-overrides: config ClientConfigOverrides 全 29 项一次改齐（DailyRecommendGray 于 v4.0.3 移出以恢复每日导读）（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/client\/getconf(\?.*)?$/ then response.json.replace(["Data.PangleEnable", "Data.DisableQidianBurryReport", "Data.DisableNewabInBI", "Data.SplashScreenInterval", "Data.SplashScreenRoundCount", "Data.BusinessSplashCoolDownTime", "Data.PushDialogFrequency", "Data.EnableMonitorLog", "Data.EnableBeaconFullBurry", "Data.ReloadExposureEnabled", "Data.QDABRegularReportTimeSpan", "Data.QDABReportMinThreshold", "Data.RankBuryPoint", "Data.CheckInPushSwitchReport", "Data.WolfEye", "Data.MainTabActivityRunning", "Data.DailyReadRecReasonSwitch", "Data.EnableShareChapterPloy", "Data.EnableChapterAdvanceGuide", "Data.AddBookShelfNoticeFrequency", "Data.BookShelfPushNoticeFrequency", "Data.UGCPushNoticeFrequency", "Data.NotificationPageBackPushNoticeFrequency", "Data.ActivityPageBackPushNoticeFrequency", "Data.InAppPushLimitMinutes", "Data.PushNoticeFrequency", "Data.AegisSignOn", "Data.EnableFockRetryStrategy", "Data.EnableSearchUser"], ["0", "1", "1", "0", "0", "99999", "0", "0", "0", "false", "999999", "999999", "0", "0", 0, 0, 0, 0, 0, "999999", "999999", "999999", "999999", "999999", "999999", "-1", 0, 0, "1"])

# getconf-delete: config DeleteKeys 全 10 项 + GDT 追踪模块（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/client\/getconf(\?.*)?$/ then response.json.delete(["Data.ActivityIcon", "Data.ActivityPopup", "Data.LuckBag", "Data.BookShelfBottomIcons", "Data.ClassicBookInfo", "Data.ClientLocalNotify2", "Data.PushDialogScenes", "Data.RewardSatisfyDialog", "Data.FansClubPropInfo", "Data.AdVideoPositionConfig", "Data.GDT"])

# getconf-discover-teen: 关闭发现 tab + 青少年弹窗频次（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/client\/getconf(\?.*)?$/ then response.json.replace(["Data.NewFeedsDiscover", "Data.CloudSetting.TeenShowFreq"], [0, "0"])

# ------------------------------------------------------------
# 字段级净化（response 阶段 delete 型，v4.1.0）：纯广告/营销端点
# ------------------------------------------------------------
# kill-splash: 开屏广告轮播清空（v4.0.3 改 delete 型：reject_dict(response) 本机无效；server 当前 List=[] 本行为兜底）（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v4\/client\/getsplashscreen(\?.*)?$/ then response.json.delete(["Data.List"])

# kill-bookshelfbtn: 新手引导书架按钮配置整条删除（v4.0.3 改 delete 型：reject_dict(response) 本机无效）（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/freshman\/bookshelfbtn(\?.*)?$/ then response.json.delete(["Data"])

# kill-topoperation: 书架红框整块删除：MainInfo=「必看神作/最低折扣」大横幅（AdvId AD20261013-07-iOS）+ Items×3 右侧小图标（含游戏手柄，AdvId AD20261013-09-iOS）。v4.1.1 回退为删 Data.Items+Data.MainInfo（不删整个 Data）——v4.1.0 删整个 Data 导致响应只剩 {Message,Result}，App 拿不到 Data 对象直接渲染崩溃→书架 Tab 白屏（来源 config Plugin/qidian.plugin · v4.1.1 修复）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/bookshelf\/getTopOperation(\?.*)?$/ then response.json.delete(["Data.Items", "Data.MainInfo"])

# kill-popup: 弹窗队列整条杀（v4.0.3 改 delete 型：原 `\?` 锚死于真机无 query 从未命中）（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/popup\/batchget(\?.*)?$/ then response.json.delete(["Data"])

# kill-classicbook: 章末经典书目运营位 Items 清空（v4.0.3 改 delete 型：原 `\?` 锚死于真机无 query 从未命中）（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/interaction\/getclassicbookinfo(\?.*)?$/ then response.json.delete(["Data.Items"])

# kill-getad: 书架游戏入口 GameUrl(gameCenterMainPage)+Show 广告位整条杀——用户红框手柄图标（v4.0.3 改 delete 型：原 `\?` 锚死于真机无 query 从未命中）（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/bookshelf\/getad(\?.*)?$/ then response.json.delete(["Data"])

# ------------------------------------------------------------
# 字段级净化（response 阶段）：混业务端点只删字段，保留接口结构
# ------------------------------------------------------------
# clean-reddot: 红点 Data 清空（CLEAN_RULES）（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/reddot\/getdot(\?.*)?$/ then response.json.delete(["Data"])

# clean-accountpage: 我的页红框清除：起点会员卡 / 13 项功能宫格 / 「帮助与客服·加入我们」/ 福利按钮列表。v4.1.1 回退 v4.1.0 新增的 9 个字段（SchoolText/DianNiang*/PursueBookCard/ActiveActionUrl/FreshManGuideSwitch）——删除这些字段导致 App 渲染崩溃→我的页白屏（来源 config Plugin/qidian.plugin · v4.1.1 修复）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/user\/getaccountpage(\?.*)?$/ then response.json.delete(["Data.BenefitButtonList", "Data.Member", "Data.FunctionButtonList", "Data.BottomButtonList"])

# ------------------------------------------------------------
# 字段改值与数组置空（response 阶段）：保留接口结构
# ------------------------------------------------------------
# deeplink-url: 冷启动强制跳转精选页：ActionUrl 置空（来源 config Plugin/qidian.plugin）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/deeplink\/geturl(\?.*)?$/ then response.json.replace(["Data.ActionUrl", ""])

# ------------------------------------------------------------
# 整条 kill（response 阶段 v4.0.3 实证 delete 型）：纯广告/营销端点
# ------------------------------------------------------------
# kill-advlistbatch: 我的页「今日偶遇/惊喜活动推荐」广告位删除（用户红框 2026-11-10；真机请求 positions=iosusercenter,iosusercenter2）；h5 域 ioscheckin 签到页广告位与 Data.iOS_tab 不动（来源 AshNail v4.0.3（config 无此条——真机取证 HAR 466 之上新增））
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/adv\/getadvlistbatch(\?.*)?$/ then response.json.delete(["Data.iosusercenter", "Data.iosusercenter2"])

# ------------------------------------------------------------
# 字段级净化（v4.0.3 新增）：发现页白名单
# ------------------------------------------------------------
# clean-simplediscover: 发现页白名单：仅保留 7 张 DISCOVER_* 内容卡，剔除 14 张 NEW_* 营销卡（游戏中心/红包广场/周边商城等）；v4.1.0 补三层类型守卫（顶层 object / Items 数组 / 条目 object / KeyName 字符串），异常条目不再让整次净化失败、响应原样放行（来源 AshNail v4.0.3（config 无此条——真机取证 HAR 466 之上新增） · v4.1.0 按 466_1794290256836.har 实证重写）
response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/user\/getsimplediscover(\?.*)?$/ then response.json.jq("if type == \"object\" and (.Data | type) == \"object\" and (.Data.Items | type) == \"array\" then .Data.Items |= map(select(if type == \"object\" then (.KeyName | if type == \"string\" then startswith(\"DISCOVER_\") else false end) else false end)) else . end")

# ------------------------------------------------------------
# 字段级净化（v4.0.2 新增）：同日真机 HAR 判定旧式响应脚本回写不被 Loon relay，本仓唯一已实证生效通道是 [Rewrite]
# ------------------------------------------------------------
# clean-mainpage: v4.1.1 删除此条 rewrite——response.json.delete 在 H2-to-H1 桥接连接上会导致流挂起 75 秒被强制关闭（v3.5.0 实证问题）。改由脚本接管，配合 force-identity 让上游返回明文，脚本可以正常处理并回写
# response if ${CAPTURE_ENABLE} == true && ${url} ~= /https:\/\/h5\.if\.qidian\.com\/argus\/api\/v\d+\/video\/adv\/mainPage(\?.*)?$/ then response.json.delete(["Data.PrivilegedTaskModule", "Data.MoreRewardTab", "Data.SurpriseBenefit", "Data.LastRewardItems", "Data.BaizeModule", "Data.TaskShowData", "Data.UserRewardModule", "Data.ActivityCenterModule", "Data.CharityModule", "Data.VideoRewardTab", "Data.RedeemGifts"])

# ========================================================================
# 脚本层（绑定行由 enhance.bindings 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 脚本绑定由 enhance.bindings 生成，lint 逐行对账。v2 内联绑定用
# script("scripts/<name>.min.js", {...})；config 范式的 vendored 引擎走旧式
# 绑定（script-path=scripts/<name>.js），参数经 argument=[{NAME}] 传入。
# 同 URL 的复写与脚本绑定按官方互斥语义注册（命中复写则同阶段脚本不执行）。
# ========================================================================

[Script]

# engine-replay: config 同形：finishWatch 请求阶段重放激励视频看播（9 次重放 + 递增等待约 90 秒，timeout 120）；不设 enable 门控
http-request ^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/v\d+\/video\/adv\/finishWatch script-path=scripts/Qidian.js, requires-body=true, timeout=120, tag=自动重放

# engine-token: config 同形：getconf/checkin/simpleinfo 请求自带 auth headers，引擎在请求阶段缓存凭据
http-request ^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d+\/(client\/getconf|checkin\/checkin|checkin\/simpleinfo) script-path=scripts/Qidian.js, requires-body=false, timeout=10, tag=获取Token

# engine-getconf: config 同形：CAPTURE_ENABLE=false 时由脚本做 getconf 30 项覆写 + 11 项删除；开启复写时本绑定被抑制（probe=true 仅为本仓互斥校验，不改变输出行）
http-response ^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/v1\/client\/getconf script-path=scripts/Qidian.js, requires-body=true, timeout=10, tag=客户端配置净化

# engine-deep-clean: config 同形：CAPTURE_ENABLE=false 时由脚本接管 22 个端点族（含 mainPage 限时任务收集）；开启复写时本绑定被抑制（probe=true 仅为本仓互斥校验，不改变输出行）。v4.1.1 移除 binary_body_mode=true——配合 force-identity 让上游返回明文，脚本收到字符串即可正常处理并回写
http-response ^https:\/\/(h5|magev6)\.if\.qidian\.com\/argus\/api\/(v\d+\/video\/adv\/mainPage(?!Dialog)|v\d+\/video\/adv\/mainPageDialog|v\d+\/video\/adv\/reportDialog|v\d+\/adv\/getadvlistbatch|v\d+\/deeplink\/geturl|v\d+\/dailyrecommend|v\d+\/checkin\/(lottery|checkinexchangepage)|v\d+\/user\/getsimplediscover|v\d+\/bookshelf\/(getHoverAdv|getTopOperation|getad)|v\d+\/client\/iosad|v\d+\/push\/getdialog|v\d+\/maintain\/playstrip|v\d+\/young\/getconf|v\d+\/freshman\/(bookshelfbtn|freshmanGuidePopup)|v\d+\/message\/(pullOperationPush|pullSocialPush)|v\d+\/followsubscribe\/showChapterEndModule|v\d+\/client\/getsplashscreen|v\d+\/reddot\/getdot|v\d+\/popup\/batchget|v\d+\/ploy\/getactivitylist|v\d+\/interaction\/getclassicbookinfo|v\d+\/readtime\/readpage) script-path=scripts/Qidian.js, requires-body=true, timeout=10, tag=深度净化

# engine-cookie: config 同形：getlogininfo 响应带完整用户凭据，独立开关 QDREADER_COOKIE_ENABLE 门控
http-response ^https?:\/\/h5\.if\.qidian\.com\/argus\/api\/v1\/user\/getlogininfo script-path=scripts/Qidian.js, requires-body=true, timeout=10, tag=起点读书获取Cookie, enable={QDREADER_COOKIE_ENABLE}, argument=[{QDREADER_DEBUG}]

# engine-cron: config 同形：CRONEXP/TIMEOUT 参数化定时与超时；7 个 argument 开关控制任务取舍；cron 不得被 enable 门控
cron {CRONEXP} script-path=scripts/Qidian.js, timeout={TIMEOUT}, tag=起点读书自动签到(包含高阶任务), argument=[{QDREADER_DEBUG},{QDREADER_ADV_JOB_ENABLE},{QDREADER_EXTRA_ADV_JOB_ENABLE},{QDREADER_LOTTERY_ENABLE},{QDREADER_WEEKLY_EXCHANGE_ENABLE},{QDREADER_CHAPTER_CARD_ENABLE},{QDREADER_MESSAGE_BOX_ENABLE}]

# engine-manual-job: v4.1.1 新增：独立的手动触发入口，只执行激励任务（不执行签到/抽奖）。与 cron 和 engine-manual 分开，方便用户随时手动触发一次
generic script-path=scripts/Qidian.js, timeout={TIMEOUT}, tag=起点手动执行激励任务(不签到), argument=[{QDREADER_DEBUG},{QDREADER_ADV_JOB_ENABLE},{QDREADER_EXTRA_ADV_JOB_ENABLE},{QDREADER_LOTTERY_ENABLE},{QDREADER_WEEKLY_EXCHANGE_ENABLE},{QDREADER_CHAPTER_CARD_ENABLE},{QDREADER_MESSAGE_BOX_ENABLE}]

# engine-manual: config 同形：官方 generic 为 cron 的手动自检位，同脚本同参数点一下即跑一次
generic script-path=scripts/Qidian.js, timeout={TIMEOUT}, tag=起点手动签到/自检(与自动签到同任务), argument=[{QDREADER_DEBUG},{QDREADER_ADV_JOB_ENABLE},{QDREADER_EXTRA_ADV_JOB_ENABLE},{QDREADER_LOTTERY_ENABLE},{QDREADER_WEEKLY_EXCHANGE_ENABLE},{QDREADER_CHAPTER_CARD_ENABLE},{QDREADER_MESSAGE_BOX_ENABLE}]
