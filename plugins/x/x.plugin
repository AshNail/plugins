#!name=X · 广告像素与遥测瘦身
#!desc=如实定位:X 时间线推广推文与正常内容同 API 同 CDN(pbs/video.twimg.com),DNS 层 App 内广告减少≈0。本插件黑洞广告像素/嵌入 syndication/广告后台域——隐私收益真实,广告数量不变。零证书。
#!author=edy
#!version=1.0.0
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/x/README.md
#!icon=https://cdn.adguard.com/public/Adguard/Common/logo.png
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(983)
#!date=2026-10-28
#!tag=隐私,遥测,X,Twitter
#!type=normal

# ========================================================================
# X · 广告像素与遥测瘦身
# ------------------------------------------------------------------------
# 红线（绝不进任何组）：t.co / *.twimg.com / api.twitter.com / x.com / twitter.com / api-stream.twitter.com——全部核心。
# AdGuard 官方口径:Twitter/X 广告与内容同服务器,DNS 拦截无法阻止,只能靠浏览器内容规则（MITM 层）——超出本插件约束。
# 本文件由 tools/build-apps.py 从 src/apps/x.json 生成，不要手改生成物。
# ========================================================================

[Rule]

# ------------------------------------------------------------
# 广告像素与嵌入（A 级,黑洞无损）（置信 A）
# ads-twitter.com/static=网页端转化像素;syndication/p/urls.api=第三方站点嵌入推文组件,X App 不用。
# 证据: https://github.com/stevenblack/hosts
# 证据: https://pgl.yoyo.org/adservers/serverlist.php
# 证据: https://github.com/privacy-protection-tools/anti-AD
DOMAIN-SUFFIX,ads-twitter.com,REJECT

[Host]

# ------------------------------------------------------------
# 广告像素与嵌入（A 级,黑洞无损）（置信 A）
# ads-twitter.com/static=网页端转化像素;syndication/p/urls.api=第三方站点嵌入推文组件,X App 不用。
# 证据: https://github.com/stevenblack/hosts
# 证据: https://pgl.yoyo.org/adservers/serverlist.php
# 证据: https://github.com/privacy-protection-tools/anti-AD
p.twitter.com = 127.0.0.1
syndication.twitter.com = 127.0.0.1
urls.api.twitter.com = 127.0.0.1

# ------------------------------------------------------------
# 广告后台与客户端遥测（默认关）（置信 B）
# ads*.twitter/x.com=广告管理控制台后端（黑洞不影响时间线广告,只断广告主后台）;analytics/scribe=统计与日志。不用广告主后台可开。
# 证据: https://github.com/stevenblack/hosts
# （默认关闭的组：整组注释，取消注释即启用）
# ads-api.twitter.com = 127.0.0.1
# ads-bidder-api.twitter.com = 127.0.0.1
# ads.twitter.com = 127.0.0.1
# ads.x.com = 127.0.0.1
# analytics.twitter.com = 127.0.0.1
# scribe.twitter.com = 127.0.0.1
