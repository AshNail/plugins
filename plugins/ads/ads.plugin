#!name=广告平台拦截器 · All-in-One v2.8.32
#!desc=单插件 All-in-One：DNS/pre-DNS 双栈广告拦截（同步阻断 IPv4 与 IPv6/AAAA）+ HTTPDNS 防绕过 + 公共 DoH/DoT 防泄漏，零证书默认全量生效。
#!author=edy
#!version=2.8.32
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/ads/README.md
#!icon=https://cdn.adguard.com/public/Adguard/Common/logo.png
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-16 20:10
#!tag=广告拦截,DNS,HTTPDNS,防泄漏,去广告
#!type=normal
#!source=9201d3d3f45c80d27754fcb9a4ea489fb4d364f8d278e30141e661f1dc34f201

# ============================================================================
# 广告平台拦截器 · All-in-One v2.8.32
# ----------------------------------------------------------------------------
# 工作机制：单插件 = [Host] DNS 广告拦截 + [Rule] HTTPDNS/DoT 兜底 + [General] IP 形式 DoH 加密解析。
# 核心 [Host] 把广告专域、HTTPDNS/私有 DoH、公网 DoH 入口映射到 127.0.0.1；DNS 阶段生效，HTTP/3 同样拦截。
# HTTPDNS 防绕过：已知域名走 [Host]；未知的 httpdns/httpsdns 由 [Rule] 关键词、UA、URL-REGEX 兜底；853 端口阻断 DoT/DoQ。
# DNS 防泄漏：插件 [General] 追加公共 DNS 与 IP 形式 DoH；Loon 插件不支持 hijack-dns/domain-reject-mode/dns-reject-mode，完整加固见 README 主配置段。
# 旁路：DNS 层只管得着「域名」，App 直连 8.8.8.8:443 / 1.1.1.1:853 时域名不存在，只有 IP-CIDR 拦得住——该组默认注释，开启前必须确认主配置没在用这些 DNS（见 docs/bypass-audit.md）。
# 共享主域（qq.com、baidu.com、google.com、facebook.com、snssdk.com、kuaishou.com、unity3d.com 等）绝不整域封禁，只列广告专用子域。
# 广告子域通配层：DOMAIN-WILDCARD（ads.* / adserver.* / adx.* 等广告专用前缀，弥补 [Host] 表达不了任意层级子域）需 Loon 3.5.3(1008)+，当前仅 TestFlight——默认注释输出，App Store 3.5.2 用户保持注释即可正常使用其余全部层；3.5.3+ 用户逐行去掉行首 '# ' 启用。
# 和 soda/douyin 冲突：本插件会同时拦掉激励广告（穿山甲/优量汇/快手联盟），保奖励模式会失效。刷奖励时请禁用本插件。
# 归因/统计组默认以注释生成；需要时在 src/ads/domains.json 把对应组 disabled 改为 false 后重新 build。
# 为保持零证书，单插件不包含 FAN 共享域 MITM/Rewrite 增强；不拦 graph.facebook.com/www.facebook.com，但 b-graph.facebook.com 等广告测量子域仍生效，异常时按 README 风险表删除。
# 2026-10-30 频道交叉核对：「广告必须死」两个公开频道（GitCube / Aa28413761）的镜像规则与服务端配置共 190 个域逐一比对，只吸收 7 个多源广告域（appsflyersdk、shuzilm、yandexmetrica、adapi.izuiyou、ws.tapjoyads、ems.youku、ubixioe）；v.smtcdns.com 实为腾讯视频 CDN、wxs.qq.com 是微信核心静态域、janapi/dns.jd.com 是京东红线，均拒收；asiad.byteactivity、lf-ad-ies.bytecdn.cn、mon.toutiacloud.com 仅频道单源、公开清单零命中，留待真机抓包，不凭频道名默认生效。
# 2026-10-30 第十轮公开仓库交叉核对：fmz200/blackmatrix7/RuCu6 微博与 HTTPDNS 插件逐条比对，只收微博 4 个 ≥3 源广告主机（sdkapp/adimg.uve、biz、alitui）、猫眼/收钱吧 2 个 ≥3 源广告专域与 2 个 ≥2 源 dig 解析端点（bdurl/zjurl）；微博 9 个 2 源候选单独放进默认注释的观察组。微博主域 uve.weibo.com 有插件显式 DIRECT、widget.weibo.com 有 anti-AD 白名单，均不整域/不收录；q2cdn、paydns.wechatpay 单源或支付域拒收。
# 2026-10-30 第十一轮全网公开清单交叉核对：anti-AD/AWAvenue/AdRules/HaGeZi PRO/fmz200 五份缓存清单按精确域名逐个计数，补 16 个 ≥3 源国内广告专域（腾讯音乐 adcdn/adclick/adexpo、腾讯视频 adstextview、喜马拉雅 adse/adse.wsa、酷狗 adsfile/ads.service、小红书 ads-img-qc/ads-video-qc/ads-video-al、新浪 adbox、搜狐 go、中华网 union、高德 optimus-ads、蜻蜓 ad-cdn）与 Google 中国 ads serving 2 域；12 个 ≥3 源埋点/日志进默认关统计组。ad.kuwo/ad.qingting/ad.csdn/ad.qq 等 1-2 源候选与 sdkconfig.video.qq.com、sdkapp.mobile.sina.cn、rs.sinajs.cn 三个功能混装域放进默认关观察组；ads.95516.com 已有云闪付重试风暴与 anti-AD @@ 例外记录，report.meituan.com 已由美团插件覆盖，均不重复收录。
# 本文件由 tools/build-ads.py 从 src/ads/domains.json 生成，不要手改生成物。
# 原 adfilter 插件已并入：11 个精确广告域进默认生效组（21CN / 联通 / Pixiv）；52 条 URL-REGEX 与 [MITM] 名单作为默认注释的可选层，启用需要证书。
# ============================================================================


[General]
# Loon 插件 [General] 只支持白名单键：这里只追加 DNS/DoH，不替换主配置。
# hijack-dns / domain-reject-mode / dns-reject-mode 不受插件支持，
# 完整 DNS 防泄漏请按 plugins/ads/README.md 的“主配置加固”段手动加入主配置。
dns-server = 223.5.5.5,119.29.29.29,180.184.1.1
doh-server = https://223.5.5.5/dns-query,https://223.6.6.6/dns-query,https://1.12.12.12/dns-query
doh3-server = h3://223.5.5.5/dns-query,h3://223.6.6.6/dns-query


[Rule]
# HTTPDNS / 私有 DoH 关键词兜底：已知域名在 [Host] 中，未知域名在这里拦。
# 规则行不带参数：Loon 规则只有 `no-resolve` 一个有文档依据的参数（IP 类用），
# Surge 的 `pre-matching` / `extended-matching` 在 Loon 里没有对应写法——
# 「DNS 阶段拒绝」由主配置 `domain-reject-mode` 控制（插件不能声明），
# 「SNI 辅助匹配」Loon 默认启用。写了要么被忽略，要么让整条规则解析失败。
# HTTPDNS 关键词采用 REJECT-DROP（丢包无回复）：这些 SDK 在收到 REJECT 的 200 空包后会秒级重试，
# REJECT-DROP 让连接静默超时，避免重试风暴；代价是首次超时略慢。
DOMAIN-KEYWORD,httpdns,REJECT-DROP
DOMAIN-KEYWORD,httpsdns,REJECT-DROP
USER-AGENT,httpdns*,REJECT
USER-AGENT,Httpdns*,REJECT
USER-AGENT,httpsdns*,REJECT
USER-AGENT,Httpsdns*,REJECT
URL-REGEX,^http:\/\/[0-9]+(\.[0-9]+){3}(:[0-9]+)?(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|httpdns|resolve|squery|amdc\/mobileDispatch)(?:\/|\?|$),REJECT
URL-REGEX,^http:\/\/\[[0-9a-fA-F:]+\](:[0-9]+)?(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|httpdns|resolve|squery|amdc\/mobileDispatch)(?:\/|\?|$),REJECT
URL-REGEX,^http:\/\/api\.weibo\.cn\/[0-9]+\/httpdns\/config,REJECT
URL-REGEX,^http:\/\/amdc\.alipay\.com\/s\??query,REJECT
# 埋点与上报防护：采用 REJECT-DICT 返回 200 + 空字典 {}，诱导统计 SDK（如神策）清空本地重试队列，避免存储膨胀与 CPU 频繁唤醒。
URL-REGEX,^http:\/\/.+\/sa(\.gif)?\?project=,REJECT-DICT
URL-REGEX,^http:\/\/.+\/v[0-9]*\/(?:event|log|track)\/(?:report|upload|batch),REJECT-DICT
# 阻断标准 DoT/DoQ 853 端口，防止 App 自带加密 DNS 绕过 Loon。
DEST-PORT,853,REJECT

# ============================================================================
# 双栈防旁路层：pre-DNS DOMAIN-SUFFIX / DOMAIN 阻断（同步封死 IPv4 与 IPv6/AAAA）
# ----------------------------------------------------------------------------
# Loon 在目标地址为域名时先匹配 [Rule] 域名规则（先于 DNS 解析，不区分地址族），
# 20 万条以内官方实测 < 1ms + LRU 缓存。由上方生效 [Host] 精确映射同步派生：
# `=domain` -> `DOMAIN-SUFFIX,domain,REJECT`；精确独立域 -> `DOMAIN,domain,REJECT`。
# ============================================================================
