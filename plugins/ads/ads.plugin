# ============================================================================
# 与按 App 插件红线冲突的候选（默认注释）
# ----------------------------------------------------------------------------
# tools/build-ads.py 把每个 App 插件 redlines 里声明的域挡在默认生效组之外。这三条是被红线拦下来的候选：dns.jd.com（京东自建 HTTPDNS）、union.jd.com（京东联盟站）、resolver.msg.xiaomi.net（MIUI 推送/消息解析通道）。两面理由都在这里：全局侧希望黑洞它们以逼 App 回退系统 DNS、让广告域 Host 映射生效；按 App 侧这三家各把同名域划为红线（解析/联盟/推送），拦了可能断搜索、下单签名、设备推送。默认注释=保持放行；开启前请确认你能接受对应 App 的那一侧代价。
#
# ---- 默认关闭：逐行取消行首的 '# ' 后生效 ----
# ============================================================================
# resolver.msg.xiaomi.net = 127.0.0.1
# dns.jd.com = 127.0.0.1
# union.jd.com = 127.0.0.1
# *.union.jd.com = 127.0.0.1

# ============================================================================
# 原 adfilter：精确广告域（可莉广告过滤器迁移）
# ----------------------------------------------------------------------------
# 2026-11-05 由独立插件 adfilter 并入的 DNS 子集：21CN 广告位（ad./ad.k./admarket./adshows.21cn.com）、联通 m1.ad.10010.com；adnxs 族与 ads-pixiv.net 族已由 adtech 组的 =adnxs.com / =ads-pixiv.net 整域覆盖。原插件的 52 条 URL-REGEX（需 MITM）与 1 条 jq 见 [Rule] 可选注释层。
# ============================================================================
ad.21cn.com = 127.0.0.1
ad.k.21cn.com = 127.0.0.1
admarket.21cn.com = 127.0.0.1
adshows.21cn.com = 127.0.0.1
m1.ad.10010.com = 127.0.0.1
