#!name=广告平台拦截器 · All-in-One
#!desc=单插件 All-in-One：DNS 广告拦截 + HTTPDNS 防绕过 + 公共 DoH/DoT 防泄漏。[Host]/[Rule]/[General] 三层；零证书、无 MITM/脚本；HTTP/3 同样生效；归因/统计组默认注释。
#!author=edy
#!version=2.1.3
#!homepage=https://github.com/AshNail/plugins
#!icon=https://cdn.adguard.com/public/Adguard/Common/logo.png
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(983)
#!date=2026-10-26
#!tag=广告拦截,DNS,HTTPDNS,防泄漏,去广告
#!type=normal

# ============================================================================
# 广告平台拦截器 · All-in-One
# ----------------------------------------------------------------------------
# 工作机制：单插件 = [Host] DNS 广告拦截 + [Rule] HTTPDNS/DoT 兜底 + [General] IP 形式 DoH 加密解析。
# 核心 [Host] 把广告专域、HTTPDNS/私有 DoH、公网 DoH 入口映射到 127.0.0.1；DNS 阶段生效，HTTP/3 同样拦截。
# HTTPDNS 防绕过：已知域名走 [Host]；未知的 httpdns/httpsdns 由 [Rule] 关键词、UA、URL-REGEX 兜底；853 端口阻断 DoT/DoQ。
# DNS 防泄漏：插件 [General] 追加公共 DNS 与 IP 形式 DoH；Loon 插件不支持 hijack-dns/domain-reject-mode/dns-reject-mode，完整加固见 README 主配置段。
# 共享主域（qq.com、baidu.com、google.com、facebook.com、snssdk.com、kuaishou.com、unity3d.com 等）绝不整域封禁，只列广告专用子域。
# 和 soda/douyin 冲突：本插件会同时拦掉激励广告（穿山甲/优量汇/快手联盟），保奖励模式会失效。刷奖励时请禁用本插件。
# 归因/统计组默认以注释生成；需要时在 src/ads/domains.json 把对应组 disabled 改为 false 后重新 build。
# 为保持零证书，单插件不包含 FAN 共享域 MITM/Rewrite 增强；不拦 graph.facebook.com/www.facebook.com，但 b-graph.facebook.com 等广告测量子域仍生效，异常时按 README 风险表删除。
# 本文件由 tools/build-ads.py 从 src/ads/domains.json 生成，不要手改生成物。
# ============================================================================


[General]
# Loon 插件 [General] 只支持白名单键：这里只追加 DNS/DoH，不替换主配置。
# hijack-dns / domain-reject-mode / dns-reject-mode 不受插件支持，
# 完整 DNS 防泄漏请按 plugins/ads/README.md 的“主配置加固”段手动加入主配置。
dns-server = 223.5.5.5,119.29.29.29,180.184.1.1
doh-server = https://223.5.5.5/dns-query,https://223.6.6.6/dns-query,https://1.12.12.12/dns-query


[Rule]
# HTTPDNS / 私有 DoH 关键词兜底：已知域名在 [Host] 中，未知域名在这里拦。
# extended-matching 让 HTTPS 按 SNI 匹配；pre-matching 在 DNS 阶段优先拒绝
# （需要主配置 domain-reject-mode = DNS，见 README）。
DOMAIN-KEYWORD,httpdns,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,httpsdns,REJECT,extended-matching,pre-matching
USER-AGENT,httpdns*,REJECT
USER-AGENT,Httpdns*,REJECT
USER-AGENT,httpsdns*,REJECT
USER-AGENT,Httpsdns*,REJECT
URL-REGEX,^http:\/\/[0-9]+(\.[0-9]+){3}(:[0-9]+)?(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|httpdns|resolve|squery)(?:\/|\?|$),REJECT,extended-matching
URL-REGEX,^http:\/\/\[[0-9a-fA-F:]+\](:[0-9]+)?(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|httpdns|resolve|squery)(?:\/|\?|$),REJECT,extended-matching
URL-REGEX,^http:\/\/api\.weibo\.cn\/[0-9]+\/httpdns\/config,REJECT,extended-matching
URL-REGEX,^http:\/\/amdc\.alipay\.com\/s\?query,REJECT,extended-matching
# 阻断标准 DoT/DoQ 853 端口，防止 App 自带加密 DNS 绕过 Loon。
DEST-PORT,853,REJECT

# ============================================================================
# 可选规则（默认关闭）
# ----------------------------------------------------------------------------
# 逐行取消行首的 '# ' 后生效；这些规则不参与上面的计数。
# ============================================================================
# 可选：HTTPDNS 网关 IP 字面量（默认关闭）。
# 开启后会直接阻断这些 HTTPDNS 服务 IP，连 HTTPS/QUIC 的 IP 直连也挡；
# 风险是这些 IP 可能被其他业务共用。逐行取消行首的 "# " 后生效。
# 依据：阿里云《启动接入点》help.aliyun.com/zh/document_detail/2868011、
# 腾讯云《企业版 IP》cloud.tencent.com/document/product/379/59133、
# 百度智能云《访问入口》cloud.baidu.com/doc/HTTPDNS/s/Njwvxm8ub。
# —— 阿里云 HTTPDNS 启动接入点（内地 IPv4）——
# IP-CIDR,203.107.1.0/24,REJECT,no-resolve,pre-matching
# IP-CIDR,203.119.238.240/32,REJECT,no-resolve,pre-matching
# IP-CIDR,106.11.25.239/32,REJECT,no-resolve,pre-matching
# IP-CIDR,59.82.99.47/32,REJECT,no-resolve,pre-matching
# —— 阿里云 HTTPDNS 启动接入点（内地 IPv6 /128）——
# IP-CIDR6,2401:b180:7001::31d/128,REJECT,no-resolve,pre-matching
# IP-CIDR6,2408:4003:1f40::30a/128,REJECT,no-resolve,pre-matching
# IP-CIDR6,2401:b180:2000:20::10/128,REJECT,no-resolve,pre-matching
# IP-CIDR6,2401:b180:2000:30::1c/128,REJECT,no-resolve,pre-matching
# —— 阿里云 HTTPDNS 启动接入点（海外 IPv4：香港/新加坡/美洲/欧洲，
# 服务国际 SDK 路由；与阿里云海外网段相邻，注意与 CDN 业务共用的可能）——
# IP-CIDR,47.56.234.194/32,REJECT,no-resolve,pre-matching
# IP-CIDR,47.56.119.115/32,REJECT,no-resolve,pre-matching
# IP-CIDR,161.117.200.122/32,REJECT,no-resolve,pre-matching
# IP-CIDR,47.74.222.190/32,REJECT,no-resolve,pre-matching
# IP-CIDR,47.246.131.175/32,REJECT,no-resolve,pre-matching
# IP-CIDR,47.246.131.141/32,REJECT,no-resolve,pre-matching
# IP-CIDR,47.89.80.182/32,REJECT,no-resolve,pre-matching
# IP-CIDR,47.246.146.77/32,REJECT,no-resolve,pre-matching
# —— 阿里云海外 IPv6 /128（香港/新加坡行原文档共用 240b:4000:f10 段）——
# IP-CIDR6,240b:4000:f10::178/128,REJECT,no-resolve,pre-matching
# IP-CIDR6,240b:4000:f10::188/128,REJECT,no-resolve,pre-matching
# IP-CIDR6,2404:2280:4000::2bb/128,REJECT,no-resolve,pre-matching
# IP-CIDR6,2404:2280:4000::23e/128,REJECT,no-resolve,pre-matching
# IP-CIDR6,2404:2280:3000::176/128,REJECT,no-resolve,pre-matching
# IP-CIDR6,2404:2280:3000::188/128,REJECT,no-resolve,pre-matching
# —— 腾讯云 HTTPDNS 接入 IP（标准版 98/99 + 企业版 43.132.x；
# 119.29.29.29 是公共 DNS 且为本插件 dns-server，刻意不拦）——
# IP-CIDR,119.29.29.98/32,REJECT,no-resolve,pre-matching
# IP-CIDR,119.29.29.99/32,REJECT,no-resolve,pre-matching
# IP-CIDR,43.132.43.43/32,REJECT,no-resolve,pre-matching
# IP-CIDR,43.132.55.55/32,REJECT,no-resolve,pre-matching
# —— 百度 HTTPDNS 唯一 BGP anycast VIP（旧组里的 186.76.76.200 是笔误：
# 官方文档任何版本都不存在该 IP，只有 180.76.76.200）——
# IP-CIDR,180.76.76.200/32,REJECT,no-resolve,pre-matching
# —— 可选：STUN 协议阻断（PROTOCOL 规则为 Loon 3.1.7+ 语法）——
# 防 WebRTC 真实 IP 泄露的协议级一拦；代价是部分 App 的语音/视频通话会失败。
# 更稳妥的主配置解法见 docs/loon-feature-checklist.md 的 disable-stun 段。
# PROTOCOL,STUN,REJECT


[Host]

