#!name=广告过滤器 · 原生规则子集
#!desc=从可莉广告过滤器 82 条规则中筛出的 API 级广告/推广拦截事实，改写为 Loon 原生 [Rule]/URL-REGEX；排除钱包、核心 API、共享 CDN、图片硬编码与未知响应体改写。DNS 域默认启用，URL 规则默认注释、逐 App 启用。
#!author=edy
#!version=1.0.0
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/adfilter/README.md
#!icon=https://raw.githubusercontent.com/Keywos/rule/main/img/AdBlock.png
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(983)
#!date=2026-11-03
#!tag=去广告,原生规则
#!type=normal

# ========================================================================
# 规则事实来自 fkingikelee/可莉广告过滤器的 request reject；只转写原生规则，含排除清单说明，不复制 JS。
# 默认生效：精确广告域；URL-REGEX 需要 MITM，默认注释，逐 App 验证后再开。
# ========================================================================

[Rule]
# ------------------------------------------------------------
# 精确广告域（不碰共享主域/CDN）
DOMAIN,adnxs.com,REJECT
DOMAIN-SUFFIX,adnxs.com,REJECT
DOMAIN,acdn.adnxs.com,REJECT
DOMAIN,mediation.adnxs.com,REJECT
DOMAIN,sin3-ib.adnxs.com,REJECT
DOMAIN,ad.21cn.com,REJECT
DOMAIN,ad.k.21cn.com,REJECT
DOMAIN,admarket.21cn.com,REJECT
DOMAIN,adshows.21cn.com,REJECT
DOMAIN,m1.ad.10010.com,REJECT
DOMAIN,open-pixon.ads-pixiv.net,REJECT

