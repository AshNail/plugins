#!name=高德地图 · 去广告与精简 v1.3.0
#!desc=高德地图开屏、首页活动与打车推广原生复写清理，遥测及日志域黑洞/双栈拦截；核心定位导航零接触。
#!author=edy
#!version=1.3.0
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/amap/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/47/36/74/4736744e-e536-3313-1981-d3879684d2a9/AppIcon-0-0-1x_U007epad-0-1-0-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-16
#!tag=去广告,高德地图
#!type=normal
#!source=2b664257016a6f56dc3961969c16985dee806e03b4be65f73ab9121be37bddde

# ========================================================================
# 高德地图 · 去广告与精简 v1.3.0
# ------------------------------------------------------------------------
# 红线（绝不进任何拦截组）：restapi.amap.com 核心路线规划、地点搜索与地理编码网关 / ts.amap.com 猎鹰轨迹服务与定位上报核心 API / sns.amap.com 账号与安全服务 / apsrgeo.amap.com 逆地理编码服务，经纬度转换道路门牌地址依赖 / cgicol.amap.com 与 dualstack-cgicol.amap.com 基站定位服务，室内与隧道定位依赖。
# 高德地图业务共享根域 *.amap.com，禁止整域通配。
# 高德基础地图数据共享根域 *.autonavi.com，禁止整域通配。
# 能力天花板与原生设计：logs.amap.com、dualstack-logs.amap.com、amap-aos-info-nogw.amap.com、adashx.ut.amap.com、h-adashx.ut.amap.com、v6-adashx.ut.amap.com、optimus-ads.amap.com、optimus-ads-ykx.amap.com 八个日志遥测与广告域走 [Host] 127.0.0.1 零证书黑洞；开屏、信息流与路线规划推广走 Loon 原生 [Rewrite] v2 引擎复写（reject_dict(200)），零 JS 脚本。
# v1.2.1 升级 Loon 原生 [Rewrite] v2 引擎复写层（enhance.active=true）：通过 [Argument] cleanAds 开关（默认开）驱动 8 条 request 阶段 reject_dict(200) 规则（覆盖 ws/(aos|valueadded)/alimama/splash_screen 与 ws/msgbox/pull 等）+ 4 台同域业务主机的 QUIC 回退（已从 [MITM] 移出已在 [Host] 黑洞的 amap-aos-info-nogw 与 optimus-ads）。
# 本文件由 tools/build-apps.py 从 src/apps/amap.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开。自动化类的默认值是显式源内裁决（v3.6.0 起 QDREADER_* 六开关默认# 开——用户裁决接受服务端风控后果）；每个开关都仍可单独关掉切面停用。
# ========================================================================

[Argument]

cleanAds = switch,true,tag=同域开屏与卡片去广告（默认开）,desc=启用 Loon 原生 [Rewrite] v2 引擎复写：alimama 开屏、AI 推荐流、路线规划推广卡片、打车订单 Tip、消息中心营销拉取（msgbox/pull）、ASA 广告归因、场景推荐与天气推广位在 request 阶段直接 reject_dict(200) 终止。需已安装并信任 Loon 证书。

[Rule]

# ------------------------------------------------------------
# QUIC 回退（增强层配套 · 拒的是 HTTP/3 协议，回落 TCP 后正文不受影响）
# MITM 只解密 TCP；App 走 HTTP/3 时下面这些主机的响应脚本会静默收不到。本组只对 PROTOCOL,QUIC 生效，同一主机的 TCP 请求（正文/书架/章节）零影响。
AND,((DOMAIN-SUFFIX,ai.amap.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,center.amap.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,m5-zb.amap.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,m5.amap.com),(PROTOCOL,QUIC)),REJECT

# ------------------------------------------------------------
# pre-DNS 双栈防旁路（DOMAIN-SUFFIX / DOMAIN 同步阻断 IPv4 与 IPv6/AAAA）
# 由生效 [Host] 精确派生：Loon 在域名规则阶段先于 DNS 解析生效且不区分地址族，单装本插件亦同步封死 AAAA 旁路。
DOMAIN,adashx.ut.amap.com,REJECT
DOMAIN,amap-aos-info-nogw.amap.com,REJECT
DOMAIN,dualstack-logs.amap.com,REJECT
DOMAIN,h-adashx.ut.amap.com,REJECT
DOMAIN,logs.amap.com,REJECT
DOMAIN,optimus-ads-ykx.amap.com,REJECT
DOMAIN,optimus-ads.amap.com,REJECT
DOMAIN,v6-adashx.ut.amap.com,REJECT

[Host]

# ------------------------------------------------------------
# 高德自建日志遥测 / 阿里 UT 埋点 / 配置更新（置信 A）
# logs.amap.com（6源）、dualstack-logs.amap.com（4源）、amap-aos-info-nogw.amap.com（3源）、adashx.ut.amap.com（3源）、h-adashx.ut.amap.com（2源）、v6-adashx.ut.amap.com（2源）。DNS 映射 127.0.0.1 阻断。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://github.com/hagezi/dns-blocklists
# 证据: https://github.com/AdguardTeam/AdguardFilters
adashx.ut.amap.com = 127.0.0.1
amap-aos-info-nogw.amap.com = 127.0.0.1
dualstack-logs.amap.com = 127.0.0.1
h-adashx.ut.amap.com = 127.0.0.1
logs.amap.com = 127.0.0.1
v6-adashx.ut.amap.com = 127.0.0.1

# ------------------------------------------------------------
# 高德商业化广告与擎天广告系统（置信 A）
# optimus-ads.amap.com（4源，高德擎天广告投放系统）、optimus-ads-ykx.amap.com（1源，广告分片）。DNS 映射 127.0.0.1 阻断。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://github.com/hagezi/dns-blocklists
optimus-ads-ykx.amap.com = 127.0.0.1
optimus-ads.amap.com = 127.0.0.1


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = m5.amap.com, m5-zb.amap.com, center.amap.com, ai.amap.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_* 在出网前就地返回
# 合法空载荷；response 阶段 reject_* 与 response.json.* 在回包后由引擎完成解压
# 与字段级改写（不依赖脚本层 $utils.ungzip）。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段直接终止（reject_dict(200)）：同域开屏与推广卡片路径
# ------------------------------------------------------------
# kill-splash: 高德 alimama 开屏广告接口（aos 与 valueadded 双路径）直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/Amap.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:m5|m5-zb|center|ai)\.amap\.com\/ws\/(?:aos|valueadded)\/alimama\/splash_screen(\?|$)/ then reject_dict(200)

# kill-ai-rec: AI 智能推荐卡片流直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/Amap.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:m5|m5-zb|center|ai)\.amap\.com\/v[0-9]\/ai_rec\// then reject_dict(200)

# kill-route-card: 路线规划底部推广服务卡片直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/Amap.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:m5|m5-zb|center|ai)\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan(\?|$)/ then reject_dict(200)

# kill-order-tip: 打车/订单页顶部营销提示横幅直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/Amap.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:m5|m5-zb|center|ai)\.amap\.com\/ws\/boss\/order_web\/\w{8}_information(\?|$)/ then reject_dict(200)

# kill-asa-attribution: ASA 广告归因上报接口直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/Amap.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:m5|m5-zb|center|ai)\.amap\.com\/ws\/asa\/ads_attribution(\?|$)/ then reject_dict(200)

# kill-scene-recommend: 首页场景推荐推广位直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/Amap.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:m5|m5-zb|center|ai)\.amap\.com\/ws\/shield\/scene\/recommend(\?|$)/ then reject_dict(200)

# kill-weather-ad: 增值天气挂件推广卡片直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/Amap.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:m5|m5-zb|center|ai)\.amap\.com\/ws\/valueadded\/weather(\?|$)/ then reject_dict(200)

# kill-msgbox-pull: 消息中心营销推送与活动横幅拉取直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/Amap.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:m5|m5-zb|center|ai)\.amap\.com\/ws\/msgbox\/pull(\?|$)/ then reject_dict(200)

# kill-main-page-assets: 导航首页活动资源与 AI 推广问答卡片直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Amap_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-(?:assets|aiqs)(\?|$)/ then reject_dict(200)

# kill-promotion-web: 出行促销 Web 资源与运营配置接口直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Amap_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource(?:\/home)?(\?|$)/ then reject_dict(200)

# kill-ranking-card: 排行榜商业推广卡片直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Amap_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/info_bff\/rankingCard(\?|$)/ then reject_dict(200)

# kill-search-marketing: 搜索商业化结构化营销运营接口直接返回 200 + 空字典（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Amap_remove_ads.lpx）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured(\?|$)/ then reject_dict(200)

# ------------------------------------------------------------
# 响应字段级净化（response.json.delete）：剥离云控广告与弹窗字段
# ------------------------------------------------------------
# clean-updatable-ads: AOCS 云控配置响应删除开屏/广告开关/弹窗/推广活动键（保留优惠券与钱包功能键）（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Amap_remove_ads.lpx）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1(\?|$)/ then response.json.delete(["data.adStatementConfig", "data.adCustomerRetainArchitecture", "data.adImEntryConfig", "data.adVenueConfig", "data.adPerfSwitch", "data.EndNaviC3AdCard", "data.infoCpcReport", "data.hotsaleConfig", "data.marketing_resource_config", "data.giftEntryConfig", "data.splashscreen", "data.SplashScreenControl", "data.splashview_config", "data.feedback_banner", "data.TrainOrderBanner", "data.nearby_business_popup", "data.shortcut_popup_frequency", "data.tel_retention_popup", "data.hotel_activity", "data.taxi_activity", "data.hotel_privilege", "data.sportsActivityConfig", "data.activity_qingke_contry_control", "data.custom_consultdata.widget_guide", "data.free_ride", "data.homepage_resource_config", "data.home_message_guide", "data.hotel_tipsicon", "data.sur_bar", "data.nearby_map_entry_guide", "data.small_biz_index", "data.small_biz_fun", "data.setpagesearch"])

# clean-car-order-promo: 打车订单页响应删除鲁班皮肤、气泡与营销弹窗字段（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Amap_remove_ads.lpx）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/car\/order\/content_info(\?|$)/ then response.json.delete(["data.lubanData.skin", "data.lubanData.kingToolBoxBubble", "data.lubanData.popup"])

# clean-hitch-banner: 顺风车乘客页响应删除顶部运营 Banner（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Amap_remove_ads.lpx）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/amap\/hitch\/passenger\/content_info(\?|$)/ then response.json.delete("data.lubanData.banner")

# clean-near-recommend-activity: 附近推荐页响应删除运营活动浮层字段（来源 https://github.com/fkingikelee/fkikelee/blob/main/lpx/Amap_remove_ads.lpx）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/smartui\/near_recommend(\?|$)/ then response.json.delete("data.operation_activity")
