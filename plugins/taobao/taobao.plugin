#!name=淘宝 · 去广告（原生规则层）
#!desc=淘宝广告分两层：Alimama/Tanx/Simba/adashx 等独立广告域走 DNS 黑洞；开屏、推荐、活动等广告入口是 acs.m.taobao.com / guide-acs.m.taobao.com 的 mtop 路径，需可选 MITM 后按 URL 精确拒绝。11 条路径来自可莉淘宝插件的 request reject 事实，改写为 Loon 原生 URL-REGEX + REJECT-DICT；不包含上游 JS，交易/登录/支付红线不动。
#!author=edy
#!version=1.0.0
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/taobao/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/4f/52/d9/4f52d982-e707-ea87-6c93-a8cea98268ec/AppIcon-0-0-1x_U007emarketing-0-10-0-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-03
#!tag=去广告,淘宝,阿里
#!type=normal

# ========================================================================
# 淘宝 · 去广告（原生规则层）
# ------------------------------------------------------------------------
# 红线：*.taobao.com / *.tmall.com / *.alicdn.com 整族承载登录、订单、购物车、商品图与播放；本插件只做精确广告子域和广告路径，绝不做 DOMAIN-SUFFIX 整域。
# acs.m.taobao.com 与 guide-acs.m.taobao.com 是 mtop 主网关，交易与广告同域；DNS 层不黑洞它们，只在可选 MITM 层按 11 条广告 API 路径返回 200 空字典。
# 可莉淘宝插件的 11 条 request reject 是原生 reject_dict，本插件改写为 URL-REGEX REJECT-DICT；上游两条 response script（开屏 cloudvideo / poplayer 模板）依赖 JS，本插件不复制、不依赖。
# 证据基线：可莉淘宝插件规则事实 + blackmatrix7 Advertising + anti-AD；淘宝 IPA 10.68.10 的 mtop 广告前缀已在公开主配置有独立证据。路径规则未在 2026-11-03 逐条真机复测，启用后先验搜索、下单、购物车、支付。
# DNS 组默认生效；MITM 增强层默认整段注释，装并信任 Loon 证书后逐条启用。
# 红线补充：h5api.m.taobao.com 是 H5 交易/登录接口；login.taobao.com 是淘宝登录入口；passport.taobao.com 是淘宝账号/通行证；sec.taobao.com 是淘宝风控/安全接口；gw.alicdn.com 是图片/素材 CDN；img.alicdn.com 与 heic.alicdn.com 是商品图 CDN。
# 本文件由 tools/build-apps.py 从 src/apps/taobao.json 生成，不要手改生成物。
# ========================================================================

[Host]

# ------------------------------------------------------------
# 阿里妈妈 / TanX / 阿里广告监测（置信 A）
*.alimama.com = 127.0.0.1
*.mmstat.com = 127.0.0.1
*.tanx.com = 127.0.0.1
alimama.alicdn.com = 127.0.0.1
atanx.alicdn.com = 127.0.0.1
tns.simba.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 阿里广告/UT 独立端点（置信 B）
# h-adashx.ut.taobao.com=AdashX 广告/UT 分片；ossgw.alicdn.com=广告素材网关；hudong.alicdn.com=互动广告素材。可莉淘宝原插件默认 REJECT；均为精确广告子域，媒体主域 alicdn.com 不整域。 2026-11-03 App 覆盖率审计补 6 个 ≥3 源 A 候选：atanx.alicdn.com、tns/dsp/tmatch.simba.taobao.com、adashx.m.taobao.com、adashx4yt.m.taobao.com；均为精确广告/交易归因子域。
# 证据: https://kelee.one/
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rule/Loon/Advertising/Advertising.list
# 证据: https://github.com/privacy-protection-tools/anti-AD
adashx.m.taobao.com = 127.0.0.1
adashx4yt.m.taobao.com = 127.0.0.1
atanx.alicdn.com = 127.0.0.1
dsp.simba.taobao.com = 127.0.0.1
h-adashx.ut.taobao.com = 127.0.0.1
hudong.alicdn.com = 127.0.0.1
ossgw.alicdn.com = 127.0.0.1
tmatch.simba.taobao.com = 127.0.0.1
tns.simba.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# UT 埋点（默认关）（置信 B）
# ut.taobao.com=阿里 UT 埋点；关闭统计不等于去广告，默认关，需要隐私优先再开。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# （默认关闭的组：整组注释，取消注释即启用）
# ut.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 淘宝客/联盟归因（默认关）（置信 B）
# tunion-api.m.taobao.com=淘宝联盟 CPS 归因；拦了会影响淘宝客取链/返利，默认关。
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rule/Loon/Advertising/Advertising.list
# （默认关闭的组：整组注释，取消注释即启用）
# tunion-api.m.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 阿里 AMDC HTTPDNS 调度（默认关）（置信 B）
# amdc.m.taobao.com / amdcopen.m.taobao.com=阿里 HTTPDNS 调度；拦后若 App 无回退可能拖慢建连，默认关。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# （默认关闭的组：整组注释，取消注释即启用）
# amdc.m.taobao.com = 127.0.0.1
# amdcopen.m.taobao.com = 127.0.0.1


# ========================================================================
# 可选 MITM 增强层（下面整段默认注释；不装证书 = 永不生效）
# ------------------------------------------------------------------------
# 淘宝 iOS 的开屏/推荐/活动广告入口与交易共用 acs.m.taobao.com、guide-acs.m.taobao.com，不能黑洞整域。下列 11 条 URL-REGEX 来自可莉淘宝插件的 request reject 事实，改写为 Loon 原生 REJECT-DICT（200 + 空字典）；广告图片路径用 REJECT-IMG。上游两条 response script（cloudvideo、poplayer 模板）需要 JS，本插件不包含。默认整段注释，装证书后逐条启用，先验搜索/下单/购物车/支付。
# 启用步骤：①Loon 里装并信任证书 →
#           ②取消 [MITM] 头与其 hostname 行的注释 →
#           ③取消 [Rule] 头及需要的 QUIC 回退 / URL-REGEX 行。
# 只对未做证书固定的 App 有效；银行/微信/米家这类做了证书固定，
# MITM 直接失败甚至触发风控——那些插件不提供本层（红线）。
# 本层每一条正则都来自公开可引用规则源，见下方证据；不凭空造路径。
# 证据: https://kelee.one/
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rule/Loon/Advertising/Advertising.list
# ========================================================================

# [MITM]
# ------------------------------------------------------------
# hostname 只列本 App 广告相关的具体接口域，不列整主域；一行取消注释即全部解密。
# hostname = %APPEND% acs.m.taobao.com, guide-acs.m.taobao.com, gw.alicdn.com, heic.alicdn.com
#
# [Rule]
# ------------------------------------------------------------
# 下列规则必须放在 [Rule] 段：取消本行（# [Rule]）与所需规则行的注释才生效。
# QUIC 回退（与 MITM 配套）：MITM 只解密 TCP，App 走 HTTP/3 时下面的
# URL-REGEX 会静默失效。
# 取消这些行让对应域的 QUIC 直接拒绝、回落 TCP。
# AND,((DOMAIN-SUFFIX,acs.m.taobao.com),(PROTOCOL,QUIC)),REJECT
# AND,((DOMAIN-SUFFIX,guide-acs.m.taobao.com),(PROTOCOL,QUIC)),REJECT
# AND,((DOMAIN-SUFFIX,gw.alicdn.com),(PROTOCOL,QUIC)),REJECT
# AND,((DOMAIN-SUFFIX,heic.alicdn.com),(PROTOCOL,QUIC)),REJECT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.fliggy\.crm\.screen\.(?:allresource|predict),REJECT-DICT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.alibaba\.advertisementservice\.getadv,REJECT-DICT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.alimama\.etao\.config\.query/.+?etao_advertise,REJECT-DICT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.alimusic\.common\.mobileservice\.startinit,REJECT-DICT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.etao\.noah\.query/.+tao_splash,REJECT-DICT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopadvertiseapi\.queryadvertise,REJECT-DICT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.o2o\.ad\.gateway\.get,REJECT-DICT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.taobao\.idle\.home\.welcome,REJECT-DICT
# URL-REGEX,^https://acs\.m\.taobao\.com/gw/mtop\.trip\.activity\.querytmsresources,REJECT-DICT
# URL-REGEX,^https://guide-acs\.m\.taobao\.com/gw/mtop\.taobao\.(?:volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get),REJECT-DICT
# URL-REGEX,^https://(?:gw|heic)\.alicdn\.com/imgextra/i\d/\d*/.+?-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0,REJECT-IMG
