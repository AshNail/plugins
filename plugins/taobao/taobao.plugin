# ------------------------------------------------------------
# 淘宝客/联盟归因（默认关）（置信 B）
# tunion-api.m.taobao.com=淘宝联盟 CPS 归因；拦了会影响淘宝客取链/返利，默认关。
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rule/Loon/Advertising/Advertising.list
# （默认关闭的组：整组注释，取消注释即启用）
# tunion-api.m.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 阿里 AMDC / 多线 HTTPDNS 调度（默认关）（置信 B）
# amdc.m.taobao.com / amdcopen.m.taobao.com / umc.danuoyi.alicdn.com（阿里云 CDN /multi_dns_resolve 多线 HTTPDNS）=阿里 HTTPDNS 调度；拦后若 App/CDN 无回退可能拖慢建连或影响图床调度，默认关。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# （默认关闭的组：整组注释，取消注释即启用）
# amdc.m.taobao.com = 127.0.0.1
# amdcopen.m.taobao.com = 127.0.0.1
# umc.danuoyi.alicdn.com = 127.0.0.1

# ------------------------------------------------------------
# 阿里妈妈直通车点击跳转/外链（默认关）（置信 B）
# 直通车推广点击/跳转（simba.taobao.com / click.taobao.com / g.click.taobao.com）与爱淘宝/热卖导购落地域（re/ai.taobao.com、show.re.taobao.com）：若只拦截点击跳转不拦截商品搜索页内的推广展示，结果只是点进推广宝贝/返利导购卡死——默认关。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcards/pro.txt
# （默认关闭的组：整组注释，取消注释即启用）
# ai.m.taobao.com = 127.0.0.1
# ai.taobao.com = 127.0.0.1
# click.mz.simba.taobao.com = 127.0.0.1
# click.taobao.com = 127.0.0.1
# click.tz.simba.taobao.com = 127.0.0.1
# g.click.taobao.com = 127.0.0.1
# mclick.simba.taobao.com = 127.0.0.1
# re.m.taobao.com = 127.0.0.1
# re.taobao.com = 127.0.0.1
# redirect.simba.taobao.com = 127.0.0.1
# show.re.taobao.com = 127.0.0.1
# simaba.m.taobao.com = 127.0.0.1
# simaba.taobao.com = 127.0.0.1
# simba.m.taobao.com = 127.0.0.1
# textlink.simba.taobao.com = 127.0.0.1


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = acs.m.taobao.com, guide-acs.m.taobao.com, gw.alicdn.com, heic.alicdn.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_dict/reject_img 在
# 出网前就地返回合法空载荷，请求不再发出；本层不含响应体改写。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段直接终止（reject_dict(200)）：mtop 同域广告接口
# ------------------------------------------------------------
# kill-fliggy-screen: 飞猪频道弹屏与营销资源拉取（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(?:allresource|predict)/ then reject_dict(200)

# kill-alibaba-getadv: 阿里通用广告服务拉取接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/ then reject_dict(200)

# kill-etao-advertise: 阿里妈妈一淘广告配置拉取（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise/ then reject_dict(200)

# kill-alimusic-startinit: 启动初始化营销配置接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/ then reject_dict(200)

# kill-tao-splash: 淘宝 noah 开屏广告查询接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash/ then reject_dict(200)

# kill-film-advertise: 淘票票/影视模块广告查询接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/ then reject_dict(200)

# kill-o2o-ad: 本地生活 O2O 广告网关拉取接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/ then reject_dict(200)

# kill-idle-welcome: 闲置频道欢迎弹窗营销接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/ then reject_dict(200)

# kill-trip-tms: 出行活动 TMS 营销资源查询接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/ then reject_dict(200)

# kill-guide-secondfloor: 首页二楼活动配置与开屏引导拉取（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(?:volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get)/ then reject_dict(200)

# kill-damai-popup: 淘系内大麦演出商业推广弹窗拉取接口（来源 https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AllInOne/AllInOne.plugin）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.damai\.mec\.popup\.get(?:\/|\?|$)/ then reject_dict(200)

# kill-homepage-launch: 首页商业启动营销拉取接口（来源 https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AllInOne/AllInOne.plugin）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.mos\.app\.homepage\.launch(?:\/|\?|$)/ then reject_dict(200)

# kill-home-splash: 手淘首页开屏广告专口拉取（来源 https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AllInOne/AllInOne.plugin）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:guide-)?acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:\/|\?|$)/ then reject_dict(200)

# ------------------------------------------------------------
# 请求阶段透明图替换（reject_img(200)）：共享图床开屏大图路径
# ------------------------------------------------------------
# kill-splash-img: 淘宝开屏全屏尺寸（1080/1125）octopus/tps 推广图返回 200 + 1px 透明 GIF（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/i\d\/\d*\/.+?-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0/ then reject_img(200)
