#!name=淘宝 · 去广告（原生复写层）
#!desc=淘宝广告分两层：Alimama/Tanx/Simba/adashx 等独立广告域走 DNS 黑洞；开屏、推荐、活动等广告入口是 acs.m.taobao.com / guide-acs.m.taobao.com 的 mtop 路径，默认启用 Loon 原生 [Rewrite] v2 引擎复写（cleanAds 开关默认开）——10 条广告 mtop 路径在 request 阶段 reject_dict(200) 终止，开屏大图路径用 reject_img(200) 返回 1px 透明图；不包含上游 JS，交易/登录/支付红线不动。前置：同域复写层需已安装并信任 Loon 证书。
#!author=edy
#!version=1.2.3
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/taobao/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/59/ef/48/59ef4826-1909-6c34-542d-9a55aae79c6c/AppIcon-0-0-1x_U007emarketing-0-10-0-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-07
#!tag=去广告,淘宝,阿里
#!type=normal

# ========================================================================
# 淘宝 · 去广告（原生复写层）
# ------------------------------------------------------------------------
# 红线：*.taobao.com / *.tmall.com / *.alicdn.com 整族承载登录、订单、购物车、商品图与播放；本插件只做精确广告子域和广告路径，绝不做 DOMAIN-SUFFIX 整域。
# acs.m.taobao.com 与 guide-acs.m.taobao.com 是 mtop 主网关，交易与广告同域；DNS 层不黑洞它们，只在 MITM + [Rewrite] v2 层按 10 条广告 API 路径返回 200 空字典。
# v1.2.0 启用 Loon 原生 [Rewrite] v2 引擎复写层（enhance.active=true）：通过 [Argument] cleanAds 开关（默认开）驱动 10 条 reject_dict(200) + 1 条 reject_img(200) 规则及 4 台解密主机的 QUIC 回退，解决注释态增强层在订阅插件下无法直接开启的问题。
# 证据基线：可莉淘宝插件规则事实 + blackmatrix7 Advertising + anti-AD；淘宝 IPA 10.68.10 的 mtop 广告前缀已在公开主配置有独立证据。
# 红线补充：h5api.m.taobao.com 是 H5 交易/登录接口；login.taobao.com 是淘宝登录入口；passport.taobao.com 是淘宝账号/通行证；sec.taobao.com 是淘宝风控/安全接口；gw.alicdn.com 是图片/素材 CDN；img.alicdn.com 与 heic.alicdn.com 是商品图 CDN。
# 本文件由 tools/build-apps.py 从 src/apps/taobao.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开、自动化类默认关——finishWatch 重放、代领奖、广告时长 patch 都是
# 「代打卡/伪造完成」，不默认生效，也不随净化开关一起被打开。
# ========================================================================

[Argument]

cleanAds = switch,true,tag=mtop 同域广告与开屏素材拦截（默认开）,desc=启用 Loon 原生 [Rewrite] v2 引擎复写：acs.m.taobao.com / guide-acs.m.taobao.com 的 10 条广告 mtop 路径在 request 阶段直接 reject_dict(200) 终止；gw/heic.alicdn.com 开屏推广大图路径用 reject_img(200) 返回 1px 透明图。需已安装并信任 Loon 证书。

[Rule]

# ------------------------------------------------------------
# QUIC 回退（增强层配套 · 拒的是 HTTP/3 协议，回落 TCP 后正文不受影响）
# MITM 只解密 TCP；App 走 HTTP/3 时下面这些主机的响应脚本会静默收不到。本组只对 PROTOCOL,QUIC 生效，同一主机的 TCP 请求（正文/书架/章节）零影响。
AND,((DOMAIN-SUFFIX,acs.m.taobao.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,guide-acs.m.taobao.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,gw.alicdn.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,heic.alicdn.com),(PROTOCOL,QUIC)),REJECT

[Host]

# ------------------------------------------------------------
# 阿里妈妈 / TanX / 阿里广告监测（置信 A）
*.alimama.cn = 127.0.0.1
*.alimama.com = 127.0.0.1
*.mmstat.com = 127.0.0.1
*.tanx.com = 127.0.0.1
adash-emas.cn-hangzhou.aliyuncs.com = 127.0.0.1
adashx.m.taobao.com = 127.0.0.1
alimama.alicdn.com = 127.0.0.1
alimama.cn = 127.0.0.1
alimama.com = 127.0.0.1
atanx.alicdn.com = 127.0.0.1
audid-api.taobao.com = 127.0.0.1
mmstat.com = 127.0.0.1
poplayer.template.alibaba.com = 127.0.0.1
rtb.julang.taobao.com = 127.0.0.1
tanx.com = 127.0.0.1
tns.simba.taobao.com = 127.0.0.1
wcp.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 阿里广告/UT 独立端点（置信 B）
# h-adashx.ut.taobao.com=AdashX 广告/UT 分片；ossgw.alicdn.com=广告素材网关；hudong.alicdn.com=互动广告素材；adashx4yt.m.taobao.com=优土侧 AdashX 分片；dsp/tmatch.simba.taobao.com=Simba 直通车竞价与定向子域（其余 atanx、tns.simba、adashx.m、wcp、audid-api、poplayer、rtb.julang 已由上方 sdks:["alimama"] 统一注入，此处不重复声明）。均为精确广告子域，媒体主域 alicdn.com 不整域。
# 证据: https://kelee.one/
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rule/Loon/Advertising/Advertising.list
# 证据: https://github.com/privacy-protection-tools/anti-AD
adashx4yt.m.taobao.com = 127.0.0.1
dsp.simba.taobao.com = 127.0.0.1
h-adashx.ut.taobao.com = 127.0.0.1
hudong.alicdn.com = 127.0.0.1
ossgw.alicdn.com = 127.0.0.1
tmatch.simba.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# UT 埋点（默认关）（置信 B）
# ut.taobao.com / umengacs.m.taobao.com / umengjmacs.m.taobao.com / abtest.alibaba.com=阿里 UT/友盟埋点与 AB 实验分流；关闭统计不等于去广告，默认关，需要隐私优先再开。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# （默认关闭的组：整组注释，取消注释即启用）
# abtest.alibaba.com = 127.0.0.1
# umengacs.m.taobao.com = 127.0.0.1
# umengjmacs.m.taobao.com = 127.0.0.1
# ut.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 淘宝客/联盟归因（默认关）（置信 B）
# tunion-api.m.taobao.com=淘宝联盟 CPS 归因；拦了会影响淘宝客取链/返利，默认关。
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rule/Loon/Advertising/Advertising.list
# （默认关闭的组：整组注释，取消注释即启用）
# tunion-api.m.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 阿里 AMDC HTTPDNS 调度（默认关）（置信 B）
# amdc.m.taobao.com / amdcopen.m.taobao.com=阿里 HTTPDNS 调度；拦后若 App 无回退可能拖慢建连，默认关。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# （默认关闭的组：整组注释，取消注释即启用）
# amdc.m.taobao.com = 127.0.0.1
# amdcopen.m.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 阿里妈妈直通车点击跳转/外链（默认关）（置信 B）
# mclick.simba.taobao.com / redirect.simba.taobao.com / textlink.simba.taobao.com=阿里妈妈直通车推广商品点击跳转与追踪；拦截后在搜索列表点带「广告」标的商品会打不开，默认关，需彻底绝育推广点击再开。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcards/pro.txt
# （默认关闭的组：整组注释，取消注释即启用）
# mclick.simba.taobao.com = 127.0.0.1
# redirect.simba.taobao.com = 127.0.0.1
# textlink.simba.taobao.com = 127.0.0.1


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = %APPEND% acs.m.taobao.com, guide-acs.m.taobao.com, gw.alicdn.com, heic.alicdn.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_dict/reject_img 在
# 出网前就地返回合法空载荷，response.json.* 由引擎底层自动完成 gzip/br 解压与
# 字段级改写（不依赖脚本层 $utils.ungzip），Accept-Encoding 协商保护同域脚本链。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段直接终止（reject_dict(200)）：mtop 同域广告接口
# ------------------------------------------------------------
# kill-fliggy-screen: 飞猪频道弹屏与营销资源拉取（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(?:allresource|predict)/ then reject_dict(200)

# kill-alibaba-getadv: 阿里通用广告服务拉取接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/ then reject_dict(200)

# kill-etao-advertise: 阿里妈妈一淘广告配置拉取（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise/ then reject_dict(200)

# kill-alimusic-startinit: 启动初始化营销配置接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/ then reject_dict(200)

# kill-tao-splash: 淘宝 noah 开屏广告查询接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash/ then reject_dict(200)

# kill-film-advertise: 淘票票/影视模块广告查询接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/ then reject_dict(200)

# kill-o2o-ad: 本地生活 O2O 广告网关拉取接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/ then reject_dict(200)

# kill-idle-welcome: 闲置频道欢迎弹窗营销接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/ then reject_dict(200)

# kill-trip-tms: 出行活动 TMS 营销资源查询接口（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/ then reject_dict(200)

# kill-guide-secondfloor: 首页二楼活动配置与开屏引导拉取（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(?:volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get)/ then reject_dict(200)

# ------------------------------------------------------------
# 请求阶段透明图替换（reject_img(200)）：共享图床开屏大图路径
# ------------------------------------------------------------
# kill-splash-img: 淘宝开屏全屏尺寸（1080/1125）octopus/tps 推广图返回 200 + 1px 透明 GIF（来源 https://kelee.one/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/i\d\/\d*\/.+?-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0/ then reject_img(200)
