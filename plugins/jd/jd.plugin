# jrad.jd.com = 127.0.0.1
# nfa.jd.com = 127.0.0.1
# sgm-w.jd.com = 127.0.0.1
# u-x.jd.com = 127.0.0.1
# u.x.jd.com = 127.0.0.1
# wn.x.jd.com = 127.0.0.1
# x.jd.com = 127.0.0.1

# ------------------------------------------------------------
# 埋点/日志/推荐回流（默认关，隐私收益）（置信 A）
# uranus/mercury/knicks/mllog/xlog/log/jcm/hermes/orbit/mars/anti-sdk-report/ex.m/jra/dsap/cltm/sgm-m/stat.m/firevent/du/atom-log.3.cn/log-h5.imdada.cn/clk-m.joybuy.com/h5log.joybuy.com=行为埋点、性能日志、秒送/国际端点击回流与推广事件上报，均默认关（不影响购物交易前提下提供隐私开关）。
