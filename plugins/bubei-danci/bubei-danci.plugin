# ========================================================================
# 不背单词 · 跟踪瘦身
# ------------------------------------------------------------------------
# 官方 SDK 目录全列:支付宝/微信 OpenSDK/友盟全家桶(统计/U-Push/分享/APM/U-Link 超链/一键登录+三大运营商通道/Agoo 长连接)/华为联运/各家推送/声通评测/爱加密/岳鹰 Crash——无穿山甲/优量汇/快手/百青藤。此前按「小厂爱用联盟」假设给本 App 配 SDK 组是错的,已撤回。
# 红线：learnywhere.cn 整主域(API+例句音频)/bbdc.cn/声通 isuntone/Agoo(阿里共享域不碰)/爱加密(拦可能被识别异常环境)/友盟一键登录通道(cmpassport/wosms/e189)。
# U-Link「智能超链」=营销归因(拉新转化),属跟踪面不属广告面;黑名单站外收录,拦了不影响学习功能。
# 本文件由 tools/build-apps.py 从 src/apps/bubei-danci.json 生成，不要手改生成物。
# ========================================================================

[Rule]

# ------------------------------------------------------------
# 友盟统计/超链（默认关——会连 U-Push 一起断）（置信 B）
# umeng.com 族是它的统计+推送+一键登录底座:DOMAIN-SUFFIX 整域拦=签到提醒与号码认证同断。只在「不在乎推送、只要隐私」时开。
# 证据: https://learnywhere.cn/lexis/sdklist
# （默认关闭的组：整组注释，取消注释即启用）
# DOMAIN-SUFFIX,umeng.com,REJECT

[Host]

# ------------------------------------------------------------
# 站外埋点（置信 B）
# ns.360wgjs.com 收录于 anti-AD/PiT 等三家列表;拦后无功能损失。
# 证据: https://github.com/privacy-protection-tools/anti-AD
ns.360wgjs.com = 127.0.0.1
