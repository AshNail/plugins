#!name=银行 App 聚合 · 遥测瘦身
#!desc=覆盖掌上生活/买单吧/浦发银行(含浦大喜奔)/云闪付/中国银行/农行掌银:六款银行 App 官方 SDK 目录均无第三方广告网络,广告≈100% 第一方内嵌(DNS 拦不到 banner 本体)。本插件只裁已证实的自建广告端点与穿山甲内网域;登录/支付/二维码/推送零接触。银行证书固定,MITM 不可行也不做。
#!author=edy
#!version=1.0.0
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/banks/README.md
#!icon=https://cdn.adguard.com/public/Adguard/Common/logo.png
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(983)
#!date=2026-10-28
#!tag=隐私,银行,遥测
#!type=normal

# ========================================================================
# 银行 App 聚合 · 遥测瘦身
# ------------------------------------------------------------------------
# 域名映射纠错（防后续维护者凭品牌名加规则,均为 A 级官方验证）：掌上生活=招商信用卡,域在 cmbchina.com/cmbimg.com——cmbc.com.cn 是民生银行!;买单吧=交通信用卡,域在 bankcomm.com——spdbccc.com.cn 是浦发信用卡中心(浦大喜奔)!;adspdbl.com 是 Triplelift 系停放域、iabchina.cn 是 IAB 行业组织,都与浦发/农行无关。
# 红线（绝不出现）：各银行主域整族（*.cmbchina.com/*.bankcomm.com/*.spdb.com.cn/*.95528.cn/*.spdbccc.com.cn/*.95516.com/*.cup.com.cn/*.boc.cn/*.abchina.com 的 DOMAIN-SUFFIX 级操作）/ wap.cmpassport.com+e.189.cn+ms.zzx9.cn(一键登录) / getui+gepush(买单吧与中行的唯一自建推送,杀了=交易提醒消失) / wallet.95516.com+mobilepaybeta.95516.com(付款码/HCE) / cfca.com.cn(数字证书扫码付) / cmbc.maam.cc(招行行内嵌优量汇测试域,黑洞会触发招行侧异常)。
# App 内正确开关:个性化推荐/商业推送在各银行隐私设置页可关(云闪付隐私政策明列路径),网络层拦不到第一方运营位是物理限制,不是规则没生效。
# 网上流传的『银行广告域名清单』几乎全不可用——本插件有效规则 4 条,是四大公开列表(anti-AD 11 万域/AdGuard-CN/AW/bm7 Advertising)+官方 SDK 目录交叉验证后的真实上限。
# 本文件由 tools/build-apps.py 从 src/apps/banks.json 生成，不要手改生成物。
# ========================================================================

[Rule]

# ------------------------------------------------------------
# 已证实的自建/自营广告端点（置信 A）
# mbads.paas.cmbchina.com=招行卡中心自建广告投放域(anti-AD+AdGuard 双收录,全聚合质量最高一条);ads.cup.com.cn=银联自营广告域(anti-AD+AW 双收录)。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://github.com/TG-Twilight/AWAvenue-Ads-Rule
# 证据: https://site.cc.cmbimg.com/AgreementManager/agreement/AppSDK.html
DOMAIN-SUFFIX,ads.cup.com.cn,REJECT

# ------------------------------------------------------------
# 穿山甲企业内网解析域（置信 A）
# *.alliance.com.corpqueue.net=穿山甲 SDK 内置企业内网主机名(私有 TLD 防劫持),外部网络只产生 DNS 探测噪音,黑洞零副作用;对装了穿山甲的 App 普遍有效。
# 证据: https://github.com/privacy-protection-tools/anti-AD
DOMAIN-SUFFIX,alliance.com.corpqueue.net,REJECT

[Host]

# ------------------------------------------------------------
# 已证实的自建/自营广告端点（置信 A）
# mbads.paas.cmbchina.com=招行卡中心自建广告投放域(anti-AD+AdGuard 双收录,全聚合质量最高一条);ads.cup.com.cn=银联自营广告域(anti-AD+AW 双收录)。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://github.com/TG-Twilight/AWAvenue-Ads-Rule
# 证据: https://site.cc.cmbimg.com/AgreementManager/agreement/AppSDK.html
mbads.paas.cmbchina.com = 127.0.0.1

# ------------------------------------------------------------
# 云闪付 ads/analytics 主接口（默认关）（置信 B）
# ads.95516.com=云闪付主广告接口:bm7 issue #493 记录 REJECT 后 App 狂发 analytics.95516.com(重试风暴),anti-AD easylist 输出对此域有 @@ 例外(疑似历史误报)——默认关,想开单独开并观察日志。
# 证据: https://github.com/blackmatrix7/ios_rule_script/issues/493
# （默认关闭的组：整组注释，取消注释即启用）
# ads.95516.com = 127.0.0.1
# analytics.95516.com = 127.0.0.1
