#!name=哔哩哔哩 · 去广告与精简
#!desc=哔哩哔哩 iOS/iPadOS：遥测上报（dataflow/data/tracker）+ HTTPDNS 解析防劫持域（httpdns.bilivideo.com）走 [Host] 127.0.0.1 零证书黑洞；同域开屏（含品牌/活动开屏）、导航栏、首页推荐流、视频详情页播放下相关推荐广告与搜索广场广告默认启用 Loon 原生 [Rewrite] v2 引擎复写（cleanAds / slimNav 开关默认开，零 JS 脚本）；核心登录/视频播放/直播/图床严格设防红线。前置：同域复写层需已安装并信任 Loon 证书。
#!author=edy
#!version=1.2.1
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/bilibili/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/b7/70/99/b7709979-0703-0722-b561-c97b2bf5b644/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-09
#!tag=去广告,哔哩哔哩
#!type=normal
#!source=0394746db7fe06e32132ea8620f5275d3e5ee6db655ba5fa8835f207c1313b90

# ========================================================================
# 哔哩哔哩 · 去广告与精简
# ------------------------------------------------------------------------
# 红线（绝不进任何拦截组）：passport.bilibili.com 账号与安全登录网关 / api.bilibili.com 核心业务 API，视频/播放/稿件接口 / app.bilibili.com 移动端核心业务接口，启动/信息流/导航 / live.bilibili.com 直播核心业务 / message.bilibili.com 私信与消息通知长连接通道。
# 哔哩哔哩主站业务共享根域 *.bilibili.com，禁止整域通配。
# 哔哩哔哩移动 API 业务共享根域 *.biliapi.net，禁止整域通配。
# 哔哩哔哩开放平台业务共享根域 *.biliapi.com，禁止整域通配。
# 哔哩哔哩流媒体 CDN 业务共享根域 *.bilivideo.com，禁止整域通配。
# 哔哩哔哩静态图片与封面共享根域 *.hdslb.com，禁止整域通配。
# 能力天花板与原生设计：dataflow.biliapi.com、data.bilibili.com、tracker.chat.bilibili.com、ali-web-player-tracker.biliapi.net、hw-v2-web-player-tracker.biliapi.net、httpdns.bilivideo.com 六个自建遥测与 HTTPDNS 域走 [Host] 127.0.0.1 零证书黑洞；开屏与信息流商业广告位走 Loon 原生 [Rewrite] v2（reject_dict(200) + response.json.jq），零 JS 脚本。
# v1.2.0 升级 Loon 原生 [Rewrite] v2 引擎复写层（enhance.active=true）：通过 [Argument] 的 cleanAds（开屏/推荐流/播放页去广告）与 slimNav（导航栏精简）两个开关驱动 5 条原生复写规则 + app.bilibili.com 的 QUIC 回退——补齐 splash/(brand/list|event/list2) 品牌与活动开屏终止、首页推荐流 cm_v1/ad_av/ad_web_s 商业卡片过滤，以及 x/v2/view 视频详情页播放下方商业组件（cm_config/cms/cm_ipad）与相关推荐广告位过滤。
# 本文件由 tools/build-apps.py 从 src/apps/bilibili.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开。自动化类的默认值是显式源内裁决（v3.6.0 起 QDREADER_* 六开关默认# 开——用户裁决接受服务端风控后果）；每个开关都仍可单独关掉切面停用。
# ========================================================================

[Argument]

cleanAds = switch,true,tag=开屏与信息流去广告（默认开）,desc=启用 Loon 原生 [Rewrite] v2 引擎复写：开屏 splash/(list|show|brand/list|event/list2) 请求直接 reject_dict(200) 终止；推荐信息流过滤商业广告卡片（cm_v1/cm_v2/cm_double_v9/ad_av/ad_web_s）与推广游戏；视频详情页剔除播放下方广告组件与相关推荐广告；搜索广场过滤游戏与广告推广。需已安装并信任 Loon 证书。
slimNav = switch,true,tag=导航栏精简（默认开）,desc=过滤底部导航栏「会员购/发布」与顶部导航栏「游戏中心」。

[Rule]

# ------------------------------------------------------------
# QUIC 回退（增强层配套 · 拒的是 HTTP/3 协议，回落 TCP 后正文不受影响）
# MITM 只解密 TCP；App 走 HTTP/3 时下面这些主机的响应脚本会静默收不到。本组只对 PROTOCOL,QUIC 生效，同一主机的 TCP 请求（正文/书架/章节）零影响。
AND,((DOMAIN-SUFFIX,app.bilibili.com),(PROTOCOL,QUIC)),REJECT

[Host]

# ------------------------------------------------------------
# 哔哩哔哩自建遥测 / 播放器埋点 / HTTPDNS 接口（置信 A）
# dataflow.biliapi.com（4源，官方移动端数据流/遥测）、httpdns.bilivideo.com（3源，HTTPDNS 解析端点）、data.bilibili.com（2源，数据埋点上报）、tracker.chat.bilibili.com（1源，聊天/直播埋点）、ali-web-player-tracker.biliapi.net（1源，阿里播放器埋点）、hw-v2-web-player-tracker.biliapi.net（1源，华为播放器埋点）。DNS 映射 127.0.0.1 阻断。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://github.com/hagezi/dns-blocklists
# 证据: https://github.com/AdguardTeam/AdguardFilters
ali-web-player-tracker.biliapi.net = 127.0.0.1
data.bilibili.com = 127.0.0.1
dataflow.biliapi.com = 127.0.0.1
httpdns.bilivideo.com = 127.0.0.1
hw-v2-web-player-tracker.biliapi.net = 127.0.0.1
tracker.chat.bilibili.com = 127.0.0.1


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = %APPEND% app.bilibili.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_dict/reject_img 在
# 出网前就地返回合法空载荷，response.json.* 由引擎底层自动完成 gzip/br 解压与
# 字段级改写（不依赖脚本层 $utils.ungzip），Accept-Encoding 协商保护同域脚本链。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段直接终止（reject_dict(200)）：纯开屏与顶栏挂件端点
# ------------------------------------------------------------
# kill-splash: 开屏广告列表、展示及品牌/活动开屏接口直接返回 200 + 空字典（来源 https://github.com/app2smile/rules/blob/master/plugin/bilibili.plugin）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:list|show|brand\/list|event\/list2)(\?|$)/ then reject_dict(200)

# kill-top-activity: 首页右上角活动推广挂件直接返回 200 + 空字典（来源 https://github.com/app2smile/rules/blob/master/plugin/bilibili.plugin）
request if ${slimNav} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity(\?|$)/ then reject_dict(200)

# ------------------------------------------------------------
# 响应字段级净化（response.json.jq）：保留业务数据流，只剥广告卡片与冗余入口
# ------------------------------------------------------------
# clean-feed-index: 推荐信息流：按前缀通杀商业广告卡片（cm_*/ad_*）、ad_info 节点、推广游戏与横幅广告（来源 https://github.com/app2smile/rules/blob/master/plugin/bilibili.plugin）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index(\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" and (.data.items | type) == \"array\" then .data.items |= map(select(type != \"object\" or (.ad_info == null and ((.card_goto // \"\") | startswith(\"ad_\") | not) and ((.card_type // \"\") | (startswith(\"cm_\") or startswith(\"ad_\")) | not) and .card_goto != \"game\" and ((.banner_item | type) != \"array\" or (.banner_item | all(type != \"object\" or .type != \"ad\")))))) else . end")

# clean-feed-story: 竖屏 Story 短视频流：剔除穿插的 ad_info / ad_* 广告视频（来源 https://github.com/app2smile/rules/blob/master/plugin/bilibili.plugin）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story(\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" and (.data.items | type) == \"array\" then .data.items |= map(select(type != \"object\" or (.ad_info == null and ((.card_goto // \"\") | startswith(\"ad_\") | not)))) else . end")

# clean-view-relates: 视频详情页：剔除播放下方商业推广配置（cm_config/cms/cm_ipad）及关联推荐中的广告卡片（来源 https://github.com/app2smile/rules/blob/master/plugin/bilibili.plugin）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/view(\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data |= (del(.cm_config, .cms, .cm_ipad) | if (.relates | type) == \"array\" then .relates |= map(select(type != \"object\" or (.is_ad_loc != true and .ad_info == null))) else . end) else . end")

# clean-search-square: 搜索广场：过滤热搜词中的游戏与广告推广（来源 https://github.com/app2smile/rules/blob/master/plugin/bilibili.plugin）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square(\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"array\" then .data |= map(select(type != \"object\" or (.type != \"game\" and .type != \"ad\"))) else . end")

# clean-nav-tab: 导航栏精简：过滤底栏会员购/发布与顶栏游戏中心（来源 https://github.com/app2smile/rules/blob/master/plugin/bilibili.plugin）
response if ${slimNav} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v[0-9]+(\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data |= ((if (.bottom | type) == \"array\" then .bottom |= map(select(type != \"object\" or (.name != \"会员购\" and .tab_id != \"会员购Bottom\" and .name != \"发布\"))) else . end) | (if (.top | type) == \"array\" then .top |= map(select(type != \"object\" or .name != \"游戏中心\")) else . end)) else . end")
