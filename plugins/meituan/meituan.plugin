#!name=美团 · 去广告
#!desc=美团/点评：iOS 官方 SDK 目录实证第三方变现 = Sigmob/ToBid/美数（穿山甲/优量汇仅 Android）+ 自建广告端点 impdsp/mads + 纯遥测家族黑洞；同域开屏接口、共享图床广告目录图片、搜索热词与购物车 Banner 默认启用 Loon 原生 [Rewrite] v2 引擎复写（cleanAds 开关默认开、slimUI 开关默认关，零 JS 脚本）。交易、支付、骑手调度零接触。前置：同域复写层需已安装并信任 Loon 证书。
#!author=edy
#!version=1.3.3
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/meituan/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/cc/1f/5d/cc1f5dcb-92b6-0e0b-6f08-7a40e16e49d0/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-07
#!tag=去广告,美团,点评
#!type=normal

# ========================================================================
# 美团 · 去广告
# ------------------------------------------------------------------------
# 红线（绝不进任何拦截组）：appsec-mobile.meituan.com（mtgsig 签名+设备指纹上报，拦=触发下单/支付风控，无任何黑名单收录）/ api-unionid.meituan.com（统一账号）/ api-map.meituan.net（地图瓦片）/ shark.dianping.com（Pike 长连通道，核弹模块 S9 也误伤它）/ ddplus(+quic).meituan.net（TitansX/Picasso 动态模板包）/ mrn.meituan.net 与 beauty-*.meituan.net（VOD/直播拉流）/ assistify.meituan.com（零证据，暂判 CORE）/ awp-assets 与 awps-assets（H5 容器与活动混装）/ apimobile.meituan.com / paymp / i.meituan.com。
# 拒收条目（取证否决）：meituan.xn / meituan.yoga / meituangov.cn / meituancdn.cc——AliDNS 无解析或非美团主体，来源可疑，写了也不会命中。
# 能力天花板（如实）：开屏走 wmapi/mapi 主 API 路径与 s3plus 共享存储，首页轮播走 p*.meituan.net / img.meituan.net 共享图床的 /bizad|/wmbanner|/adunion 路径——DNS 层不可分；成熟方案（blackmatrix7/wool）全部用 Map Local/reject-dict 即直接证据。本插件对独立 ADN + impdsp/mads 走 DNS 黑洞，对同域开屏/广告图/热词走 Loon 原生 [Rewrite] v2（reject_dict / reject_img / response.json.jq）。
# iOS 与 Android 差异：官方《接入第三方SDK目录》标注腾讯营销联盟/BeiZi/天璇/快手联盟/酷盈/PolyGamma 仅 Android——本插件 iOS 侧不挂 pangle/gdt/kuaishou 组，避免无收益死规则。
# 只走精确域,不做 DOMAIN-SUFFIX 整域——美团交易规则依赖 *.meituan.com/*.meituan.net 深层子域（含 *.mtgsig 防刷签名路径）。
# 本插件 [Host]/[Rule] 全设备生效(Loon 无法按 App 限定):同一 SDK 域跨 App 共享黑洞,'按 App 插件'只是分组开关;配合全局 ads 插件 httpdns 组防绕过。
# v1.3.0 启用 Loon 原生 [Rewrite] v2 引擎复写层（enhance.active=true）：通过 [Argument] 的 cleanAds（默认开：开屏 reject_dict(200)、4 条共享图床广告目录 reject_img(200)、4 条搜索热词与启动图/Banner jq 置空）与 slimUI（默认关：底部 Tab 与推荐流精简）双开关控制 15 条原生复写规则 + 配套 QUIC 回退。
# 本文件由 tools/build-apps.py 从 src/apps/meituan.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开、自动化类默认关——finishWatch 重放、代领奖、广告时长 patch 都是
# 「代打卡/伪造完成」，不默认生效，也不随净化开关一起被打开。
# ========================================================================

[Argument]

cleanAds = switch,true,tag=开屏与广告图/热词/Banner 净化（默认开）,desc=启用 Loon 原生 [Rewrite] v2 引擎复写：wmapi 开屏接口 reject_dict(200) 终止；共享图床广告目录路径 reject_img(200) 返回 1px GIF；搜索热词、购物车顶部 Banner 与启动图通过 response.json.jq 置空。需已安装并信任 Loon 证书。
slimUI = switch,false,tag=底部 Tab 与推荐流精简（默认关）,desc=隐藏底部 video/xiaotuan Tab（只留首页与我的）、清空购物车/个人中心推荐流与 AI 技能配置。默认关，按需开启。

[Rule]

# ------------------------------------------------------------
# QUIC 回退（增强层配套 · 拒的是 HTTP/3 协议，回落 TCP 后正文不受影响）
# MITM 只解密 TCP；App 走 HTTP/3 时下面这些主机的响应脚本会静默收不到。本组只对 PROTOCOL,QUIC 生效，同一主机的 TCP 请求（正文/书架/章节）零影响。
AND,((DOMAIN-SUFFIX,apimobile.meituan.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,assistify.meituan.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,feedguess.meituan.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,flowplus.meituan.net),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,img.meituan.net),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,mop.meituan.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,mt-personalcenter.meituan.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,p0.meituan.net),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,p1.meituan.net),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,wmapi.meituan.com),(PROTOCOL,QUIC)),REJECT

[Host]

# ------------------------------------------------------------
# Sigmob（北京创智汇聚）（置信 A）
# adservice/dc/track.sigmob.cn；anti-AD/AdGuard/hagezi 多源收录；ads 插件 mobile_sdks 组同源含此域。
*.sigmob.cn = 127.0.0.1
*.sigmob.com = 127.0.0.1
sigmob.cn = 127.0.0.1
sigmob.com = 127.0.0.1

# ------------------------------------------------------------
# ToBid 聚合（北京创致 / Sigmob 系）（置信 A）
# 美团官方 SDK 目录实证 iOS 在跑的聚合 SDK；n.tobidad.com 为静态端点，同补 tobidad.cn 变体（ads mobile_sdks 同源）。证据：fe-config.meituan.com SDK 目录 + anti-AD/hagezi。
*.tobidad.cn = 127.0.0.1
*.tobidad.com = 127.0.0.1
tobidad.cn = 127.0.0.1
tobidad.com = 127.0.0.1

# ------------------------------------------------------------
# 美数 AdMate（北京美数信息）（置信 A）
# 美团官方 SDK 目录实证 iOS 第三方变现 SDK；anti-AD 收录。
*.admate.cn = 127.0.0.1
*.admatex.cn = 127.0.0.1
*.admatex.com = 127.0.0.1
admate.cn = 127.0.0.1
admatex.cn = 127.0.0.1
admatex.com = 127.0.0.1

# ------------------------------------------------------------
# 美团自建广告端点（曝光/竞价/聚合入口）（置信 A）
# impdsp.meituan.com=自营展示广告 DSP 曝光/点击链路（wpt-giant 自建集群，anti-AD/AdGuard/hagezi 三源+issue #9926 归类 Ads）;mads.meituan.com=移动广告聚合入口。与 ads 插件同域规则重叠属有意（按 App 开关语义）。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://github.com/hagezi/dns-blocklists/issues/9926
# 证据: https://fe-config.meituan.com/bm/config/eg2i916cj1ag1gj16j.html
impdsp.meituan.com = 127.0.0.1
mads.meituan.com = 127.0.0.1

# ------------------------------------------------------------
# 开屏素材 CDN（专用子域）（置信 A）
# pd0-cdn-mcdn.m.meituan.net=开屏素材专用 mcdn(反黑名单收录);s3plus-pre=预发遥测端,生产不调用,黑洞零风险。开屏主路径(wmapi startpicture/s3plus brandcpt)同域不可分,预期只削掉 mcdn 分发的部分。
# 证据: https://github.com/privacy-protection-tools/anti-AD
pd0-cdn-mcdn.m.meituan.net = 127.0.0.1
s3plus-pre.51ping.com = 127.0.0.1

# ------------------------------------------------------------
# 美团/点评纯遥测家族（默认关）（置信 A）
# CAT 开源 APM(catfront)、灵犀埋点(lx.meituan.net)、dreport/wreport/hreport/report(BI 集群自证)、analytics.meituan.net、data-sdk-uuid-log/metrics-picture/maplocatesdksnapshot 分片、wx-md/cloudidv/orecct/athena——全部多源收录且与下单支付不同集群,拦掉只丢报表。athena=运营配置中心,拦后营销弹窗从「白屏」变「正常消失」。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://tech.meituan.com/2018/11/01/cat-in-depth-java-application-monitoring.html
# 证据: https://adguard.com/
# （默认关闭的组：整组注释，取消注释即启用）
# *.dreport.meituan.net = 127.0.0.1
# al-log.d.meituan.net = 127.0.0.1
# analytics.meituan.net = 127.0.0.1
# athena.mymeituan.com = 127.0.0.1
# catfront.dianping.com = 127.0.0.1
# data-sdk-uuid-log.d.meituan.net = 127.0.0.1
# dreport.meituan.net = 127.0.0.1
# hreport.meituan.com = 127.0.0.1
# logreport-cloudidv-cbr.meituan.com = 127.0.0.1
# lx.meituan.net = 127.0.0.1
# maplocatesdksnapshot.d.meituan.net = 127.0.0.1
# metrics-picture.d.meituan.net = 127.0.0.1
# orecct-rs.meituan.com = 127.0.0.1
# r1-online-report.meituan-dianping.net = 127.0.0.1
# report.meituan.com = 127.0.0.1
# reportonline.meituan.com = 127.0.0.1
# wreport.meituan.net = 127.0.0.1
# wreport1.meituan.net = 127.0.0.1
# wx-md.meituan.com = 127.0.0.1
# wxreport.qcs.meituan.com = 127.0.0.1

# ------------------------------------------------------------
# d.meituan.net 数据集群已知子域（默认关，验证后可升通配）（置信 B）
# bd0.d 落 data-leopard 集群（CNAME 取证自证上报），S7 用 DOMAIN-SUFFIX,d.meituan.net,REJECT——但整后缀升通配前需实测商品图/地图完整性，这里只列已知子域。
# 证据: https://github.com/fmz200/wool_scripts
# 证据: https://github.com/privacy-protection-tools/anti-AD
# （默认关闭的组：整组注释，取消注释即启用）
# bd0.d.meituan.net = 127.0.0.1

# ------------------------------------------------------------
# 外卖广告独立子域（默认关，单源收录）（置信 B）
# adgame.waimai.meituan.com=外卖广告小游戏;ad.e.waimai.sankuai.com=外卖广告请求域（CNAME 与业务 e.waimai.sankuai.com 不同集群,证据成立但仅 wool 单源）。抓包命中后升 A。
# 证据: https://github.com/fmz200/wool_scripts
# 证据: https://github.com/Junyi-99/Shadowrocket-Modules
# （默认关闭的组：整组注释，取消注释即启用）
# ad.e.waimai.sankuai.com = 127.0.0.1
# adgame.waimai.meituan.com = 127.0.0.1

# ------------------------------------------------------------
# 优惠券弹窗/红包雨配置网关（默认关）（置信 A）
# catdot/catreport.dianping.com=弹窗配置下发。拦掉=弹窗不弹,但每次请求要多等约 60s 超时——副作用可感知,默认关。
# 证据: https://api.github.com/search/code?q=catdot.dianping.com
# （默认关闭的组：整组注释，取消注释即启用）
# catdot.dianping.com = 127.0.0.1
# catreport.dianping.com = 127.0.0.1


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = %APPEND% wmapi.meituan.com, apimobile.meituan.com, p0.meituan.net, p1.meituan.net, flowplus.meituan.net, img.meituan.net, feedguess.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com, mop.meituan.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_dict/reject_img 在
# 出网前就地返回合法空载荷，response.json.* 由引擎底层自动完成 gzip/br 解压与
# 字段级改写（不依赖脚本层 $utils.ungzip），Accept-Encoding 协商保护同域脚本链。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段直接终止（reject_dict(200)）：wmapi 开屏广告配置
# ------------------------------------------------------------
# kill-openscreen: 美团外卖/主站 openscreen 开屏广告请求（不依赖参数顺序）返回 200 + 空字典（来源 https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AllInOne/AllInOne.plugin）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/wmapi\.meituan\.com\/api\/v[0-9]\/openscreen\?(?:[^#]*&)?ad(?:=|$|&)/ then reject_dict(200)

# kill-startpicture: wmapi 启动图广告请求返回 200 + 空字典（来源 https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AllInOne/AllInOne.plugin）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/wmapi\.meituan\.com\/api\/v[0-9]\/startpicture/ then reject_dict(200)

# kill-loadinfo: wmapi 启动加载广告信息请求返回 200 + 空字典（来源 https://github.com/fmz200/wool_scripts/blob/main/Surge/module/blockAds.module）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/wmapi\.meituan\.com\/api\/v[0-9]\/loadInfo\?/ then reject_dict(200)

# ------------------------------------------------------------
# 请求阶段透明图替换（reject_img(200)）：共享图床广告目录段
# ------------------------------------------------------------
# kill-img-p-cdn: p0/p1.meituan.net 共享图床下的 bizad/wmbanner/brandCpt 广告图（含 webp/png/gif）返回 200 + 1px GIF（来源 https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AllInOne/AllInOne.plugin）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(?:p0|p1)\.meituan\.net\/(bizad|wmbanner|brandCpt)\/[a-zA-Z0-9]+\.(?:jpg|jpeg|png|webp|gif)/ then reject_img(200)

# kill-img-flowplus: flowplus.meituan.net 玲珑推广素材图返回 200 + 1px GIF（来源 https://t.me/GitCube）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/flowplus\.meituan\.net\/v1\/mss_[^\/]+\/linglong\/[^\/]+\.(?:jpg|jpeg|png|webp|gif)/ then reject_img(200)

# kill-img-brandcpt: img.meituan.net 品牌 CPT 广告图返回 200 + 1px GIF（来源 https://t.me/GitCube）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/img\.meituan\.net\/bizad\/bizad_brandCpt_[^\/]+\.(?:jpg|jpeg|png|webp|gif)/ then reject_img(200)

# kill-img-adunion: img.meituan.net 广告联盟/展示广告目录图片返回 200 + 1px GIF（来源 https://github.com/blackmatrix7/ios_rule_script/blob/master/rewrite/Loon/AdvertisingScript/AdvertisingScript.plugin）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/img\.meituan\.net\/(adunion|display|dpmobile|midas)\/[A-Za-z0-9_-]+\.(?:gif|jpg|jpg\.webp)$/ then reject_img(200)

# ------------------------------------------------------------
# 响应字段级净化（response.json.jq）：热词、启动图与界面精简
# ------------------------------------------------------------
# clean-search-defaultword: 清空搜索默认词与热词（来源 https://t.me/Nzmgs）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword/ then response.json.jq("if type == \"object\" and (.searchIntroduceResponse | type) == \"object\" then .searchIntroduceResponse |= ((if (.defaultWordRes | type) == \"object\" then .defaultWordRes.defaultWordItems = [] else . end) | .HotWordInfos = []) else . end")

# clean-search-hotrecommend: 去掉搜索热词推荐与 AI 气泡（来源 https://t.me/Nzmgs）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\// then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data |= ((if (.segmentsV2 | type) == \"array\" then .segmentsV2 |= map(if type == \"object\" and (.hotwordSegments | type) == \"array\" then .hotwordSegments |= map(select(type != \"object\" or (.pageName != \"EntranceHotwordsV2Hotwords\" and .pageName != \"EntranceHotwordsV2ContentCard\"))) else . end) else . end) | (if (.aiSearchBubble | type) == \"object\" then .aiSearchBubble.bubbleTexts = [] else . end)) else . end")

# clean-cart-banner: 清空购物车入口顶部 banner（topBannerArea）（来源 https://t.me/Nzmgs）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry/ then response.json.jq("walk(if type == \"object\" and (.topBannerArea | type) == \"array\" then .topBannerArea = [] else . end)")

# clean-mop-startuppic: 清空 mop 启动图（startupPicArea）（来源 https://t.me/Nzmgs）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture/ then response.json.jq("walk(if type == \"object\" and (.startupPicArea | type) == \"array\" then .startupPicArea = [] else . end)")

# slim-indextab: 隐藏 video/xiaotuan 底部 tab，只保留 homepage/mine（来源 https://t.me/Nzmgs）
response if ${slimUI} == true && ${url} ~= /^https:\/\/apimobile\.meituan\.com\/aggroup\/indexTab/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" and (.data.resource | type) == \"object\" and (.data.resource.tabArea | type) == \"array\" then .data.resource.tabArea |= map(select(type != \"object\" or .tabName == \"homepage\" or .tabName == \"mine\")) else . end")

# slim-feedguess: 清空购物车/个人中心推荐流（来源 https://t.me/Nzmgs）
response if ${slimUI} == true && ${url} ~= /^https:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(?:gwc_feed1_2265|personalcenter_2154)/ then response.json.jq("if type == \"object\" then .data = [] | .bottom = true | (if (.ext | type) == \"object\" or .ext == null then .ext.forbidByExp = true else . end) else . end")

# slim-usercenter: 我的页去掉交叉推荐模块（来源 https://t.me/Nzmgs）
response if ${slimUI} == true && ${url} ~= /^https:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display/ then response.json.jq("if type == \"object\" and (.children | type) == \"array\" then .children |= map(select(type != \"object\" or .name != \"mine_cross_recommend\")) else . end")

# slim-hornconfig: 清空 AI 技能配置（data 内嵌 JSON 的 skills 对象）（来源 https://t.me/Nzmgs）
response if ${slimUI} == true && ${url} ~= /^https:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig/ then response.json.jq("if type == \"object\" then .data |= (. as $orig | if type == \"string\" then (try (fromjson | if type == \"object\" and (.skills | type) == \"object\" then .skills = {} else . end | tojson) catch $orig) else . end) else . end")
