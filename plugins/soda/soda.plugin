# 4. [MITM]
# ----------------------------------------------------------------------------
# api.qishui.com 与 beta-luna.douyin.com：luna 接口的两个主机。2026-10-29
#                真机日志（Luna 21.4.0）里 luna 请求 784 条在 beta-luna、3 条在
#                api.qishui（另有 99 条非 luna 请求）；老版本 App 仍走 api.qishui，两个都必须解密。
#                全部 luna 绑定同时写两个主机，由 lint 的 luna host parity 锁死。
# conf.qishui.com：settingsClean 打开时才会处理；证书固定导致设置加载失败，
#                关闭 settingsClean 或停用本插件。
# 固定证书止损：api<n>-<shard>.qishui.com + conf5-lf.qishui.com **固定证书，不可解密**（v3.3.1 撤出）。
#                2026-11-06 16:21:50 日志：这 7 台共约 227 次握手 100% certificate unknown，
#                v3.3.0 的「零次 certificate unknown 所以没固定」是在它们**没进 hostname**
#                时得出的——没解密就不可能出现这个错误，该推断本身是个幸存者偏差。
#                aweme.snssdk.com / zlink.ugsdk.cn / ads5-normal-gl2.zijieapi.com 同属固定证书主机，详见 README 8.1「固定证书主机清单」。
# ============================================================================

[MITM]

hostname = api.qishui.com, conf.qishui.com, ad.zijieapi.com, lianmengapi.snssdk.com, aweme.snssdk.com, ads?-normal*.zijieapi.com, zlink.ugsdk.cn, praisewindow.ugsdk.cn, beta-luna.douyin.com
h2 = true
