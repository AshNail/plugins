#!name=汽水音乐 · soda
#!desc=汽水音乐全能助手 v3.3.0:整合去广告 + 激励任务自动化v2(MITM响应注入)。基于 REA 21.4.0 二进制逆向 + HAR 抓包深度分析。核心发现:time_token/nonce 每次动态生成,纯重放不可行;设备已被风控(err_no=210021)。方案:拦截 Pangle 广告→伪造完成→增强 incentive/done 奖励→注入签到成功。开关收敛:16→9。支持 Bundle ID 变化(com.luna.music → com.soda.music)。v3.2.0 传输层:真机日志取证显示汽水 API 的真实入口是 api<n>-<shard>.qishui.com 分片(api3/api5 × hl/lf/lq + conf5-lf,2026-10-29 单份日志 747 次 SNI,而 api.qishui.com 只有 34 次),已连同配套 QUIC 回退与 gzip 降级一起补进静态层——本轮零新增绑定,只是把取证通道打开。v3.3.0 净化面与 kelee SodaMusic_remove_ads.lpx 逐条对账:采纳 5 条本插件零覆盖的端点(media_ads / activities / listen-video·reminder 引擎侧 reject_dict(200),me 剥 reward_ad_banner,more-panel 摘 related_video 块),sanitize 补 luna/card 的 previewGuide/priorityDisplay 与 song-tab 的 video_track_mix 混播卡;另 6 条按激励链路与共主机成本刻意不采纳,理由写在 [Rewrite] 段头。汽水在本机日志里零流量,这 5+2 条尚未取证——判据见 README「汽水净化取证」。致谢:起点读书 finishWatch 重放机制启发。
#!author=edy
#!version=3.3.0
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/soda/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/a1/6d/b4/a16db478-33e0-fc41-bc84-d5dd33f10762/AppIcon-0-0-1x_U007epad-0-1-0-85-220.png/512x512bb.jpg
#!system=iOS
#!loon_version=3.5.1(983)
#!date=2026-11-06
#!tag=汽水音乐,统一,开关,Loon,自动化,激励任务

# ============================================================================
# soda.plugin · 聚合开关版（一个 App 一个插件）
# ----------------------------------------------------------------------------
# 目标：Soda 只保留一个 .plugin。可选项用 [Argument] 开关；传输层常开、无开关。
#
# 共享脚本层：本插件的 block-domains / splash-ad / status 与
# douyin 插件共用同一份源码（src/common/*.js + src/common/families.json），
# tools/build.js 按家族参数展开到 src/soda/ 后压缩；名单还由 lint
# 校验 [Script]/[MITM]/源码三处一致。
#
# 开关：
#   rewardSafe      保奖励模式（默认开）
#   cleanAds        去广告脚本（默认关：广告配置/信息流/福利页广告任务）
#   killRewardAds   断激励素材（默认关：领奖会变 amount=-1）
#   blockAdDomains  广告域名拦截（默认关：MITM + http-request 脚本）
#   settingsClean   设置层净化（默认关，实验）
#   skipUpdateCheck 版本检查静音（默认关，实验：只动 luna/check-update 的 has_update）
#   hideDouyinEntry 隐藏设置层【听抖音】入口（默认关，可与保奖励同开）
#   blockSplashAd   拦截穿山甲开屏请求（默认开：不碰激励广告与发奖）
#   debugLog        只读日志（默认关）
#   logTaskTitles   日志带任务标题（默认关）
#   splashClean     清开屏品牌广告（默认开）
#   hideDouyinTab   隐藏福利页【听抖音】tab/任务 + 底部 Tab 栏【听抖音】（默认关）
#   listenOnly      纯听歌模式：底部 Tab 只留推荐/发现/我的，移除听抖音/直播/视频/朋友/社区/创作/AI 聊天/消息/一起听/娱乐（默认关，激励奖励保护）
#   statusNotify    状态自检按钮的通知模式（notification/silent）
#
# 推荐组合：
#   正常领奖励：rewardSafe=true，其余默认（blockSplashAd + splashClean 开屏双层已默认开）
#   版本提示静音：默认态基础上打开 skipUpdateCheck
#   排障：      保奖励基础上打开 debugLog
#   去广告：    rewardSafe=false, cleanAds=true, splashClean=true
#   强力去广告：rewardSafe=false, cleanAds=true, blockAdDomains=true
#   设置层：    rewardSafe=false, settingsClean=true
#
# 不要这样开：
#   rewardSafe=true + cleanAds=true
#   rewardSafe=true + settingsClean=true
#   脚本里有保护（rewardSafe 优先），但最稳妥的是只开一种模式。
#
# 两层模型（v2.8.0 起）：
#   L1 运行时层 = [Argument] 开关：只给“用户可能想改主意”的功能。
#   L2 静态层   = [Rule]/[Rewrite]/[MITM]：传输与协议层，常开、无开关。
#     · QUIC 强制回退：[MITM] 里这 25 个域拒绝 HTTP/3，逼回 TCP+TLS，
#       否则脚本根本看不见流量（MITM 只处理 TCP）。不做全局 QUIC 拒绝。
#     · h2 = true：零成本保险。官方 MitM 文档只列 hostname/ca-p12/ca-passphrase，
#       没有 h2（HTTP/2 解密是官方产品页宣称的默认能力）；社区插件通行写，
#       未知键被忽略，写了不亏。不当能力点宣称。
#   注：曾评估“删 Accept-Encoding 换明文”，实测 upsell 类响应 gzip 后就有
#   183~191 KB，去掉压缩会让单次传输膨胀 5~10 倍，已放弃（详见 docs/loon-native-first.md）。
#   静态层没有开关，因为“关掉它”等于让上面所有脚本失效；要回滚就删对应行。
#
# 重要限制（Loon 语法决定）：
#   1. [Rule] 是静态配置，不能按 [Argument] 开关启停。所以“域名拦截”
#      仍由 http-request 脚本实现（blockAdDomains 开关，可回退）：
#      QUIC 已强制回退，HTTP/3 漏过的问题不再存在。
#      QUIC 回退只保证“MITM 能看见”，拦截动作仍是开关，随时可关。
#   2. [MITM] 也是静态配置。广告域名写进 [MITM] 后，即使 blockAdDomains
#      关闭也会被解密；如果激励广告因此播不了（证书固定），把 [MITM] 里
#      那 5 个广告域名注释掉即可。
#   3. rewardSafe=true 时，域名拦截脚本会直接放行，保证激励广告正常播放。
#   4. 同一响应 Loon 只执行“配置顺序里第一条条件为真”的 Response Script。
#      settings 两条绑定必须传同一组参数；debugLog 与 cleanAds/hideDouyinTab
#      同开时，该端点的日志会被清理/隐藏脚本抢占（状态自检会给出提示）。
#
# 风险：
#   - settingsClean 需要 MITM conf.qishui.com；证书固定时可能影响设置加载。
#   - cleanAds 会清广告配置/福利页广告任务，开启后通常无法再领激励奖励。
#   - blockAdDomains 会让广告 SDK 拿不到广告，App 可能出现补偿提示。
#   - hideDouyinTab 只删福利页里带“抖音”的列表项，不动其它任务。
# ============================================================================

# >>> GENERATED ARGUMENTS from src/args/soda.json -- do not edit (npm run build:args)
[Argument]
rewardSafe = switch,true,tag=保奖励模式,desc=默认开启：保留激励广告、奖励任务和发奖链路，只清开屏品牌广告。
cleanAds = switch,true,tag=去广告脚本,desc=默认开启：清理广告位、信息流和福利页广告任务；不动激励广告素材。
killRewardAds = switch,false,tag=断掉激励广告,desc=清空 incentive/config、incentive/retrieve 的广告源、素材与预拉取列表。等于广告完全不发，领奖会变成 amount=-1，请谨慎。
blockAdDomains = switch,false,tag=广告域名拦截,desc=拦截 ad.zijieapi.com 等广告/归因域名（需 MITM，QUIC 已强制回退到 TCP）；保奖励模式下自动放行。真机取证（2026-11-05 20:25:48）：ads 分片与 zlink.ugsdk.cn 固定证书（ads5-normal-gl2 5/5/5、zlink 6/6/6）——这几台的连接是被掐断的、不等同于拦截成功；ads.plugin 的 DNS 层不受影响。
settingsClean = switch,true,tag=设置层净化,desc=默认开启：清空 conf.qishui.com 的广告配置。
skipUpdateCheck = switch,true,tag=版本检查静音,desc=默认开启：把 `luna/check-update` 响应里的 `has_update` 置 false：静音「发现新版本」提示。
hideDouyinEntry = switch,true,tag=隐藏【听抖音】入口,desc=默认开启：把设置层的 anchor_luna_to_douyin / _mv 关掉，汽水里的【听抖音】入口不再出现。
listenOnly = switch,false,tag=纯听歌模式,desc=移除底部 Tab 栏里所有与听歌无关的模块（听抖音/直播/视频/朋友/社区/创作/AI 聊天/消息/一起听/娱乐），只保留推荐、发现、我的；激励奖励链路完全保留。
blockSplashAd = switch,true,tag=拦截开屏广告请求,desc=默认开启：拦掉穿山甲开屏广告请求（splash/ 与 vN/(ack/)splash/ 全家族）；不影响激励广告与奖励。
debugLog = switch,false,tag=只读日志,desc=记录激励/任务/入口响应，不修改内容；可与保奖励模式一起用。
logTaskTitles = switch,true,tag=日志带任务标题,desc=默认开启：只读日志里额外打印任务标题（如【听抖音】），用于定位福利页入口。
splashClean = switch,true,tag=清开屏品牌广告,desc=默认开启：清理开屏品牌广告响应；保奖励和去广告模式都建议开启。
hideDouyinTab = switch,true,tag=隐藏【听抖音】,desc=默认开启：删除福利页里带抖音的 tab/任务条目。
statusNotify = select,"notification","silent",type=string,tag=自检通知,desc=点击「插件状态自检」后是否弹 Loon 通知：notification 弹通知并可一键跳转 App；silent 只写日志和结果页。结果页始终显示当前开关摘要与冲突提醒。
autoTask = switch,true,tag=激励任务自动化v2,desc=已注册四条腿：Pangle 广告伪造 + incentive/done 增强 + 签到注入 + 风控检测。诚实话：响应改写只改本机显示、不等于后端入账；2026-11-05 真机日志里这些主机零流量或被固定证书掐断——端到端效果未经确认。
autoSignIn = switch,true,tag=自动签到v2,desc=已注册：命中 sign_in_done 时由本机返回成功响应（绕过设备异常 210021）+ 每天 9 点 cron。真机取证：aweme.snssdk.com 固定证书 8 SNI / 8 Match / 8 握手失败——那条腿结构性失效；qishui 与 luna 两条腿本窗口零流量、既不算生效也不算失效。
# <<< GENERATED ARGUMENTS


# ============================================================================
# 1. [Rule] · 传输层（静态，常开）
# ----------------------------------------------------------------------------
# QUIC 强制回退：只对 [MITM] 里这 25 个精确域拒绝 HTTP/3(QUIC)。
# 为什么必须常开：脚本只能看见 TCP+TLS；目标域一旦走 HTTP/3，
# MITM 不生效 → 清洗/拦截脚本“静默看不到流量”，功能像随机失效。
# 为什么不做全局 PROTOCOL,QUIC,REJECT：那会连视频/通话/直播一起打掉。
# 代价：首个连接多一次回退（约 100~300ms）；极少数不回退的实现会连不上该接口。
# 回滚：删掉下面这 25 行，或整段清空（[Rule] 段可留空）。
# Pangle 分片族（ads3/ads5 × 5 个后缀）在 [Rule] 里逐个列出：DOMAIN-SUFFIX
# 不吃通配。对应的 [MITM] 用一条 ads?-normal*.zijieapi.com 覆盖全族——两边
# 严格对齐，才不会出现「解密了但没回退」的空档。分片清单取自 ads.plugin 的
# 公开广告数据（ads3/ads5 × normal/-hl/-lf/-lq/-xh），不是猜的。
# 汽水自己的 API 分片（api3/api5 × hl/lf/lq + conf5-lf）是两份真机日志逐台取证
# 补进来的：承接流量的主机是 api5-lf/api3-lf/conf5-lf/api5-hl/api3-hl/api3-lq/
# api5-lq.qishui.com，而插件原先只写了 api.qishui.com 与 conf.qishui.com——后者在
# 2026-11-05 那整场日志里零连接。取证事实：这些主机 alpn 只报 h2,http/1.1（没有 h3），
# 两份日志里提到 *.qishui.com 的行共 6543 + 198 行，certificate unknown 零次，
# 也就是「没做证书固定、只是没进 hostname」，Loon 只能按 SNI 查规则、url:(null)、
# 响应脚本永远看不见 body。补进 [MITM] 才有明文可看，脚本层是否命中留给下一轮日志裁决。
# log3-lf/log5-lf.qishui.com 同批被观测到，但它们是纯上报（mon/tnc/gecko 同族），
# 没有任何绑定指向它们，解密只增加握手成本，故刻意不纳入——要取证再补。
# ============================================================================

[Rule]

AND,((DOMAIN-SUFFIX,api.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,conf.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,api3-hl.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,api3-lf.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,api3-lq.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,api5-hl.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,api5-lf.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,api5-lq.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,conf5-lf.qishui.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ad.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,lianmengapi.snssdk.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,aweme.snssdk.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal-hl.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal-hl.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal-lf.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal-lf.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal-lq.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal-lq.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads3-normal-xh.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ads5-normal-xh.zijieapi.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,zlink.ugsdk.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,praisewindow.ugsdk.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,beta-luna.douyin.com),(PROTOCOL,QUIC)),REJECT


# ============================================================================
# 2. [Rewrite]
# ----------------------------------------------------------------------------
# 上报端点用原生 reject_dict(200)：回包是 JSON {} 且带 application/json，
# 比 reject(200) 的空 Body（text/plain）更符合 SDK 的 JSON 解码预期，
# 同时仍不产生真实出网。这两条由开关控制（会改行为，不属于传输层）。
# ============================================================================

[Rewrite]

# ----------------------------------------------------------------------------
# 压缩协商统一成 gzip（常开，无开关）
# 脚本层只有 $utils.ungzip（Build ≥ 988），br / zstd / deflate 没有解码器：
# 收到就是乱码 → 落进「不是 JSON」分支 → 表现为「这个端点本来就没广告」。
# 这是本插件最隐蔽的失效方式，靠事后诊断（X-Soda-Plugin: ce=br）只能定位不能避免。
# 官方层序：Rewrite 在规则匹配前、Script 之前执行，所以这里直接改请求头，
# 服务端不会再回 br——从源头消掉这条路径。
# 条件只留 URL，不写 `${request.header['Accept-Encoding']}`：能命中的域名
# 就是下面 [MITM] 的完整名单，由 lint 逐个域名对账（少一个就报错）。
# 代价：gzip 比 br 大约 10~20%，只作用于这几个 JSON 接口。
# ----------------------------------------------------------------------------
request if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|conf\.qishui\.com|api3-hl\.qishui\.com|api3-lf\.qishui\.com|api3-lq\.qishui\.com|api5-hl\.qishui\.com|api5-lf\.qishui\.com|api5-lq\.qishui\.com|conf5-lf\.qishui\.com|beta-luna\.douyin\.com|ad\.zijieapi\.com|aweme\.snssdk\.com|lianmengapi\.snssdk\.com|ads[0-9]-normal[a-z0-9-]*\.zijieapi\.com|zlink\.ugsdk\.cn|praisewindow\.ugsdk\.cn)\// then request.header.set("Accept-Encoding", "gzip")

# 开屏广告上报是 fire-and-forget，回 200 + JSON {} 减少 SDK 重试；由 splashClean 开关控制。
request if ${splashClean} == true && ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/splash\/brand\/report/ then reject_dict(200)

# DSP 广告展示上报：去广告模式下阻断无用出网并回 200 + JSON {}；由 cleanAds 开关控制。
request if ${cleanAds} == true && ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/ads\/report\/dsp\/show/ then reject_dict(200)

# ----------------------------------------------------------------------------
# v3.3.0 与 kelee SodaMusic_remove_ads.lpx（Loon 3.5.1(998)，纯引擎侧）逐条对账
# ----------------------------------------------------------------------------
# 采纳的 5 条有个共同点：本插件的 [Script] 绑定矩阵里**一条都没沾到这些端点**，
# sanitize.js 的 10 条 RULES 也没清过它们的字段——也就是 lpx 带来的净新增净化面。
# 写在引擎侧而不是新写脚本的原因和起点 v3.3.0 一样：脚本读 body 要先 ungzip
# （只有 Build ≥ 988 提供），引擎自己解压；reject_dict 连回包都不用拿。
# 主机对仍写 api.qishui.com + beta-luna.douyin.com 两个（lint 的 luna host parity
# 门禁：真机日志里两个主机都在承接 luna 流量，少一个就是「插件在跑、清理不到」）。
# ⚠ 未取证：汽水在 2026-11-06 13:09 那份日志里零流量，这 5 条是从 lpx 逐字移植、
# 按端点语义判断采纳的。字段名（reward_ad_banner / blocks+related_video）照 lpx 原文，
# 响应形状若不同就是无害的空操作——判据见 README「汽水净化取证」。
# 刻意不采纳的 6 条，理由同 README 同名小节：/luna/ads/ 前缀整族（会连 reward/receive|settle
# 一起掐掉领奖链路，本插件只放行到 ads/(config|retrieve|dsp/retrieve) 三条）、
# /luna/treasure/entrance/config（福利页入口，本插件当激励面在用，sanitize 只摘广告标签不整条拒）、
# /luna/commerce/v2/commerce_info（autoTask 的 VIP 权益注入就绑在这一条上）、
# /luna/commerce/upsells_config（已被上面那条 upsells 绑定按子串吃掉，引擎再终止只是换执行层）、
# webcast-open.douyin.com/webcast/openapi/feed/（要新加一台与抖音共用的 [MITM] 主机，
# 而它是直播 Tab 的内容接口不是广告位——先取证再说）、
# tnc*-*.zijieapi.com/get_domains 的 quic/httpdns 置 0（和上面 [Rule] 段那 25 条
# PROTOCOL,QUIC 回退是同一个目标的两种做法，两套并存要重新取证：lpx 那套是
# 「让 SDK 自己不走 h3」，本仓库这套是「h3 一律拒绝」，换过来得先解密 tnc 主机）。
# ----------------------------------------------------------------------------

# 媒体广告位配置：纯广告端点，响应体里没有业务字段。
request if ${cleanAds} == true && ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/media_ads(?:\?|$)/ then reject_dict(200)

# 运营活动列表：同上，纯运营载荷。
request if ${cleanAds} == true && ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/activities(?:\?|$)/ then reject_dict(200)

# 看视频听歌提醒弹窗：广告向引导，不含业务字段。
request if ${cleanAds} == true && ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/listen-video\/reminder(?:\?|$)/ then reject_dict(200)

# 「我的」页：只剥激励广告 banner 字段，页面其余结构保留（lpx 原文是裸键，汽水响应无包络）。
response if ${cleanAds} == true && ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/me(?:\?|$)/ then response.json.delete("reward_ad_banner")

# 更多面板：blocks 里只摘 type=related_video 的视频推广块（`\"` 转义写法来自 lpx，Loon 引擎吃这套）。
response if ${cleanAds} == true && ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/more-panel(?:\?|$)/ then response.json.jq(".blocks |= map(select(.type != \"related_video\"))")


# ============================================================================
# 3. [Script]
# ----------------------------------------------------------------------------
# 使用 Loon 3.5.1(983) 新版 Script 语法：
#   response if ${url} ~= /.../ then script("scripts/x.min.js", {${开关名}}) with enable=${开关名}
# 开关以布尔值透传给脚本（$argument.<参数名>）。
# debug=${debugLog} 接的是官方 with 属性：打开「只读日志」时同时打开 Loon 的
#   原生脚本调试输出（命中哪条、耗时、异常），不用再靠 console.log 猜。
# 保奖励模式优先：rewardSafe=true 时，sanitize 只处理开屏；
# settings 脚本在 rewardSafe=true 时直接放行。
#
# luna 主机双绑（v2.8.6）：2026-10-29 真机日志（Luna 21.4.0，build 100214010）
#   里 beta-luna.douyin.com/luna/* 有 784 条请求、api.qishui.com/luna/* 只有 3 条（非广告）；
#   旧版 34 条 api 单主机绑定在 beta-luna 上命中 0 条，整版只靠两条 beta-only 的
#   task/page 绑定命中 1 条。App 把 luna 接口搬到了 beta-luna，老版本仍走 api.qishui，
#   所以每条 luna 绑定同时写两个主机。
#   lint 的 luna host parity 门禁拒绝任何只绑一个主机的生效 luna 面。
# 注意：beta-luna.douyin.com 同时服务抖音 App，而 Loon 对同一响应只执行配置
#   顺序里第一条命中的响应脚本；同时安装 douyin 插件时，清理开关只在一个插件里开。
# ============================================================================

[Script]

# ---- 广告域名拦截：blockAdDomains 开关 ----
# HTTPS 必须先 MITM 解密才能匹配到域名；rewardSafe=true 时脚本直接放行。
request if ${url} ~= /^https?:\/\/(?:ad\.zijieapi\.com|lianmengapi\.snssdk\.com|ads[0-9]-normal[a-z0-9-]*\.zijieapi\.com|zlink\.ugsdk\.cn|praisewindow\.ugsdk\.cn)\// then script("scripts/block-domains.min.js", {${rewardSafe}, ${blockAdDomains}, ${debugLog}}) with debug=${debugLog}, enable=${blockAdDomains}, timeout=10, tag="广告域名拦截：blockAdDomains 开关"

# ---- 开屏品牌广告：保奖励/去广告共用 ----
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/splash\/brand\/retrieve/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${splashClean}, requires_body=true, timeout=10, tag="开屏品牌广告：保奖励/去广告共用"

# ---- 去广告脚本：激励广告配置 ----
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/incentive\/config/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${killRewardAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${killRewardAds}, requires_body=true, timeout=10, tag="去广告脚本：激励广告配置"

# ---- 去广告脚本：激励素材预拉取 ----
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/incentive\/retrieve/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${killRewardAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${killRewardAds}, requires_body=true, timeout=10, tag="去广告脚本：激励素材预拉取"

# ---- 去广告脚本：广告源 / DSP / 广告位配置 / 兜底广告 ----
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/ads\/(?:config|retrieve|dsp\/retrieve)/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="去广告脚本：广告源 / DSP / 广告位配置 / 兜底广告"

# ---- 去广告脚本：信息流广告 ----
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/(?:(?:v2\/)?feed\/|playlist\/(?:feed\/|detail|related_media|search)|search\/track|search-block|search-categories|media\/(?:assistant\/)?related|video_playlist\/detail|me\/discover|discover\/mix|featured-content\/list|card)/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="去广告脚本：信息流广告"

# ---- 去广告脚本：商业化弹窗 ----
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/commerce\/upsells/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="去广告脚本：商业化弹窗"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/commerce\/v2\/upsell_sort_decision/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="去广告脚本：upsell_sort_decision"

# ---- 去广告脚本：福利页只摘 reward_ads ----
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/entrance\/config/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="去广告脚本：福利页只摘 reward_ads"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/growth\/activity_entrance/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/view/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/page/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${cleanAds}, requires_body=true, timeout=10, tag="去广告脚本：task/page 结构化任务（v2.6.1）"

# ---- 隐藏【听抖音】条目：独立开关（cleanAds 关着也能生效） ----
# 必须排在 sanitize(cleanAds) 之后、reward-observe(debugLog) 之前：
# 两者同开时 hide 优先，避免“开了隐藏却只看到日志”。
response if ${url} ~= /^https?:\/\/(?:beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/treasure\/task\/page/ then script("scripts/sanitize.min.js", {${rewardSafe}, ${cleanAds}, ${hideDouyinTab}, ${debugLog}}) with debug=${debugLog}, enable=${hideDouyinTab}, requires_body=true, timeout=10, tag="隐藏【听抖音】条目：独立开关"

# ---- 底部 Tab 栏模块过滤：hideDouyinTab / listenOnly 两个开关 ----
# 取证（21.4.0 / build 100214010 主二进制 REA 逆向）：
#   - 底部 Tab 由服务端 `/aweme/homepage/combine/` 动态下发（BDPTabBarConfig /
#     IESECTabKitBottomTabComponent / _finalTabList）。
#   - 标识符：listen_douyin（听抖音）、song_tab（推荐）、live（直播）、
#     video（视频）、discover（发现）、mine（我的）；schema 形如 luna://luna.com/song_tab。
#   - 容器字段：bottom_tab_data / bottom_tab / homepage_tabs / tab_list / tab_data。
# 两条绑定传同一组参数，靠 enable 分流：Loon 只执行第一条命中的响应脚本，
# 关闭的绑定会被跳过，所以 hideDouyinTab 与 listenOnly 可各开各的。
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/aweme\/homepage\/combine\// then script("scripts/homepage-tabs.min.js", {${hideDouyinTab}, ${listenOnly}, ${debugLog}}) with debug=${debugLog}, enable=${hideDouyinTab}, requires_body=true, timeout=10, tag="底部 Tab 栏移除【听抖音】"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/aweme\/homepage\/combine\// then script("scripts/homepage-tabs.min.js", {${hideDouyinTab}, ${listenOnly}, ${debugLog}}) with debug=${debugLog}, enable=${listenOnly}, requires_body=true, timeout=10, tag="纯听歌模式：只留听歌相关 Tab"

# ---- 设置层净化（实验）：默认关闭 ----
# 两条绑定传同一组参数：Loon 只跑第一条命中的响应脚本，参数必须齐全，
# 否则 settingsClean + hideDouyinEntry 同开时后者会被静默丢弃。
response if ${url} ~= /^https?:\/\/conf\.qishui\.com\/service\/settings\/v3\// then script("scripts/settings.min.js", {${rewardSafe}, ${settingsClean}, ${hideDouyinEntry}, ${debugLog}}) with debug=${debugLog}, enable=${settingsClean}, requires_body=true, timeout=10, tag="设置层净化（实验）：清广告配置"

# ---- 【听抖音】入口：关掉 anchor_luna_to_douyin*（不动广告配置，可与保奖励同开） ----
response if ${url} ~= /^https?:\/\/conf\.qishui\.com\/service\/settings\/v3\// then script("scripts/settings.min.js", {${rewardSafe}, ${settingsClean}, ${hideDouyinEntry}, ${debugLog}}) with debug=${debugLog}, enable=${hideDouyinEntry}, requires_body=true, timeout=10, tag="隐藏【听抖音】入口"

# ---- 版本检查静音（实验）：skipUpdateCheck 开关 ----
# 取证（20.5.0 主二进制字符串簇）：luna/check-update ↔ STNetProto.CheckUpdateRequest /
# _TtC10STNetProto18CheckUpdateRequest，嵌套类型 CheckUpdateResponseInfo /
# CheckMediaResult，响应侧字段 media_result / shark_expired_at / has_update。
# 真机佐证：README 10.6 的 23 小时日志里 check-update/ 是 638 条非广告 luna 请求之一。
# 只把 has_update 置 false（「要不要提示更新」的判定分支），不碰包络与其它字段；
# 解析失败原样放行——最坏情况 = 提示还在。二进制另有 check_update_info（gecko
# bytesync）/ check_update_result（贴纸特效平台）/ force_update（敏感词库）/
# force_update_ts_ms（听歌房）四个同形键，均不是版本检查，不许绑。
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/check-update(?:\/|\?|$)/ then script("scripts/check-update.min.js", {${debugLog}}) with debug=${debugLog}, enable=${skipUpdateCheck}, requires_body=true, timeout=10, tag="版本检查静音（实验）：只动 has_update"

# ---- 开屏广告请求拦截：splash/ 与 vN/(ack/)splash/ 全家族，不碰激励广告 ----
request if ${url} ~= /^https?:\/\/(?:[a-z0-9.-]+\.)?zijieapi\.com\/api\/ad\/(?:splash\/|v[0-9]+\/(?:ack\/)?splash\/)/ then script("scripts/splash-ad.min.js", {${blockSplashAd}, ${debugLog}}) with debug=${debugLog}, enable=${blockSplashAd}, timeout=10, tag="拦截开屏广告请求"

# ---- 只读日志：20 个激励/任务/入口端点，不修改响应 ----
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/incentive\/config/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="只读日志：22 个激励/任务/入口端点绑定，不修改响应"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/incentive\/retrieve/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/incentive\/done/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/ads\/config/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/ads\/retrieve/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/ads\/dsp\/retrieve/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/ads\/reward\/receive/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/ads\/reward\/settle/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/commerce\/validate_reward/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/page/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="只读观测：task/page 任务标题（v2.6.1 补）"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/view/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/entrance\/config/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/reward_ads\/do_action/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/fallback\/do_action/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/flip_card\/do_action/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/guide\/do_action/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/browse_mall\/do_action/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/growth\/activity_entrance/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/growth\/activity\/finish/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/fallback\/done\/info/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/commerce\/v2\/upsell_sort_decision/ then script("scripts/reward-observe.min.js", {${logTaskTitles}}) with debug=${debugLog}, enable=${debugLog}, requires_body=true, timeout=10, tag="soda response"

# ---- 激励任务自动化 v2.0.0（MITM 响应注入方案） ----
# 核心发现：time_token/nonce 每次动态生成，纯重放不可行；设备已被风控(err_no=210021)
# 方案：MITM 层拦截广告SDK→伪造完成→增强incentive/done响应→注入签到成功
# 真机状态（2026-11-05 20:25:48）：这一组四条腿依赖的主机要么零流量（未取证），
#                要么被固定证书掐断（`aweme.snssdk.com` 8 SNI / 8 Match / 8 握手失败）。
#                所以本组的能力对外一律只许说「已注册、未取证/未解除前不生效」。
#                另一条不能省的诚实话：改响应体只改本机显示的数字与状态，不等于后端入账——
#                金币与权益以 App 内余额为准，不以插件日志为准。取证表见 README 第 -1 节与 8.1。

# Token 捕获：从所有 API 请求中提取认证信息（luna + 签到 + 广告SDK）
request if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com|aweme\.snssdk\.com|ad\.zijieapi\.com)\// then script("scripts/auto-task.min.js", {${autoTask}}) with debug=${debugLog}, enable=${autoTask}, timeout=10, tag="Token捕获：激励自动化v2"

# Pangle 广告注入：拦截穿山甲 inspire → 返回伪造广告完成（不实际播放视频）
request if ${url} ~= /^https?:\/\/ad\.zijieapi\.com\/api\/ad\/v1\/inspire(?:_preload)?\// then script("scripts/auto-task.min.js", {${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="Pangle广告注入：伪造完成"

# 签到注入：拦截 sign_in_done → 返回成功（绕过设备异常210021）
#                三条腿里 `aweme.snssdk.com` 已取证为固定证书（8/8/8 握手失败）——那条腿结构性失效；
#                `api.qishui.com` / `beta-luna.douyin.com` 本窗口零流量，既不能算生效也不能算失效。
request if ${url} ~= /^https?:\/\/(?:aweme\.snssdk\.com|api\.qishui\.com|beta-luna\.douyin\.com)\/.*\/sign_in\/sign_in_done/ then script("scripts/auto-task.min.js", {${autoSignIn}}) with debug=${debugLog}, enable=${autoSignIn}, requires_body=true, timeout=10, tag="签到注入：绕过设备异常"

# incentive/done 响应增强：修改 reward_details.amount 确保金币奖励
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/incentive\/done/ then script("scripts/auto-task.min.js", {${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="incentive/done响应增强：确保奖励"

# 激励配置缓存：记录广告源和频率控制
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/advert\/incentive\/config/ then script("scripts/auto-task.min.js", {${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="激励配置缓存"

# 福利任务页面观测：记录任务状态和资产
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/treasure\/task\/page\/v2/ then script("scripts/auto-task.min.js", {${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="任务页面观测"

# 💎 本地权益注入：commerce_info 响应增强（解锁 VIP/SVIP/无损/全景声/免广告）
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/commerce\/v2\/commerce_info/ then script("scripts/auto-task.min.js", {${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="💎 权益注入：commerce_info"

# 🚫 Upsell 弹窗清空：移除广告/营销弹窗，保留奖励相关
response if ${url} ~= /^https?:\/\/(?:api\.qishui\.com|beta-luna\.douyin\.com)\/luna\/commerce\/v2\/upsell(?:\?|$)/ then script("scripts/auto-task.min.js", {${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="🚫 Upsell弹窗清空"

# 签到详情观测
response if ${url} ~= /^https?:\/\/(?:aweme\.snssdk\.com|api\.qishui\.com)\/.*\/sign_in\/sign_in_detail/ then script("scripts/auto-task.min.js", {${autoTask}}) with debug=${debugLog}, enable=${autoTask}, requires_body=true, timeout=10, tag="签到详情观测"

# 自动签到 cron 任务（每天9点触发）
cron "0 9 * * *" then script("scripts/auto-task.min.js", {${autoSignIn}}) with debug=${debugLog}, enable=${autoSignIn}, timeout=60, tag="每日自动签到v2"

generic then script("scripts/status.min.js", {${statusNotify}, ${rewardSafe}, ${splashClean}, ${cleanAds}, ${killRewardAds}, ${blockAdDomains}, ${blockSplashAd}, ${settingsClean}, ${skipUpdateCheck}, ${hideDouyinEntry}, ${hideDouyinTab}, ${listenOnly}, ${debugLog}, ${logTaskTitles}, ${autoTask}, ${autoSignIn}}) with debug=${debugLog}, tag="插件状态自检", img_url="checkmark.seal", timeout=10


# ============================================================================
# 4. [MITM]
# ----------------------------------------------------------------------------
# api.qishui.com 与 beta-luna.douyin.com：luna 接口的两个主机。2026-10-29
#                真机日志（Luna 21.4.0）里 luna 请求 784 条在 beta-luna、3 条在
#                api.qishui（另有 99 条非 luna 请求）；老版本 App 仍走 api.qishui，两个都必须解密。
#                全部 luna 绑定同时写两个主机，由 lint 的 luna host parity 锁死。
# conf.qishui.com：settingsClean 打开时才会处理；证书固定导致设置加载失败，
#                关闭 settingsClean 或停用本插件。
# api<n>-<shard>.qishui.com + conf5-lf.qishui.com：汽水 API 的**真实入口**。两份
#                真机日志一致——2026-10-29 10:39:55：api3-lf/api3-hl 各 152 次、
#                api5-lf/api5-hl 各 148 次、api5-lq 74、api3-lq 73，而 api.qishui.com
#                只有 34 次；2026-11-05 20:25:48：api5-lf/api3-lf/conf5-lf/api5-hl/
#                api3-hl/api3-lq/api5-lq 全部在场。alpn 只报 h2,http/1.1（没有 h3），
#                两份日志里 *.qishui.com 共 6543 + 198 行、certificate unknown 零次——
#                固定证书这条排除掉了。11-05 窗口里它们只有 SNI 与 url:(null)，
#                因为本插件的 hostname 名单压根没有它们，Loon 只能按 SNI 查规则，
#                响应脚本永远拿不到 body；10-29 窗口里 api3-lq/api5-lq 被解密了 73/74 次，
#                但那是**用户主配置**的 MITM 名单，不该记在本插件头上
#                （见 docs/device-checklist.md「别把主配置记在插件头上」）。补进 hostname
#                之后，下一轮日志的解密与命中才归本插件解释。本轮不新增任何绑定，
#                绑定仍只写 luna 的两个已证主机（lint 的 luna host parity 锁死）。
#                log.qishui.com / log3-lf / log5-lf 是纯上报，没有任何绑定指向它们，
#                解密只增加握手成本，刻意不纳入。
# 下面 5 个广告域名：blockAdDomains / blockSplashAd 开关需要它们（HTTPS 必须先解密）。
#                如果开启后激励广告播不了（证书固定），把这 5 个域名注释掉。
# 分层关系：其中 ad.zijieapi.com / lianmengapi.snssdk.com /
#                ads?-normal*.zijieapi.com（Pangle 分片族）同时也被 ads.plugin
#                的 [Host] + DOMAIN-WILDCARD 家族层拦截；本份名单是 App 内
#                MITM 兜底层。这里用 `?`/`*` 而不是逐个枚举 ads3/ads5，
#                是因为 MITM 支持通配，而 [Rule] 的 DOMAIN-SUFFIX 不支持——
#                两边各用自己最强的写法，名单靠 lint 校验覆盖关系。
#                zlink.ugsdk.cn / praisewindow.ugsdk.cn 是 App 内运营端点
#                （口令/弹窗），只由本开关覆盖，不进 ads.plugin。
# 固定证书止损（2026-11-05 20:25:48 真机日志 · iPhone18,4 / iOS 27.2 / Loon 3.5.3(1014)）：
#                下面这几台**客户端拒收了 Loon 证书**，签名统一是
#                `ssl/tls alert certificate unknown`（err 167773206 / 0A000416）：
#                  aweme.snssdk.com               8 次 SNI /  8 次 Match /  8 次握手失败
#                  zlink.ugsdk.cn                 6 次 SNI /  6 次 Match /  6 次握手失败
#                  ads5-normal-gl2.zijieapi.com   5 次 SNI /  5 次 Match /  5 次握手失败
#                Match 行有两种形态（`host(host)` 与 `IP(host)`），括号里都是 SNI；
#                ads5-normal-gl2 是靠本插件声明的 `ads?-normal*.zijieapi.com` 通配命中的。
#                同窗口只有两台 Apple 主机解密成功（gspe1-ssl / configuration.ls.apple.com，
#                零失败），Loon CA 已被系统信任，所以这不是「用户没装证书」，是 App 侧固定证书。
#                后果：**不是静默不生效，而是这几台的连接被我们掐断了**——声明进 [MITM]
#                之后握手失败即整条请求失败。因此点名到它们的绑定只剩「已注册」这一种说法：
#                  · `sign_in/sign_in_done`（autoSignIn）与 `sign_in/sign_in_detail`（autoTask）
#                    的正则里 aweme.snssdk.com 那一条腿结构性失效——握手就断了，请求层
#                    拿不到请求，响应层更拿不到 body。另两条腿 api.qishui.com /
#                    beta-luna.douyin.com 本窗口零流量，既不能算生效也不能算失效。
#                  · `blockAdDomains` 请求层正则里的 ads 分片与 zlink.ugsdk.cn 同理。
#                对外只许说「已注册、固定证书未解除前不生效」，不许说「已净化/已拦截/已签到」。
#                polaris.zijieapi.com（26 次全失败）不在本插件名单，属抖音侧，见 douyin 插件。
#                与汽水分片那条取证对照着读：api<n>-<shard>.qishui.com 是「没进名单」
#                （零 Match、零 certificate unknown），这几台是「进了名单但被拒证」——
#                症状不同，处置也不同，别混成一类。
#                止损动作（默认不执行，要就手动）：把这些主机从上面 hostname 行删掉，
#                对应 [Rule] 的 QUIC 回退行与只命中它们的绑定一起注释——删掉之后连接
#                恢复正常，只是这些端点重新变成黑盒。签到注入的正则里保留 qishui/luna
#                两条腿即可，不必整行注释。
# h2 = true（常开）：未文档化键，社区通行写法。官方 MitM 文档只列三个键，
#                HTTP/2 解密本就是默认能力，这里保留纯属零成本保险（未知键被忽略）。
#                若某个 build 把它当非法键导致断网，删掉这一行即可回滚。
# 脚本来源：block-domains.min.js / splash-ad.min.js 由 src/common/*.js +
#                families.json 生成，与 douyin 插件共享单一源码。
# ============================================================================

[MITM]

hostname = %APPEND% api.qishui.com, conf.qishui.com, api3-hl.qishui.com, api3-lf.qishui.com, api3-lq.qishui.com, api5-hl.qishui.com, api5-lf.qishui.com, api5-lq.qishui.com, conf5-lf.qishui.com, ad.zijieapi.com, lianmengapi.snssdk.com, aweme.snssdk.com, ads?-normal*.zijieapi.com, zlink.ugsdk.cn, praisewindow.ugsdk.cn, beta-luna.douyin.com
h2 = true
