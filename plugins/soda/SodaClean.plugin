#!name=汽水音乐 · 净化
#!desc=拦截激励视频/开屏/信息流/DSP 广告与归因；URL 重写 + 字段级响应改写。只摘广告任务，保留签到/听歌/分享/金币等合法福利。基于 20.5.0 二进制取证。
#!author=edy
#!version=1.5.2
#!homepage=https://github.com/AshNail/plugins
#!system=ios
#!tag=汽水音乐,去广告,净化,Loon

# ============================================================================
# 使用说明
# ----------------------------------------------------------------------------
# 四种模式，按需选择：
#
#   A. 精准模式（默认，推荐）
#      [Rule] + [Rewrite] + [Script] + [MITM]
#      URL 重写断开纯上报；脚本保留响应包络，只清广告容器。
#
#   B. 轻量模式（不跑脚本，仍需 MITM）
#      [Rule] + [Rewrite] + [MITM]
#      返回 {} / []，可能触发解析失败或重试；比脚本轻，但仍需证书。
#
#   C. 纯域名模式（无 MITM）
#      [Rule]
#      只拦广告 SDK 域名，不做 URL / 字段级处理。
#
#   D. 配置层模式（实验，独立插件）
#      另装 SodaClean-Settings.plugin：
#      通过 conf.qishui.com/service/settings/v3/ 清空广告配置。
#      与 A 可同时安装；证书固定导致异常时停用即可。
#
#   切换方法：
#      - 用 A：保持现状，忽略下面被注释的轻量段。
#      - 用 B：注释掉整个 [Script] 段，保留 [MITM]，
#              取消"轻量模式"段的注释。
#      - 用 C：注释掉整个 [Rewrite]、[Script]、[MITM]，只保留 [Rule]。
#      - 用 D：保持 A，再安装 SodaClean-Settings.plugin。
#
#   注意：如果你要“完整看完激励视频、正常拿奖励”，请改用独立的
#   SodaClean-Reward.plugin；不要与本插件同时启用。本插件的 [Rule] 与
#   激励/任务脚本会让激励视频无广告可播，奖励链路也就断了。
# ============================================================================


# ============================================================================
# 1. [Rule] 域名拦截（四种模式都生效，不需要 MITM）
# ============================================================================

[Rule]

# ---- 激励视频 / Pangle / 穿山甲广告请求 ----
DOMAIN,ad.zijieapi.com,REJECT
DOMAIN,lianmengapi.snssdk.com,REJECT
DOMAIN,ads5-normal-hl.zijieapi.com,REJECT

# ---- 归因与转化回传 ----
DOMAIN,zlink.ugsdk.cn,REJECT
DOMAIN,praisewindow.ugsdk.cn,REJECT
# DOMAIN,zlink.toutiao.com,REJECT  # 可能承担普通 deep link，默认不拦

# ---- 穿山甲补充域名（二进制未直接出现，按需开启）----
# DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
# DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT

# ---- L2 遥测/日志（默认关闭；关掉可减少请求，但可能影响诊断）----
# DOMAIN,mon.zijieapi.com,REJECT
# DOMAIN,log.zijieapi.com,REJECT
# DOMAIN,applog.zijieapi.com,REJECT
# DOMAIN,rtlog.zijieapi.com,REJECT
# DOMAIN,rtapplog.zijieapi.com,REJECT
# DOMAIN,log.qishui.com,REJECT
# DOMAIN,mon.snssdk.com,REJECT
# DOMAIN,mcs.snssdk.com,REJECT
# DOMAIN,report.snssdk.com,REJECT

# ---- L3 风控/设备注册（默认关闭，拦了可能影响登录）----
# DOMAIN,timon.zijieapi.com,REJECT
# DOMAIN,gurd.snssdk.com,REJECT


# ============================================================================
# 2. [Rewrite] URL 重写（需要 MITM）
# ----------------------------------------------------------------------------
# 只放"响应无人解析"的上报端点；配置类端点一律交给 [Script]，
# 避免 reject-dict 丢包络导致 App 解码失败。
# 注意：HTTPS 的 URL 重写同样需要 MITM 解密后才能匹配到路径。
# 本段使用 Loon 旧版语法（全版本兼容）；Loon 3.5.1+ 也可改写为新语法：
#   request if ${url} ~= /^https:\/\/.../ then reject(200)
# ============================================================================

[Rewrite]

# ---- 开屏广告上报：纯 fire-and-forget，返回 200 空包，避免 SDK 重试 ----
^https?:\/\/api\.qishui\.com\/luna\/advert\/splash\/brand\/report reject-200

# ---- DSP 展示上报：纯上报，直接返回 200 空包 ----
^https?:\/\/api\.qishui\.com\/luna\/ads\/report\/dsp\/show reject-200

# ---- 广告举报/不喜欢 WebView：广告专用页面，但域名与抖音内容共享 ----
# 启用需要把 aweme.snssdk.com 加入 MITM，风险和收益不匹配，默认注释。
# ^https?:\/\/aweme\.snssdk\.com\/falcon\/fe_douyin_ad_react\/pages\/(?:report|dislike)\/ reject-200

# ---- 轻量模式（不跑脚本，仍需 MITM）：取消注释并注释掉 [Script] ----
# ^https?:\/\/api\.qishui\.com\/luna\/advert\/incentive\/config reject-dict
# ^https?:\/\/api\.qishui\.com\/luna\/advert\/incentive\/retrieve reject-dict
# ^https?:\/\/api\.qishui\.com\/luna\/advert\/splash\/brand\/retrieve reject-dict
# ^https?:\/\/api\.qishui\.com\/luna\/ads\/(?:config|retrieve|dsp\/retrieve) reject-dict
# ^https?:\/\/api\.qishui\.com\/luna\/commerce\/upsells reject-dict
# ^https?:\/\/api\.qishui\.com\/luna\/commerce\/v2\/upsell(?:_sort_decision)? reject-dict
# ^https?:\/\/api\.qishui\.com\/luna\/treasure\/task\/view reject-array


# ============================================================================
# 3. [Script] 精准改写（需要 MITM）
# ----------------------------------------------------------------------------
# 脚本保留 status_code / status_info / expire_time / expires_at 等包络字段，
# 只清空广告容器、关闭 preload、延长空配置缓存。
# ============================================================================

[Script]

# ---- 激励广告配置 ----
http-response ^https?:\/\/api\.qishui\.com\/luna\/advert\/incentive\/config script-path=scripts/sanitize.min.js, requires-body=true, timeout=10

# ---- 激励素材预拉取 ----
http-response ^https?:\/\/api\.qishui\.com\/luna\/advert\/incentive\/retrieve script-path=scripts/sanitize.min.js, requires-body=true, timeout=10

# ---- 开屏品牌广告 ----
http-response ^https?:\/\/api\.qishui\.com\/luna\/advert\/splash\/brand\/retrieve script-path=scripts/sanitize.min.js, requires-body=true, timeout=10

# ---- 广告源 / DSP / 广告位配置 / 兜底广告 ----
http-response ^https?:\/\/api\.qishui\.com\/luna\/(?:ads\/(?:config|retrieve|dsp\/retrieve)|advert\/fallback\/done\/info) script-path=scripts/sanitize.min.js, requires-body=true, timeout=10

# ---- 信息流广告：清 ads_blocks / ads_info，摘掉 is_ad=true 条目 ----
# 兼容 is_advertisement / is_ad_item / ad_flag / adItem，以及 card.is_ad 嵌套标记。
http-response ^https?:\/\/api\.qishui\.com\/luna\/(?:(?:v2\/)?feed\/|playlist\/(?:feed\/|detail|related_media|search)|search\/track|search-block|search-categories|media\/(?:assistant\/)?related|video_playlist\/detail|me\/discover|discover\/mix|featured-content\/list|card) script-path=scripts/sanitize.min.js, requires-body=true, timeout=10

# ---- 商业化弹窗（升级/挽回/礼包）----
http-response ^https?:\/\/api\.qishui\.com\/luna\/commerce\/upsells script-path=scripts/sanitize.min.js, requires-body=true, timeout=10
http-response ^https?:\/\/api\.qishui\.com\/luna\/commerce\/v2\/upsell(?:_sort_decision)? script-path=scripts/sanitize.min.js, requires-body=true, timeout=10

# ---- 福利页：只摘 reward_ads，保留签到/听歌/分享/逛商城/翻牌 ----
http-response ^https?:\/\/api\.qishui\.com\/luna\/treasure\/entrance\/config script-path=scripts/sanitize.min.js, requires-body=true, timeout=10
http-response ^https?:\/\/api\.qishui\.com\/luna\/growth\/activity_entrance script-path=scripts/sanitize.min.js, requires-body=true, timeout=10
http-response ^https?:\/\/api\.qishui\.com\/luna\/treasure\/task\/view script-path=scripts/sanitize.min.js, requires-body=true, timeout=10

# ---- 可选：请求侧减负（只改 preload=false，不碰 advert_duration）----
# http-request ^https?:\/\/api\.qishui\.com\/luna\/(?:advert\/incentive\/config|ads\/config) script-path=scripts/request.min.js, requires-body=true, timeout=10

# ---- 诊断（开发期用；稳定后保持注释）----
# http-response ^https?:\/\/api\.qishui\.com\/luna\/(?:advert|ads|commerce|treasure)\/ script-path=scripts/diag.min.js, requires-body=true, timeout=10
# http-response ^https?:\/\/conf\.qishui\.com\/service\/settings\/v3\/ script-path=scripts/diag.min.js, requires-body=true, timeout=10

# ---- 设置层（实验；推荐用独立插件 SodaClean-Settings.plugin）----
# 启用前必须把下面的 [MITM] 加上 conf.qishui.com。
# http-response ^https?:\/\/conf\.qishui\.com\/service\/settings\/v3\/ script-path=scripts/settings.min.js, requires-body=true, timeout=10


# ============================================================================
# 4. [MITM]
# ============================================================================

[MITM]

hostname = %APPEND% api.qishui.com
# 设置层实验（SodaClean-Settings.plugin）另行声明：
# hostname = %APPEND% conf.qishui.com
