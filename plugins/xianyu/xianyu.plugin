#!source=13a961ce4a851b292b5505369e9414aee9ccb7c0ec298b778698b1a92dd8845e

# ========================================================================
# 闲鱼 · 去广告（原生复写层） v1.6.4
# ------------------------------------------------------------------------
# 红线：*.goofish.com / *.idlefish.com / mtop 网关域（g-acs.m.goofish.com→alibabacorp mtop ingress）全部是核心功能;acs.m.goofish.com 出现在个别模块的 REJECT 里是错误规则,打死整个 App——拒收。
# 取证否决：m.goofish.com / awl.goofish.com 实测 NXDOMAIN（不存在）;xianyu.mobi 与 blackmatrix7 的 16 个乱码域是淘宝短链跳转服务（cname.tb.cn），拦=断分享链接;cdn.ynuf.aliapp.org=阿里无线安全 UMID 指纹,禁拦。
# 证据基线：闲鱼全部广告面在同域 API 名上——开屏 mtop.taobao.idlecommerce.splash.ads、切回前台场景恢复开屏 mtop.idle.idleadv.scene.restore、信息流 nextfresh bizType、底部推荐 bizType==mamaAD（字段名直接点名阿里妈妈）;素材共用 *.alicdn.com 共享 CDN。第三方列表 goofish 域零命中。
# 本插件 [Host]/[Rule] 全设备生效(Loon 无法按 App 限定):同一 SDK 域跨 App 共享黑洞,'按 App 插件'只是分组开关;配合全局 ads 插件 httpdns 组防绕过。
# 第二轮取证复检(2026-10-28)：mma.alimama.com 实测 NXDOMAIN(网传『阿里妈妈端点』不存在,禁凭品牌造域);开屏素材无 alicdn 之外的独立 CDN(墨鱼 GoofishAds.conf 亦无单独素材域);h-adashx.ut.taobao.com=阿里 UT/AdashX 埋点,全阿里系 App 共享,属全局 ads 插件的决策面,不进本按 App 插件。
# v1.6.1 启用 Loon 原生 [Rewrite] v2 引擎复写层（enhance.active=true）：通过 [Argument] 的 cleanAds（默认开：7 条开屏/场景恢复/曝光/推广模块 request reject_dict(200) + 8 条商品推荐 mamaAD / 悬浮球 / 搜索暗词 / 省钱 Tab / 群聊圈子 Banner jq 剥离）与 cleanFeed（默认关：7 条激进信息流/我的页精简，其中 search.discover 与 item.buy.feeds 升级为原生 response.json.delete）双开关控制 22 条原生复写规则 + 配套 QUIC 回退。
# 本文件由 tools/build-apps.py 从 src/apps/xianyu.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开。自动化类的默认值是显式源内裁决（v3.6.0 起 QDREADER_* 六开关默认# 开——用户裁决接受服务端风控后果）；每个开关都仍可单独关掉切面停用。
# ========================================================================

[Argument]

cleanAds = switch,true,tag=mtop 同域开屏与广告位净化（默认开）,desc=启用 Loon 原生 [Rewrite] v2 引擎复写：splash.ads、idle.idleadv、idle.ad.expose 等 7 个广告/模块端点在 request 阶段 reject_dict(200) 终止；商品推荐 mamaAD 卡片、悬浮球、搜索预填词、顶部省钱 Tab、群聊/圈子 Banner 通过 response.json.jq 精准剥离。需已安装并信任 Loon 证书。
cleanFeed = switch,false,tag=激进信息流与我的页精简（默认关）,desc=首页 nextfresh / 本地信息流 / 搜索结果只留 item、删除搜索发现页与我的页底部商品推荐、精简我的页分区。因过滤粒度较激进默认关，按需开启。

[Rule]

# ------------------------------------------------------------
# QUIC 回退（增强层配套 · 拒的是 HTTP/3 协议，回落 TCP 后正文不受影响）
# MITM 只解密 TCP；App 走 HTTP/3 时下面这些主机的响应脚本会静默收不到。本组只对 PROTOCOL,QUIC 生效，同一主机的 TCP 请求（正文/书架/章节）零影响。
AND,((DOMAIN-SUFFIX,acs.m.goofish.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,g-acs.m.goofish.com),(PROTOCOL,QUIC)),REJECT

[Host]

# ------------------------------------------------------------
# 阿里妈妈 / TanX / 阿里广告监测（置信 A）
*.alimama.cn = 127.0.0.1
*.alimama.com = 127.0.0.1
*.mmstat.com = 127.0.0.1
*.tanx.com = 127.0.0.1
adash-emas.cn-hangzhou.aliyuncs.com = 127.0.0.1
adashx.m.taobao.com = 127.0.0.1
alimama.alicdn.com = 127.0.0.1
alimama.cn = 127.0.0.1
alimama.com = 127.0.0.1
atanx.alicdn.com = 127.0.0.1
audid-api.taobao.com = 127.0.0.1
mmstat.com = 127.0.0.1
poplayer.template.alibaba.com = 127.0.0.1
rtb.julang.taobao.com = 127.0.0.1
tanx.com = 127.0.0.1
tns.simba.taobao.com = 127.0.0.1
wcp.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 阿里广告 SDK 端点（闲鱼净化模块唯一 REJECT 域）（置信 A）
# iyes.youku.com=阿里广告 SDK 端点（apiv4-iyes 为其分片,整域+通配）;anti-AD/AdGuard/hagezi/wool XianYu 模块四源收录。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://github.com/fmz200/wool_scripts/tree/main/Surge/module/split/partM
# 证据: https://raw.githubusercontent.com/AdguardTeam/AdguardFilters/master/ChineseFilter/sections/adservers.txt
*.iyes.youku.com = 127.0.0.1
iyes.youku.com = 127.0.0.1

# ------------------------------------------------------------
# 淘宝客/阿里妈妈 API 端点（置信 B）
# tunion-api.m.taobao.com=淘宝联盟(Tunion) CPS 广告归因接口,taobao.com 是共享主域、上方 sdks:["alimama"] 的 *.alimama.com 整域黑洞罩不到它,故在此精确单列(afpapi.alimama.com 已由 sdks:["alimama"] 的 *.alimama.com 通配覆盖,不重复声明)。
# 证据: https://github.com/blackmatrix7/ios_rule_script/blob/master/rule/Loon/Advertising/Advertising.list
# 证据: https://www.alimama.com/about.htm
tunion-api.m.taobao.com = 127.0.0.1

# ------------------------------------------------------------
# 淘宝系 AMDC HTTPDNS 调度（默认关）（置信 B）
# amdc.m/amdcopen.m.taobao.com=阿里 HTTPDNS 调度;闲鱼净化脚本专改 /amdc/mobileDispatch。拦=广告域解析绕过消失,但阿里系 App 若无回退逻辑可能拖慢建连——默认关,验证后再开。
# 证据: https://github.com/privacy-protection-tools/anti-AD
# 证据: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/GoofishAds.conf
# （默认关闭的组：整组注释，取消注释即启用）
# amdc.m.taobao.com = 127.0.0.1
# amdcopen.m.taobao.com = 127.0.0.1


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = acs.m.goofish.com, g-acs.m.goofish.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_* 在出网前就地返回
# 合法空载荷；response 阶段 reject_* 与 response.json.* 在回包后由引擎完成解压
# 与字段级改写（不依赖脚本层 $utils.ungzip）。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段直接终止（reject_dict(200)）：mtop 纯广告与推广模块接口
# ------------------------------------------------------------
# kill-splash-ads: 闲鱼开屏广告 mtop 请求直接返回 200 + 空字典（限定路径段，不跨查询串贪婪匹配）（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/GoofishAds.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop[^?]*splash\.ads/ then reject_dict(200)

# kill-idleadv-restore: 闲鱼切回前台/场景恢复开屏与弹层广告请求（mtop.idle.idleadv.scene.restore 等）直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/GoofishAds.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.idleadv\./ then reject_dict(200)

# kill-ad-expose: 闲鱼广告曝光计数上报接口直接返回 200 + 空字典（来源 https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/GoofishAds.conf）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose/ then reject_dict(200)

# kill-whale-modulet: 首页顶部营销模块（home.whale.modulet）直接返回 200 + 空字典（来源 https://t.me/GitCube）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.home\.whale\.modulet(?:\/|\?|$)/ then reject_dict(200)

# kill-resell-recommend: 「这些宝贝超好卖」推广模块直接返回 200 + 空字典（来源 https://t.me/GitCube）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.resell\.recommendorhotcate(?:\/|\?|$)/ then reject_dict(200)

# kill-topic-banner: 我的页话题横幅（topic.banner）直接返回 200 + 空字典（来源 https://t.me/GitCube）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.topic\.banner(?:\/|\?|$)/ then reject_dict(200)

# kill-coin-nextfresh: 闲鱼币推荐信息流（idle.coin.nextfresh）直接返回 200 + 空字典（来源 https://t.me/GitCube）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh(?:\/|\?|$)/ then reject_dict(200)

# ------------------------------------------------------------
# 响应字段级净化（cleanAds 默认开）：只剥广告字段，保留 mtop 包络
# ------------------------------------------------------------
# clean-item-recommend: 商品底部推荐：只删 bizType=mamaAD 的阿里妈妈广告卡片（来源 ddgksf2013）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" and (.data.cardList | type) == \"array\" then .data.cardList |= map(select(type != \"object\" or (.cardData | type) != \"object\" or .cardData.bizType != \"mamaAD\")) else . end")

# clean-strategy-list: 首页右下角悬浮球：留一个空 strategy 占位（来源 ddgksf2013）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data.strategies = [{}] else . end")

# clean-search-shade: 搜索框预填/热词：留一个空占位（来源 ddgksf2013）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data.singleShadeWords = [{}] else . end")

# clean-search-activate: 搜索页「猜你可能找」推广卡片清空（来源 ddgksf2013）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data.cardList = [{}] else . end")

# clean-circle-savemoney: 首页顶部 Tab：去掉 saveMoney 省钱推广位（来源 ddgksf2013）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.circle\.list(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" and (.data.circleList | type) == \"array\" then .data.circleList |= map(select(type != \"object\" or .bizCode != \"saveMoney\")) else . end")

# clean-group-banner: 群聊/消息页 banner 位清空（来源 fmz200）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.group\.myself\.banner(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data.bannerList = [] else . end")

# clean-circle-banner: 圈子页 banner 位清空（来源 fmz200）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.circle\.myself\.banner(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data.bannerList = [] else . end")

# clean-playboy-recommend: 消息页推荐位清空（来源 fmz200）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data.recommends = [] | .data.items = [] | .data.next = false else . end")

# ------------------------------------------------------------
# 激进信息流与我的页精简（cleanFeed 默认关）：按需开启
# ------------------------------------------------------------
# slim-home-nextfresh: 首页信息流：顶部只留首项、分区只留 item（来源 ddgksf2013）
response if ${cleanFeed} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data |= ((if (.homeTopList | type) == \"array\" and (.homeTopList | length) > 0 then .homeTopList |= [ .[0] ] else . end) | (if (.sections | type) == \"array\" then .sections |= map(select(type == \"object\" and (.data | type) == \"object\" and .data.bizType == \"item\")) else . end)) else . end")

# slim-search-result: 搜索结果信息流：只留 item 结果（来源 ddgksf2013）
response if ${cleanFeed} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" and (.data.resultList | type) == \"array\" then .data.resultList |= map(select(type == \"object\" and (.data | type) == \"object\" and (.data.item | type) == \"object\" and (.data.item.main | type) == \"object\" and (.data.item.main.clickParam | type) == \"object\" and (.data.item.main.clickParam.args | type) == \"object\" and .data.item.main.clickParam.args.biz_type == \"item\")) else . end")

# slim-local-home: 本地信息流：分区只留 item（来源 ddgksf2013）
response if ${cleanFeed} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" and (.data.sections | type) == \"array\" then .data.sections |= map(select(type == \"object\" and (.data | type) == \"object\" and .data.bizType == \"item\")) else . end")

# slim-search-discover: 搜索发现页：原生点分路径删除 data.resultList（来源 ddgksf2013）
response if ${cleanFeed} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover(?:\/|\?|$)/ then response.json.delete("data.resultList")

# slim-my-adapter: 我的页面：清空 ability 并只留 head/user/trade 分区（来源 ddgksf2013）
response if ${cleanFeed} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data.ability = [] | (if (.data.container | type) == \"object\" and (.data.container.sections | type) == \"array\" then .data.container.sections |= map(select(type == \"object\" and (.sectionBizCode | type) == \"string\" and (.sectionBizCode | test(\"head|user|trade\")))) else . end) else . end")

# slim-buy-feeds: 我的页面底部商品推荐：原生点分路径删除 data.sections（来源 ddgksf2013）
response if ${cleanFeed} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds(?:\/|\?|$)/ then response.json.delete("data.sections")

# slim-recommend-list: 商品推荐列表：整列清空 cardList（来源 fmz200）
response if ${cleanFeed} == true && ${url} ~= /^https:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend\.list(?:\/|\?|$)/ then response.json.jq("if type == \"object\" and (.data | type) == \"object\" then .data.cardList = [] else . end")
