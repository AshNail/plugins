#!name=YouTube · 广告字段清理（原生复写）
#!desc=不复制可莉 YouTube 脚本：默认启用 Loon 原生 [Rewrite] v2 引擎复写（cleanAds 开关默认开）——对 www.youtube.com 的 pagead/、api/stats/(ads|atr|qoe)、ptracking、error_204 以及 youtubei.googleapis.com 的 youtubei/v1/log_event 请求直接 reject_dict(200) 终止，对 youtubei.googleapis.com 的 browse/next/player/search 等 JSON 响应使用原生 response.json.jq 递归删除 adPlacements/playerAds/adSlots 等广告字段；不改播放地址、不碰 googlevideo 传输、零 JS 脚本。前置：需已安装并信任 Loon 证书。
#!author=edy
#!version=1.2.1
#!homepage=https://github.com/AshNail/plugins
#!openUrl=https://github.com/AshNail/plugins/blob/main/plugins/youtube/README.md
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/84/80/65/84806526-8b53-6e37-8e01-8369c879d30a/logo_youtube_2024_q4_color-0-0-1x_U007emarketing-0-0-0-7-0-0-0-85-220.png/512x512bb.jpg
#!system=iOS,iPadOS,tvOS,macOS
#!date=2026-11-07
#!tag=去广告,YouTube
#!type=normal

# ========================================================================
# YouTube · 广告字段清理（原生复写）
# ------------------------------------------------------------------------
# 红线：*.youtube.com / *.googlevideo.com / *.ytimg.com / youtubei.googleapis.com 承载登录、播放、缩略图与 API；本插件只做 youtubei JSON 广告字段清理，不黑洞整域，不改播放地址。
# v1.2.0 启用 Loon 原生 [Rewrite] v2 引擎复写层（enhance.active=true）：通过 [Argument] cleanAds 开关（默认开）驱动 3 条原生复写规则 + 配套 QUIC 回退，并将 youtubei/v1/log_event 高频遥测上报移至 request 阶段直接 reject_dict(200) 阻断出网。
# 可莉 YouTube 插件是纯 response/request 脚本（含上传、Shorts、字幕、日志事件参数）；本插件不复制、不依赖，只实现可由 Loon 原生 [Rewrite] v2 表达的广告路径拦截与字段删除。
# 响应规则只删除 adPlacements/playerAds/adSlots/adBreakHeartbeatParams/adBreakParams；不改播放 URL、不碰 googlevideo 的 initplayback，避免把视频本体拦掉。
# 本文件由 tools/build-apps.py 从 src/apps/youtube.json 生成，不要手改生成物。
# ========================================================================


# ========================================================================
# 开关（源：src/apps/<slug>.json 的 enhance.arguments；改开关改源后 npm run build:apps）
# ------------------------------------------------------------------------
# 净化类默认开。自动化类的默认值是显式源内裁决（v3.6.0 起 QDREADER_* 六开关默认# 开——用户裁决接受服务端风控后果）；每个开关都仍可单独关掉切面停用。
# ========================================================================

[Argument]

cleanAds = switch,true,tag=YouTubei 广告字段净化（默认开）,desc=启用 Loon 原生 [Rewrite] v2 引擎复写：拦截 www.youtube.com 网页广告/统计路径与 youtubei/v1/log_event 事件上报，并递归删除 youtubei.googleapis.com 响应中的广告字段。需已安装并信任 Loon 证书。

[Rule]

# ------------------------------------------------------------
# QUIC 回退（增强层配套 · 拒的是 HTTP/3 协议，回落 TCP 后正文不受影响）
# MITM 只解密 TCP；App 走 HTTP/3 时下面这些主机的响应脚本会静默收不到。本组只对 PROTOCOL,QUIC 生效，同一主机的 TCP 请求（正文/书架/章节）零影响。
AND,((DOMAIN-SUFFIX,www.youtube.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT

[Host]


# ========================================================================
# 默认启用的 MITM 层（本 App 未做证书固定；必须已装并信任 Loon 证书）
# ------------------------------------------------------------------------
# 不装证书 = 上述主机的 TLS 握手会被客户端拒绝，本 App 内容加载会失败——
# 这是同域 HTTPS 路径拦截与 JSON 字段净化的必要前置（远程订阅插件无法手工取消
# 注释，故在确认无证书固定后由源显式声明 active=true 默认启用）。
# 若源里登记了注释态 URL-REGEX 路径黑洞，文末仍保持注释：红线业务主机只解密不整域黑洞。
# ========================================================================

[MITM]

hostname = %APPEND% youtubei.googleapis.com, www.youtube.com


# ========================================================================
# 净化层主力：Loon 原生复写（enhance.rewrite 生成，lint 逐行对账）
# ------------------------------------------------------------------------
# 由 Loon [Rewrite] v2 引擎直接执行：request 阶段 reject_dict/reject_img 在
# 出网前就地返回合法空载荷，response.json.* 由引擎底层自动完成 gzip/br 解压与
# 字段级改写（不依赖脚本层 $utils.ungzip），Accept-Encoding 协商保护同域脚本链。
# 探针纪律：若存在标了 probe=true 的同 URL [Script] 绑定，复写命中时按官方口径
# 会静默抑制同阶段脚本，可据此在主日志里验证复写是否真实命中。
# ========================================================================

[Rewrite]

# ------------------------------------------------------------
# 请求阶段直接终止（reject_dict(200)）：网页广告与广告统计路径
# ------------------------------------------------------------
# kill-pagead: 网页广告加载与广告统计/追踪上报路径直接返回 200 + 空字典（来源 https://www.youtube.com/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/www\.youtube\.com\/(?:pagead\/|api\/stats\/(?:ads|atr|qoe)|ptracking|error_204)/ then reject_dict(200)

# kill-youtubei-log-event: YouTube 客户端中插广告点拉取（player/ad_break）及高频遥测/广告归因上报（log_event、att/log）在请求阶段直接返回 200 + 空字典（来源 https://www.youtube.com/）
request if ${cleanAds} == true && ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:log_event|player\/ad_break|att\/log)(\?|$)/ then reject_dict(200)

# ------------------------------------------------------------
# 响应字段级净化（response.json.jq）：只删广告槽位，保留播放流
# ------------------------------------------------------------
# clean-youtubei-ads: YouTubei 响应（含 Shorts reel_item_watch 与播放中 updated_metadata）递归删除广告字段；不改播放地址（来源 https://www.youtube.com/）
response if ${cleanAds} == true && ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|reel\/reel_item_watch|updated_metadata|guide|account\/get_setting|get_watch|config)(\?|$)/ then response.json.jq("walk(if type == \"object\" then del(.adPlacements, .playerAds, .adSlots, .adBreakHeartbeatParams, .adBreakParams) else . end)")
